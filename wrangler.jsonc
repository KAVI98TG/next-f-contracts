{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "next-f-contracts",
  "compatibility_date": "2026-09-11",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "contracts.nextf.lk",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
