{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "security.securityControlJsonSchema",
  "title": "NEXT F Security Control",
  "type": "object",
  "required": [
    "controlId",
    "name",
    "category",
    "requirement",
    "rationale",
    "applicability",
    "obligation",
    "scope",
    "verificationMethods",
    "evidenceTypes",
    "violationSeverity"
  ],
  "properties": {
    "controlId": {
      "type": "string",
      "pattern": "^SEC-[A-Z0-9]+-[0-9]{3}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string"
    },
    "requirement": {
      "type": "string",
      "minLength": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "applicability": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "obligation": {
      "enum": [
        "mandatory",
        "recommended"
      ]
    },
    "scope": {
      "enum": [
        "client",
        "server",
        "both",
        "build",
        "operations"
      ]
    },
    "affectedModules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verificationMethods": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "evidenceTypes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "violationSeverity": {
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "relatedPermissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relatedApiRules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relatedWebhookRules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relatedCommerceRules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relatedRegistryIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "subrequirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
