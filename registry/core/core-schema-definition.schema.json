{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contract.nextf.lk/schema/shared-core-definition.json",
  "title": "NEXT F Shared Core Schema Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$id",
    "name",
    "version",
    "status",
    "domain",
    "category",
    "description",
    "purpose",
    "fields",
    "relationships",
    "validationRules",
    "cms",
    "delivery",
    "examples",
    "notes"
  ],
  "properties": {
    "$id": {
      "type": "string",
      "pattern": "^(core|shared)\\.[a-z][A-Za-z0-9]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "enum": [
        "experimental",
        "draft",
        "stable",
        "deprecated",
        "removed"
      ]
    },
    "domain": {
      "enum": [
        "core",
        "shared"
      ]
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "validationRules": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "cms": {
      "type": "object"
    },
    "delivery": {
      "type": "object"
    },
    "examples": {
      "type": "object",
      "required": [
        "valid",
        "invalid"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
