{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contract.nextf.lk/registry/seo/seo-schema-definition.schema.json",
  "title": "NEXT F SEO Contract Definition",
  "type": "object",
  "required": [
    "$id",
    "name",
    "version",
    "status",
    "domain",
    "category",
    "description",
    "purpose",
    "seoModel",
    "fields",
    "relationships",
    "validationRules",
    "cms",
    "delivery",
    "futureBindings",
    "examples",
    "notes"
  ],
  "properties": {
    "$id": {
      "type": "string",
      "pattern": "^seo\\.[a-z][A-Za-z0-9]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "status": {
      "const": "stable"
    },
    "domain": {
      "const": "seo"
    },
    "category": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "seoModel": {
      "type": "object"
    },
    "fields": {
      "type": "array"
    },
    "relationships": {
      "type": "array"
    },
    "validationRules": {
      "type": "array"
    },
    "cms": {
      "type": "object"
    },
    "delivery": {
      "type": "object"
    },
    "futureBindings": {
      "type": "object"
    },
    "examples": {
      "type": "object"
    },
    "notes": {
      "type": "array"
    }
  },
  "additionalProperties": true
}
