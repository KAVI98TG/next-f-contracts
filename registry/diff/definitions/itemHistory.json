      "primitive": "fields.text"
    },
    {
      "key": "entries",
      "required": true,
      "nullable": false,
      "description": "entries",
      "primitive": "fields.json"
    },
    {
      "key": "firstSeen",
      "required": true,
      "nullable": false,
      "description": "firstSeen",
      "primitive": "fields.text"
    },
    {
      "key": "lastSeen",
      "required": true,
      "nullable": false,
      "description": "lastSeen",
      "primitive": "fields.text"
    },
    {
      "key": "distinctSnapshots",
      "required": true,
      "nullable": false,
      "description": "distinctSnapshots",
      "primitive": "fields.integer"
    }
  ],
  "relationships": [],
  "validationRules": [
    {
