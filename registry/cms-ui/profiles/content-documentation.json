    "columns": [
      {
        "field": "title",
        "label": "Title",
        "rendererId": "primary-text",
        "order": 10,
        "mobilePriority": "high"
      },
      {
        "field": "collection",
        "label": "Collection",
        "rendererId": "text",
        "order": 20,
        "mobilePriority": "high"
      },
      {
        "field": "publishing",
        "label": "Publishing",
