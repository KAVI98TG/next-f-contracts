{
  "$id": "cmsUi.profile.content.customentries",
  "name": "Custom Entries",
  "version": "1.1.0",
  "status": "stable",
  "domain": "cms-ui",
  "profileType": "resource",
  "resource": "content.customentries",
  "moduleId": "pages",
  "description": "Customer CMS presentation metadata for Custom Entries within authorized Site scope.",
  "targetContracts": [
    "content.customCollectionEntry"
  ],
  "primaryTargetContract": "content.customCollectionEntry",
  "route": "/content/collections/:collectionKey",
  "screenKind": "editor",
  "layoutTemplate": "standard-editor",
  "responsivePolicy": "standard",
  "fieldBindings": [
    {
      "field": "identity",
      "label": "Identity",
      "description": "Stable entity identity.",
      "editorId": "hidden",
      "group": "system",
      "zone": "hidden-system",
      "order": 10,
      "required": true,
      "customerEditable": false,
      "adminEditable": null,
      "width": "half",
      "sourceFieldType": "core.entityIdentity",
      "validationHint": {},
      "searchable": false,
      "filterable": false,
      "sortable": false,
      "localizable": false,
      "revisionTracked": false
    },
    {
      "field": "scope",
      "label": "Scope",
      "description": "Owning Organization and Site scope.",
      "editorId": "hidden",
      "group": "system",
      "zone": "hidden-system",
      "order": 20,
      "required": true,
      "customerEditable": false,
      "adminEditable": null,
      "width": "half",
      "sourceFieldType": "core.tenantScope",
      "validationHint": {},
      "searchable": false,
      "filterable": false,
      "sortable": false,
      "localizable": false,
      "revisionTracked": false
    },
    {
      "field": "collection",
      "label": "Collection",
      "description": "Owning Custom Collection definition.",
      "editorId": "read-only",
      "group": "taxonomy",
      "zone": "main",
      "order": 30,
      "required": true,
      "customerEditable": false,
      "adminEditable": false,
      "width": "half",
      "sourceFieldType": "fields.relation",
      "validationHint": {},
      "searchable": false,
      "filterable": true,
      "sortable": false,
      "localizable": false,
      "revisionTracked": false
    },
    {
      "field": "displayLabel",
      "label": "Display Label",
      "description": "CMS list label snapshot/derived display value.",
      "editorId": "read-only",
      "group": "configuration",
      "zone": "main",
      "order": 40,
      "required": true,
      "customerEditable": false,
      "adminEditable": false,
      "width": "half",
      "sourceFieldType": "fields.text",
      "validationHint": {
        "minLength": 1,
        "maxLength": 220
      },
      "searchable": true,
      "filterable": false,
      "sortable": true,
      "localizable": false,
      "revisionTracked": false
    },
    {
      "field": "slug",
      "label": "Slug",
      "description": "Optional route slug when collection routing permits it.",
      "editorId": "slug",
