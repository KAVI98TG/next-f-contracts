      "zone": "sidebar",
      "order": 50,
      "required": false,
      "customerEditable": true,
      "adminEditable": true,
      "width": "half",
      "sourceFieldType": "fields.slug",
      "validationHint": {
        "maxLength": 180
      },
      "searchable": true,
      "filterable": false,
      "sortable": false,
      "localizable": false,
      "revisionTracked": true
    },
    {
      "field": "data",
      "label": "Data",
      "description": "Structured entry data validated against the owning collection fieldDefinitions.",
      "editorId": "json-editor",
      "group": "configuration",
      "zone": "main",
      "order": 60,
      "required": true,
      "customerEditable": true,
      "adminEditable": true,
      "width": "full",
      "sourceFieldType": "fields.json",
      "validationHint": {},
      "searchable": false,
      "filterable": false,
      "sortable": false,
      "localizable": false,
      "revisionTracked": true
    },
    {
      "field": "publishing",
      "label": "Publishing",
      "description": "Canonical publishing, visibility and scheduling state.",
      "editorId": "publishing-panel",
      "group": "publishing",
      "zone": "sidebar",
      "order": 70,
      "required": true,
      "customerEditable": true,
      "adminEditable": null,
      "width": "full",
      "sourceFieldType": "core.publishing",
      "validationHint": {},
      "searchable": false,
      "filterable": false,
      "sortable": false,
      "localizable": false,
      "revisionTracked": false
    },
    {
      "field": "revision",
      "label": "Revision",
      "description": "Current and published revision pointers.",
      "editorId": "hidden",
      "group": "system",
      "zone": "hidden-system",
      "order": 80,
      "required": false,
      "customerEditable": false,
      "adminEditable": null,
      "width": "half",
      "sourceFieldType": "core.revisionPointer",
      "validationHint": {},
      "searchable": false,
      "filterable": false,
      "sortable": false,
      "localizable": false,
      "revisionTracked": false
    }
  ],
  "relatedPanels": [
    {
      "id": "publishing",
      "label": "Publishing",
      "contractId": "core.publishing",
      "zone": "sidebar",
      "editorId": "publishing-panel",
      "availability": "always"
    },
    {
      "id": "revisions",
      "label": "Version History",
      "contractId": "core.revisionPointer",
      "zone": "tabs",
      "editorId": "revision-history",
      "availability": "when-capability-enabled:core.versioning"
    }
  ],
  "list": {
    "enabled": true,
    "columns": [
      {
        "field": "displayLabel",
        "label": "Display Label",
        "rendererId": "primary-text",
        "order": 10,
        "mobilePriority": "high"
      },
      {
        "field": "publishing",
        "label": "Publishing",
        "rendererId": "status",
        "order": 20,
        "mobilePriority": "high"
      }
    ],
    "search": true,
    "filters": [
      {
        "field": "collection",
        "label": "Collection"
      }
    ],
    "bulkActions": "permission-and-rule-bound",
    "sorts": [
      {
        "field": "displayLabel",
        "label": "Display Label"
      }
    ],
    "searchFields": [
      "displayLabel",
      "slug"
    ]
  },
  "actions": [
    {
      "actionId": "approve",
      "permissionId": "content.customentries.approve",
      "riskLevel": "elevated",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false
    },
    {
      "actionId": "create",
      "permissionId": "content.customentries.create",
      "riskLevel": "elevated",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false
    },
    {
      "actionId": "delete",
      "permissionId": "content.customentries.delete",
      "riskLevel": "destructive",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": true
    },
    {
      "actionId": "edit",
      "permissionId": "content.customentries.edit",
      "riskLevel": "elevated",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false
    },
    {
      "actionId": "publish",
      "permissionId": "content.customentries.publish",
      "riskLevel": "elevated",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false
    },
    {
      "actionId": "view",
      "permissionId": "content.customentries.view",
      "riskLevel": "standard",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false
    },
    {
      "actionId": "save-draft",
      "permissionId": "content.customentries.edit",
      "riskLevel": "elevated",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false
    },
    {
      "actionId": "preview",
      "permissionId": "content.customentries.view",
      "riskLevel": "standard",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false
    },
    {
      "actionId": "schedule",
      "permissionId": "content.customentries.publish",
      "riskLevel": "elevated",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false
    }
  ],
  "permissions": [
    "content.customentries.approve",
    "content.customentries.create",
    "content.customentries.delete",
    "content.customentries.edit",
    "content.customentries.publish",
    "content.customentries.view"
  ],
  "states": [
    "loading",
    "empty",
    "populated",
    "validation-error",
    "authorization-denied",
    "not-found",
    "conflict",
    "network-error",
    "success"
  ],
  "unsavedChanges": {
    "track": true,
    "warnOnLeave": true,
    "autosave": "draft-only-when-supported",
    "neverAutoExecute": [
      "publish",
      "approve",
      "delete",
      "refund",
      "fulfill",
      "disconnect",
      "rotate-secret"
    ]
  },
  "accessibility": {
    "labelsRequired": true,
    "keyboardComplete": true,
    "nonColorStatus": true,
    "dragAlternativeRequired": false
  },
  "notes": [],
  "views": [
    {
      "id": "index",
      "kind": "list",
      "route": "/content/collections/:collectionKey",
      "layoutTemplate": "data-list",
      "requiresPermission": "content.customentries.view",
      "purpose": "Browse, search, filter and open authorized resources."
    },
    {
      "id": "create",
      "kind": "editor",
      "route": "/content/collections/:collectionKey/new",
      "layoutTemplate": "standard-editor",
      "requiresPermission": "content.customentries.create",
      "purpose": "Create a new canonical resource."
    },
    {
      "id": "record",
      "kind": "editor",
      "route": "/content/collections/:collectionKey/:id",
      "layoutTemplate": "standard-editor",
      "requiresPermission": "content.customentries.edit",
      "purpose": "Inspect and, where authorized, operate or edit one resource."
    }
  ],
  "customerAccessPolicyRef": "customerAccess.policy.content.customentries",
  "effectiveCustomerAccess": {
    "policyVersion": "1.1.0",
    "mode": "direct_edit",
    "publishingMode": "direct",
    "actions": {
      "read": "allow",
      "create": "allow",
      "update": "allow",
      "delete": "allow",
      "submit_for_review": "deny",
      "publish": "allow",
      "unpublish": "deny",
      "restore_version": "deny"
    },
    "permissionRefs": {
      "read": [
        "content.customentries.view"
      ],
      "create": [
        "content.customentries.create"
      ],
      "update": [
        "content.customentries.edit",
        "content.customentries.publish"
      ],
      "delete": [
        "content.customentries.delete"
      ],
      "submit_for_review": [
        "content.customentries.approve"
      ],
      "publish": [
        "content.customentries.publish"
      ],
      "unpublish": [],
      "restore_version": []
    },
    "capabilityRefs": [
      "pages.custom-collections"
    ],
    "demoMode": "read_only_sample",
    "approvalRequired": false,
    "hiddenFromCustomerDiscovery": false,
    "unavailableReason": null
  }
