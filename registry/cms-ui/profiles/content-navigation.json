{
  "$id": "cmsUi.profile.content.navigation",
  "name": "Navigation",
  "version": "0.20.0",
  "status": "stable",
  "domain": "cms-ui",
  "profileType": "resource",
  "resource": "content.navigation",
  "moduleId": "pages",
  "description": "Customer CMS presentation metadata for Navigation within authorized Site scope.",
  "targetContracts": [
    "content.navigation",
    "content.navigationItem"
  ],
  "primaryTargetContract": "content.navigation",
  "route": "/website/navigation",
  "screenKind": "builder",
  "layoutTemplate": "builder-editor",
  "responsivePolicy": "builder",
  "fieldBindings": [
    {
      "field": "identity",
      "label": "Identity",
      "description": "Stable entity identity.",
      "editorId": "hidden",
      "group": "system",
      "zone": "hidden-system",
      "order": 10,
      "required": true,
      "customerEditable": false,
      "adminEditable": null,
      "width": "half",
      "sourceFieldType": "core.entityIdentity",
      "validationHint": {},
      "searchable": false,
      "filterable": false,
      "sortable": false,
      "localizable": false,
      "revisionTracked": false
    },
    {
      "field": "scope",
      "label": "Scope",
      "description": "Owning Organization and Site scope.",
      "editorId": "hidden",
      "group": "system",
      "zone": "hidden-system",
      "order": 20,
      "required": true,
      "customerEditable": false,
      "adminEditable": null,
      "width": "half",
      "sourceFieldType": "core.tenantScope",
      "validationHint": {},
      "searchable": false,
      "filterable": false,
      "sortable": false,
      "localizable": false,
      "revisionTracked": false
    },
    {
      "field": "name",
      "label": "Name",
      "description": "Internal/customer-visible navigation name.",
      "editorId": "single-line-text",
      "group": "content",
      "zone": "main",
      "order": 30,
      "required": true,
      "customerEditable": true,
      "adminEditable": true,
      "width": "full",
      "sourceFieldType": "fields.text",
      "validationHint": {
        "minLength": 1,
        "maxLength": 140
      },
      "searchable": true,
      "filterable": false,
      "sortable": false,
      "localizable": false,
      "revisionTracked": true
    },
    {
      "field": "key",
      "label": "Key",
      "description": "Stable developer-consumed navigation key.",
      "editorId": "read-only",
      "group": "configuration",
      "zone": "main",
      "order": 40,
      "required": true,
      "customerEditable": false,
      "adminEditable": true,
      "width": "half",
      "sourceFieldType": "fields.slug",
      "validationHint": {
        "minLength": 1,
        "maxLength": 100
      },
      "searchable": true,
      "filterable": true,
      "sortable": false,
      "localizable": false,
      "revisionTracked": false
    },
    {
      "field": "location",
      "label": "Location",
      "description": "Intended semantic placement.",
      "editorId": "read-only",
      "group": "configuration",
      "zone": "main",
      "order": 50,
      "required": true,
      "customerEditable": false,
      "adminEditable": true,
      "width": "half",
      "sourceFieldType": "fields.select",
      "validationHint": {},
      "searchable": false,
      "filterable": true,
      "sortable": false,
      "localizable": false,
      "revisionTracked": false
    },
    {
      "field": "items",
      "label": "Items",
      "description": "Ordered navigation items.",
      "editorId": "relation-picker",
      "group": "configuration",
      "zone": "main",
      "order": 60,
      "required": false,
      "customerEditable": true,
      "adminEditable": true,
      "width": "half",
      "sourceFieldType": "fields.relation",
      "validationHint": {},
      "searchable": false,
      "filterable": false,
      "sortable": false,
      "localizable": false,
      "revisionTracked": true
    },
    {
      "field": "publishing",
      "label": "Publishing",
      "description": "Canonical publishing, visibility and scheduling state.",
      "editorId": "publishing-panel",
      "group": "publishing",
      "zone": "sidebar",
      "order": 70,
      "required": true,
      "customerEditable": true,
      "adminEditable": null,
      "width": "full",
      "sourceFieldType": "core.publishing",
      "validationHint": {},
      "searchable": false,
      "filterable": false,
      "sortable": false,
      "localizable": false,
      "revisionTracked": false
    },
    {
      "field": "revision",
      "label": "Revision",
      "description": "Current and published revision pointers.",
      "editorId": "hidden",
      "group": "system",
      "zone": "hidden-system",
      "order": 80,
      "required": false,
      "customerEditable": false,
      "adminEditable": null,
      "width": "half",
      "sourceFieldType": "core.revisionPointer",
      "validationHint": {},
      "searchable": false,
      "filterable": false,
      "sortable": false,
      "localizable": false,
      "revisionTracked": false
    }
  ],
  "relatedPanels": [
    {
      "id": "publishing",
      "label": "Publishing",
      "contractId": "core.publishing",
      "zone": "sidebar",
      "editorId": "publishing-panel",
      "availability": "always"
    },
    {
      "id": "revisions",
      "label": "Version History",
      "contractId": "core.revisionPointer",
      "zone": "tabs",
      "editorId": "revision-history",
      "availability": "when-capability-enabled:core.versioning"
    }
  ],
  "list": {
    "enabled": true,
    "columns": [
      {
        "field": "name",
        "label": "Name",
        "rendererId": "primary-text",
        "order": 10,
        "mobilePriority": "high"
      },
      {
        "field": "location",
        "label": "Location",
        "rendererId": "text",
        "order": 20,
        "mobilePriority": "high"
      },
      {
        "field": "publishing",
        "label": "Publishing",
        "rendererId": "status",
        "order": 30,
        "mobilePriority": "normal"
      }
    ],
    "search": true,
    "filters": [
      {
        "field": "key",
        "label": "Key"
      },
      {
        "field": "location",
        "label": "Location"
      }
    ],
    "bulkActions": "permission-and-rule-bound",
    "sorts": [],
    "searchFields": [
      "name",
      "key"
    ]
  },
  "actions": [
    {
      "actionId": "edit",
      "permissionId": "content.navigation.edit",
      "riskLevel": "elevated",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false
    },
    {
      "actionId": "manage",
      "permissionId": "content.navigation.manage",
      "riskLevel": "elevated",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false
    },
    {
      "actionId": "publish",
      "permissionId": "content.navigation.publish",
      "riskLevel": "elevated",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false
    },
    {
      "actionId": "view",
      "permissionId": "content.navigation.view",
      "riskLevel": "standard",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false
    },
    {
      "actionId": "save-draft",
      "permissionId": "content.navigation.edit",
      "riskLevel": "elevated",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false
    },
    {
      "actionId": "preview",
      "permissionId": "content.navigation.view",
      "riskLevel": "standard",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false
    },
    {
      "actionId": "schedule",
      "permissionId": "content.navigation.publish",
      "riskLevel": "elevated",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false
    }
  ],
  "permissions": [
    "content.navigation.edit",
    "content.navigation.manage",
    "content.navigation.publish",
    "content.navigation.view"
  ],
  "states": [
    "loading",
    "empty",
    "populated",
    "validation-error",
    "authorization-denied",
    "not-found",
    "conflict",
    "network-error",
    "success"
  ],
  "unsavedChanges": {
    "track": true,
    "warnOnLeave": true,
    "autosave": "draft-only-when-supported",
    "neverAutoExecute": [
      "publish",
      "approve",
      "delete",
      "refund",
      "fulfill",
      "disconnect",
      "rotate-secret"
    ]
  },
  "accessibility": {
    "labelsRequired": true,
    "keyboardComplete": true,
    "nonColorStatus": true,
    "dragAlternativeRequired": true
  },
  "notes": [],
  "primaryEditorId": "navigation-builder",
  "views": [
    {
      "id": "index",
      "kind": "list",
      "route": "/website/navigation",
      "layoutTemplate": "data-list",
      "requiresPermission": "content.navigation.view",
      "purpose": "Browse, search, filter and open authorized resources."
    },
    {
      "id": "record",
      "kind": "editor",
      "route": "/website/navigation/:id",
      "layoutTemplate": "builder-editor",
      "requiresPermission": "content.navigation.edit",
      "purpose": "Inspect and, where authorized, operate or edit one resource."
    }
  ]
}
