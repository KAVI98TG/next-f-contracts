  "relatedPanels": [],
  "list": {
    "enabled": false,
    "columns": [
      {
        "field": "scope",
        "label": "Scope",
        "rendererId": "primary-text",
        "order": 10,
        "mobilePriority": "high"
      },
      {
        "field": "storeName",
        "label": "Store Name",
        "rendererId": "text",
        "order": 20,
        "mobilePriority": "high"
      },
      {
        "field": "defaultCurrency",
        "label": "Default Currency",
        "rendererId": "text",
        "order": 30,
        "mobilePriority": "normal"
      },
      {
        "field": "country",
        "label": "Country",
        "rendererId": "text",
        "order": 40,
        "mobilePriority": "normal"
      }
    ],
    "search": true,
    "filters": "contract-and-permission-allowlisted",
    "bulkActions": "permission-and-rule-bound"
  },
  "actions": [
    {
      "actionId": "edit",
      "permissionId": "commerce.settings.edit",
      "riskLevel": "elevated",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false
    },
    {
      "actionId": "manage",
      "permissionId": "commerce.settings.manage",
      "riskLevel": "sensitive",
      "requiresRecentAuthentication": true,
      "requiresExplicitConfirmation": false
    },
    {
      "actionId": "view",
      "permissionId": "commerce.settings.view",
      "riskLevel": "standard",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false
    }
  ],
  "permissions": [
    "commerce.settings.edit",
    "commerce.settings.manage",
    "commerce.settings.view"
  ],
  "states": [
    "loading",
    "empty",
    "populated",
    "validation-error",
    "authorization-denied",
    "not-found",
    "conflict",
    "network-error",
    "success"
  ],
  "unsavedChanges": {
    "track": true,
    "warnOnLeave": true,
    "autosave": "draft-only-when-supported",
    "neverAutoExecute": [
      "publish",
      "approve",
      "delete",
      "refund",
      "fulfill",
      "disconnect",
      "rotate-secret"
    ]
  },
  "accessibility": {
    "labelsRequired": true,
    "keyboardComplete": true,
    "nonColorStatus": true,
    "dragAlternativeRequired": false
  },
  "notes": [],
  "views": [
    {
      "id": "primary",
      "kind": "settings",
      "route": "/commerce/settings",
      "layoutTemplate": "settings-page",
      "requiresPermission": "commerce.settings.edit",
      "purpose": "Primary Site-scoped Customer CMS surface."
    }
  ],
  "customerAccessPolicyRef": "customerAccess.policy.commerce.settings",
  "effectiveCustomerAccess": {
    "policyVersion": "1.1.0",
    "mode": "direct_edit",
    "publishingMode": "not_applicable",
    "actions": {
      "read": "allow",
      "create": "deny",
      "update": "allow",
      "delete": "deny",
      "submit_for_review": "deny",
      "publish": "deny",
      "unpublish": "deny",
      "restore_version": "deny"
    },
    "permissionRefs": {
      "read": [
        "commerce.settings.view"
      ],
      "create": [],
      "update": [
        "commerce.settings.edit",
        "commerce.settings.manage"
      ],
      "delete": [],
      "submit_for_review": [],
      "publish": [],
      "unpublish": [],
      "restore_version": []
    },
    "capabilityRefs": [
      "commerce.catalog"
    ],
    "demoMode": "read_only_sample",
    "approvalRequired": false,
    "hiddenFromCustomerDiscovery": false,
    "unavailableReason": null
  }
