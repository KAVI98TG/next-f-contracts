      "group": "configuration",
      "zone": "main",
      "order": 60,
      "required": true,
      "customerEditable": true,
      "adminEditable": true,
      "width": "half",
      "sourceFieldType": "fields.select",
      "validationHint": {},
      "searchable": false,
      "filterable": false,
      "sortable": false,
      "localizable": false,
      "revisionTracked": false
    },
    {
      "field": "customerAccounts",
      "label": "Customer Accounts",
      "description": "Customer account policy.",
      "editorId": "select",
      "group": "configuration",
      "zone": "main",
      "order": 70,
      "required": true,
      "customerEditable": true,
      "adminEditable": true,
      "width": "half",
      "sourceFieldType": "fields.select",
      "validationHint": {},
      "searchable": false,
      "filterable": false,
      "sortable": false,
      "localizable": false,
      "revisionTracked": false
