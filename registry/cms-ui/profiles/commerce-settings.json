      "editorId": "hidden",
      "group": "system",
      "zone": "hidden-system",
      "order": 10,
      "required": true,
      "customerEditable": false,
      "adminEditable": null,
      "width": "half",
      "sourceFieldType": "core.tenantScope",
      "validationHint": {},
      "searchable": false,
      "filterable": false,
      "sortable": false,
      "localizable": false,
      "revisionTracked": false
    },
    {
      "field": "storeName",
      "label": "Store Name",
