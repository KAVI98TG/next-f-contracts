      "required": true,
      "customerEditable": true,
      "adminEditable": true,
      "width": "half",
      "sourceFieldType": "fields.text",
      "validationHint": {},
      "searchable": false,
      "filterable": false,
      "sortable": false,
      "localizable": false,
      "revisionTracked": false
    },
    {
      "field": "weightUnit",
      "label": "Weight Unit",
      "description": "Default weight unit.",
