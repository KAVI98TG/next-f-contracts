{
  "$id": "cmsUi.profile.commerce.settings",
  "name": "Website Settings",
  "version": "1.1.0",
  "status": "stable",
  "domain": "cms-ui",
  "profileType": "resource",
  "resource": "commerce.settings",
  "moduleId": "commerce",
  "description": "Customer CMS presentation metadata for Website Settings within authorized Site scope.",
  "targetContracts": [
    "commerce.storeSettings"
  ],
  "primaryTargetContract": "commerce.storeSettings",
  "route": "/commerce/settings",
  "screenKind": "settings",
  "layoutTemplate": "settings-page",
  "responsivePolicy": "standard",
