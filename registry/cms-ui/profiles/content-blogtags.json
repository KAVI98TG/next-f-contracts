{
  "$id": "cmsUi.profile.content.blogtags",
  "name": "Blog Tags",
  "version": "0.20.0",
  "status": "stable",
  "domain": "cms-ui",
  "profileType": "resource",
  "resource": "content.blogtags",
  "moduleId": "blog",
  "description": "Customer CMS presentation metadata for Blog Tags within authorized Site scope.",
  "targetContracts": [
    "content.blogTag"
  ],
  "primaryTargetContract": "content.blogTag",
  "route": "/content/blog/tags",
  "screenKind": "editor",
  "layoutTemplate": "standard-editor",
  "responsivePolicy": "standard",
  "fieldBindings": [
    {
      "field": "identity",
      "label": "Identity",
      "description": "Stable entity identity.",
      "editorId": "hidden",
      "group": "system",
      "zone": "hidden-system",
      "order": 10,
      "required": true,
      "customerEditable": false,
      "adminEditable": null,
      "width": "half",
      "sourceFieldType": "core.entityIdentity",
      "validationHint": {},
      "searchable": false,
      "filterable": false,
      "sortable": false,
      "localizable": false,
      "revisionTracked": false
    },
    {
      "field": "scope",
      "label": "Scope",
      "description": "Owning Organization and Site scope.",
      "editorId": "hidden",
      "group": "system",
      "zone": "hidden-system",
      "order": 20,
      "required": true,
      "customerEditable": false,
      "adminEditable": null,
      "width": "half",
      "sourceFieldType": "core.tenantScope",
      "validationHint": {},
      "searchable": false,
      "filterable": false,
      "sortable": false,
      "localizable": false,
      "revisionTracked": false
    },
    {
      "field": "name",
      "label": "Name",
      "description": "Tag name.",
      "editorId": "single-line-text",
      "group": "content",
      "zone": "main",
      "order": 30,
      "required": true,
      "customerEditable": true,
      "adminEditable": true,
      "width": "full",
      "sourceFieldType": "fields.text",
      "validationHint": {
        "minLength": 1,
        "maxLength": 100
      },
      "searchable": true,
      "filterable": false,
      "sortable": true,
      "localizable": true,
      "revisionTracked": true
    },
    {
      "field": "slug",
      "label": "Slug",
      "description": "Tag slug.",
      "editorId": "slug",
      "group": "configuration",
      "zone": "sidebar",
      "order": 40,
      "required": true,
      "customerEditable": true,
      "adminEditable": true,
      "width": "half",
      "sourceFieldType": "fields.slug",
      "validationHint": {
        "minLength": 1,
        "maxLength": 120
      },
      "searchable": true,
      "filterable": false,
      "sortable": false,
      "localizable": false,
      "revisionTracked": true
    },
    {
      "field": "description",
      "label": "Description",
      "description": "Optional tag description.",
      "editorId": "multi-line-text",
      "group": "content",
      "zone": "main",
      "order": 50,
      "required": false,
      "customerEditable": true,
      "adminEditable": true,
      "width": "full",
      "sourceFieldType": "fields.textarea",
      "validationHint": {
        "maxLength": 1000
      },
      "searchable": true,
      "filterable": false,
      "sortable": false,
      "localizable": true,
      "revisionTracked": true
    },
    {
      "field": "publishing",
      "label": "Publishing",
      "description": "Canonical publishing, visibility and scheduling state.",
      "editorId": "publishing-panel",
      "group": "publishing",
      "zone": "sidebar",
      "order": 60,
      "required": true,
      "customerEditable": true,
      "adminEditable": null,
      "width": "full",
      "sourceFieldType": "core.publishing",
      "validationHint": {},
      "searchable": false,
      "filterable": false,
      "sortable": false,
      "localizable": false,
      "revisionTracked": false
    },
    {
      "field": "revision",
      "label": "Revision",
      "description": "Current and published revision pointers.",
      "editorId": "hidden",
      "group": "system",
      "zone": "hidden-system",
      "order": 70,
      "required": false,
      "customerEditable": false,
      "adminEditable": null,
      "width": "half",
      "sourceFieldType": "core.revisionPointer",
      "validationHint": {},
      "searchable": false,
      "filterable": false,
      "sortable": false,
      "localizable": false,
      "revisionTracked": false
    }
  ],
  "relatedPanels": [
    {
      "id": "publishing",
      "label": "Publishing",
      "contractId": "core.publishing",
      "zone": "sidebar",
      "editorId": "publishing-panel",
      "availability": "always"
    },
    {
      "id": "revisions",
      "label": "Version History",
      "contractId": "core.revisionPointer",
      "zone": "tabs",
      "editorId": "revision-history",
      "availability": "when-capability-enabled:core.versioning"
    }
  ],
  "list": {
    "enabled": true,
    "columns": [
      {
        "field": "name",
        "label": "Name",
        "rendererId": "primary-text",
        "order": 10,
        "mobilePriority": "high"
      },
      {
        "field": "slug",
        "label": "Slug",
        "rendererId": "text",
        "order": 20,
        "mobilePriority": "high"
      }
    ],
    "search": true,
    "filters": [],
    "bulkActions": "permission-and-rule-bound",
    "sorts": [
      {
        "field": "name",
        "label": "Name"
      }
    ],
    "searchFields": [
      "name",
      "slug",
      "description"
    ]
  },
  "actions": [
    {
      "actionId": "create",
      "permissionId": "content.blogtags.create",
      "riskLevel": "elevated",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false
    },
    {
      "actionId": "delete",
      "permissionId": "content.blogtags.delete",
      "riskLevel": "destructive",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": true
    },
    {
      "actionId": "edit",
      "permissionId": "content.blogtags.edit",
      "riskLevel": "elevated",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false
    },
    {
      "actionId": "manage",
      "permissionId": "content.blogtags.manage",
      "riskLevel": "elevated",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false
    },
    {
      "actionId": "view",
      "permissionId": "content.blogtags.view",
      "riskLevel": "standard",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false
    },
    {
      "actionId": "save-draft",
      "permissionId": "content.blogtags.edit",
      "riskLevel": "elevated",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false
    },
    {
      "actionId": "preview",
      "permissionId": "content.blogtags.view",
      "riskLevel": "standard",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false
    }
  ],
  "permissions": [
    "content.blogtags.create",
    "content.blogtags.delete",
    "content.blogtags.edit",
    "content.blogtags.manage",
    "content.blogtags.view"
  ],
  "states": [
    "loading",
    "empty",
    "populated",
    "validation-error",
    "authorization-denied",
    "not-found",
    "conflict",
    "network-error",
    "success"
  ],
  "unsavedChanges": {
    "track": true,
    "warnOnLeave": true,
    "autosave": "draft-only-when-supported",
    "neverAutoExecute": [
      "publish",
      "approve",
      "delete",
      "refund",
      "fulfill",
      "disconnect",
      "rotate-secret"
    ]
  },
  "accessibility": {
    "labelsRequired": true,
    "keyboardComplete": true,
    "nonColorStatus": true,
    "dragAlternativeRequired": false
  },
  "notes": [],
  "views": [
    {
      "id": "index",
      "kind": "list",
      "route": "/content/blog/tags",
      "layoutTemplate": "data-list",
      "requiresPermission": "content.blogtags.view",
      "purpose": "Browse, search, filter and open authorized resources."
    },
    {
      "id": "create",
      "kind": "editor",
      "route": "/content/blog/tags/new",
      "layoutTemplate": "standard-editor",
      "requiresPermission": "content.blogtags.create",
      "purpose": "Create a new canonical resource."
    },
    {
      "id": "record",
      "kind": "editor",
      "route": "/content/blog/tags/:id",
      "layoutTemplate": "standard-editor",
      "requiresPermission": "content.blogtags.edit",
      "purpose": "Inspect and, where authorized, operate or edit one resource."
    }
  ]
}
