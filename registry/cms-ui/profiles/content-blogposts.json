    "enabled": true,
    "columns": [
      {
        "field": "title",
        "label": "Title",
        "rendererId": "primary-text",
        "order": 10,
        "mobilePriority": "high"
      },
      {
        "field": "author",
        "label": "Author",
        "rendererId": "text",
        "order": 20,
        "mobilePriority": "high"
      },
      {
        "field": "publishing",
        "label": "Publishing",
        "rendererId": "status",
        "order": 30,
        "mobilePriority": "normal"
      }
    ],
    "search": true,
    "filters": [
      {
        "field": "slug",
        "label": "Slug"
      },
      {
        "field": "isFeatured",
        "label": "Is Featured"
      }
    ],
    "bulkActions": "permission-and-rule-bound",
    "sorts": [
      {
        "field": "readingTimeMinutes",
        "label": "Reading Time Minutes"
      }
    ],
    "searchFields": [
      "title",
      "slug",
      "excerpt",
      "content"
    ]
