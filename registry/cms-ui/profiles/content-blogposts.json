    {
      "actionId": "create",
      "permissionId": "content.blogposts.create",
      "riskLevel": "elevated",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false
    },
    {
      "actionId": "delete",
      "permissionId": "content.blogposts.delete",
      "riskLevel": "destructive",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": true
    },
    {
      "actionId": "edit",
      "permissionId": "content.blogposts.edit",
      "riskLevel": "elevated",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false
    },
    {
      "actionId": "publish",
      "permissionId": "content.blogposts.publish",
      "riskLevel": "elevated",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false
    },
    {
      "actionId": "view",
      "permissionId": "content.blogposts.view",
      "riskLevel": "standard",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false
    },
    {
      "actionId": "save-draft",
      "permissionId": "content.blogposts.edit",
      "riskLevel": "elevated",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false
    },
    {
      "actionId": "preview",
      "permissionId": "content.blogposts.view",
      "riskLevel": "standard",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false
    },
    {
      "actionId": "schedule",
      "permissionId": "content.blogposts.publish",
      "riskLevel": "elevated",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false
    }
  ],
  "permissions": [
    "content.blogposts.approve",
    "content.blogposts.create",
    "content.blogposts.delete",
    "content.blogposts.edit",
    "content.blogposts.publish",
    "content.blogposts.view"
  ],
  "states": [
    "loading",
    "empty",
    "populated",
    "validation-error",
    "authorization-denied",
    "not-found",
    "conflict",
    "network-error",
    "success"
  ],
  "unsavedChanges": {
    "track": true,
    "warnOnLeave": true,
    "autosave": "draft-only-when-supported",
    "neverAutoExecute": [
      "publish",
      "approve",
      "delete",
      "refund",
      "fulfill",
      "disconnect",
      "rotate-secret"
    ]
  },
  "accessibility": {
    "labelsRequired": true,
    "keyboardComplete": true,
    "nonColorStatus": true,
    "dragAlternativeRequired": false
  },
  "notes": [],
  "views": [
    {
      "id": "index",
      "kind": "list",
      "route": "/content/blog",
      "layoutTemplate": "data-list",
      "requiresPermission": "content.blogposts.view",
      "purpose": "Browse, search, filter and open authorized resources."
    },
    {
      "id": "create",
      "kind": "editor",
      "route": "/content/blog/new",
      "layoutTemplate": "editorial-editor",
      "requiresPermission": "content.blogposts.create",
      "purpose": "Create a new canonical resource."
    },
    {
      "id": "record",
      "kind": "editor",
      "route": "/content/blog/:id",
      "layoutTemplate": "editorial-editor",
      "requiresPermission": "content.blogposts.edit",
      "purpose": "Inspect and, where authorized, operate or edit one resource."
    }
  ],
  "customerAccessPolicyRef": "customerAccess.policy.content.blogposts",
  "effectiveCustomerAccess": {
    "policyVersion": "1.1.0",
    "mode": "direct_edit",
    "publishingMode": "direct",
    "actions": {
      "read": "allow",
      "create": "allow",
      "update": "allow",
      "delete": "allow",
      "submit_for_review": "deny",
      "publish": "allow",
      "unpublish": "deny",
      "restore_version": "deny"
    },
    "permissionRefs": {
      "read": [
        "content.blogposts.view"
      ],
      "create": [
        "content.blogposts.create"
      ],
      "update": [
        "content.blogposts.edit",
        "content.blogposts.publish"
      ],
      "delete": [
        "content.blogposts.delete"
      ],
      "submit_for_review": [
        "content.blogposts.approve"
      ],
      "publish": [
        "content.blogposts.publish"
      ],
      "unpublish": [],
      "restore_version": []
    },
    "capabilityRefs": [
      "blog.approvals",
      "blog.related-posts",
      "blog.scheduling"
    ],
    "demoMode": "simulated_write_sample",
    "approvalRequired": false,
    "hiddenFromCustomerDiscovery": false,
    "unavailableReason": null
  }
}
