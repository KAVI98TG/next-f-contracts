{
  "eventKey": "webhook.delivery-dead-lettered",
  "name": "Webhook Delivery Dead Lettered",
  "category": "webhooks",
  "producerKey": "webhook-service",
  "subjectContracts": [
    "webhooks.delivery"
  ],
  "trigger": "A logical webhook delivery exhausts retry/defer policy and enters the dead-letter state.",
  "dataPolicy": {
    "sensitivity": "internal",
    "containsPersonalData": false,
    "containsFinancialData": false,
    "containsSecrets": false,
    "redactionRequired": true
  },
  "webhookEligible": false,
  "consumers": [
    "audit",
    "nextf-admin",
    "notification",
    "automation"
  ],
  "payloadFields": [
    {
      "key": "deliveryId",
      "required": true,
      "description": "Logical Delivery ID.",
      "type": "id"
    },
    {
      "key": "subscriptionId",
      "required": true,
      "description": "Subscription ID.",
      "type": "id"
    },
    {
      "key": "eventId",
      "required": true,
      "description": "Original canonical Event ID.",
      "type": "id"
    },
    {
      "key": "reasonCode",
      "required": true,
      "description": "Dead-letter reason.",
      "type": "string"
    },
    {
      "key": "attemptCount",
      "required": true,
      "description": "Total attempt count.",
      "type": "integer"
    }
  ],
  "$id": "webhook.delivery-dead-lettered",
  "version": "0.15.0",
  "eventVersion": "1.0.0",
  "status": "stable",
  "domain": "events",
  "description": "A logical webhook delivery exhausts retry/defer policy and enters the dead-letter state.",
  "purpose": "Provides a canonical internal lifecycle fact for webhook delivery dead lettered without allowing recursive webhook delivery.",
  "semantics": {
    "factOnly": true,
    "authoritativeAfterCommit": true,
    "immutableOccurrence": true,
    "transportIndependent": true,
    "marketingTrackingEquivalent": null
  },
  "productionPolicy": {
    "durability": "durable",
    "commitBoundary": "transactional-outbox",
    "failureBehavior": "fail-domain-commit-or-durable-recovery"
  },
  "idempotency": {
    "dedupeKey": "eventId",
    "replayedIdempotentCommand": "no-new-semantic-event",
    "consumerIdempotencyRequired": true
  },
  "orderingPolicy": {
    "scope": "webhook-object",
    "strict": false
  },
  "retention": {
    "class": "standard-audit"
  },
  "relationships": [
    {
      "type": "references",
      "target": "webhooks.delivery",
      "description": "Event subject is webhooks.delivery."
    }
  ],
  "validationRules": [
    {
      "id": "emitAfterAuthoritativeCommit",
      "description": "Event is produced only after the authoritative webhook lifecycle transition is durably accepted."
    },
    {
      "id": "immutableOccurrence",
      "description": "Recorded event occurrences are immutable."
    },
    {
      "id": "eventIdUnique",
      "description": "Every semantic occurrence has one globally unique eventId."
    },
    {
      "id": "noRecursiveWebhook",
      "description": "This webhook lifecycle event is never itself webhook eligible and cannot create recursive webhook delivery."
    },
    {
      "id": "payloadMinimumNecessary",
      "description": "Payload contains only data required by declared consumers."
    },
    {
      "id": "noSecrets",
      "description": "Payload never includes signing secrets, destination credentials, Authorization values or raw webhook signatures."
    },
    {
      "id": "tenantScope",
      "description": "Organization/Site scope must match the authoritative webhook object."
    },
    {
      "id": "transportIndependent",
      "description": "Event meaning remains independent of queue, HTTP and storage implementation."
    }
  ],
  "futureBindings": {
    "webhooks": "phase-14-implemented",
    "permissions": "phase-15",
    "siteManifest": "phase-16",
    "modules": "phase-17"
  }
}
