{
  "eventKey": "inventory.out-of-stock",
  "name": "Inventory Out of Stock",
  "category": "commerce-inventory",
  "producerKey": "inventory-domain",
  "subjectContracts": [
    "commerce.inventoryItem",
    "commerce.inventoryLevel"
  ],
  "trigger": "Available quantity crosses to the configured out-of-stock condition.",
  "dataPolicy": {
    "sensitivity": "internal",
    "containsPersonalData": false,
    "containsFinancialData": false,
    "containsSecrets": false,
    "redactionRequired": false
  },
  "webhookEligible": true,
  "consumers": [
    "audit",
    "customer-cms",
    "nextf-admin",
    "notification",
    "commerce-reconciliation",
    "integration-dispatch",
    "webhook-bridge"
  ],
  "payloadFields": [
    {
      "key": "inventoryItemId",
      "required": true,
      "description": "Inventory item ID.",
      "type": "id"
    },
    {
      "key": "locationId",
      "required": false,
      "description": "Inventory location ID.",
      "type": "id"
    },
    {
      "key": "quantityDelta",
      "required": false,
      "description": "Applied quantity delta.",
      "type": "decimal"
    },
    {
      "key": "availableQuantity",
      "required": false,
      "description": "Resulting available quantity.",
      "type": "decimal"
    },
    {
      "key": "threshold",
      "required": false,
      "description": "Relevant low-stock threshold.",
      "type": "decimal"
    }
  ],
  "$id": "inventory.out-of-stock",
  "version": "0.14.0",
  "eventVersion": "1.0.0",
  "status": "stable",
  "domain": "events",
  "description": "Available quantity crosses to the configured out-of-stock condition.",
  "purpose": "Provides a canonical, reusable fact event for inventory out of stock across NEXT F systems.",
  "semantics": {
    "factOnly": true,
    "authoritativeAfterCommit": true,
    "immutableOccurrence": true,
    "transportIndependent": true,
    "marketingTrackingEquivalent": null
  },
  "productionPolicy": {
    "durability": "durable",
    "commitBoundary": "transactional-outbox",
    "failureBehavior": "fail-domain-commit-or-durable-recovery"
  },
  "idempotency": {
    "dedupeKey": "eventId",
    "replayedIdempotentCommand": "no-new-semantic-event",
    "consumerIdempotencyRequired": true
  },
  "orderingPolicy": {
    "scope": "inventory-item",
    "strict": false
  },
  "retention": {
    "class": "transaction-history"
  },
  "relationships": [
    {
      "type": "references",
      "target": "commerce.inventoryItem",
      "description": "Event subject may be commerce.inventoryItem."
    },
    {
      "type": "references",
      "target": "commerce.inventoryLevel",
      "description": "Event subject may be commerce.inventoryLevel."
    }
  ],
  "validationRules": [
    {
      "id": "emitAfterAuthoritativeCommit",
      "description": "Event is produced only after the authoritative domain transition is accepted; atomic outbox/equivalent durability is required for transactional mutations."
    },
    {
      "id": "immutableOccurrence",
      "description": "Recorded event occurrences are immutable."
    },
    {
      "id": "eventIdUnique",
      "description": "Every semantic occurrence has one globally unique eventId."
    },
    {
      "id": "idempotentReplay",
      "description": "Retrying the same idempotent command must return/reuse the original outcome and must not emit a second semantic fact event."
    },
    {
      "id": "payloadMinimumNecessary",
      "description": "Payload contains only data required by declared consumers; consumers fetch additional authorized data separately when needed."
    },
    {
      "id": "noSecrets",
      "description": "Payload must never contain API secrets, auth tokens, signing secrets, raw payment-card data or other credentials."
    },
    {
      "id": "tenantScope",
      "description": "Organization/Site scope must match the authoritative subject and producing operation."
    },
    {
      "id": "transportIndependent",
      "description": "Event semantics do not depend on webhook, queue, HTTP, database or provider transport implementation."
    }
  ],
  "futureBindings": {
    "webhooks": "phase-14",
    "permissions": "phase-15",
    "siteManifest": "phase-16",
    "modules": "phase-17",
    "api": "phase-18",
    "privacy": "phase-30"
  },
  "examples": {
    "valid": [
      {
        "eventKey": "inventory.out-of-stock",
        "eventVersion": "1.0.0",
        "eventId": "evt_example",
        "occurredAt": "2026-09-10T00:00:00Z"
      }
    ],
    "invalid": [
      {
        "eventKey": "inventory.out-of-stock",
        "eventId": "evt_duplicate",
        "problem": "duplicate semantic event emitted for an idempotent command replay"
      }
    ]
  }
}
