    },
    {
      "fieldRef": "cmsUi.profile.content.blogposts#tags",
      "field": "tags",
      "contractFieldRef": "content.blogPost.tags",
      "mode": "inherit"
    },
    {
      "fieldRef": "cmsUi.profile.content.blogposts#relatedPosts",
      "field": "relatedPosts",
      "contractFieldRef": "content.blogPost.relatedPosts",
      "mode": "inherit"
