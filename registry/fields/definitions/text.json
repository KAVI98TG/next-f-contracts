    "sortable",
    "localizable",
    "revisionTracked",
    "conditionalVisibility",
    "width",
    "placeholder",
    "minLength",
    "maxLength",
    "pattern",
    "trim",
    "normalizeWhitespace",
    "allowEmptyString",
    "autocomplete",
