{
  "$id": "fields.dateTime",
  "name": "DateTime",
  "version": "0.4.0",
  "status": "stable",
  "category": "temporal",
  "description": "Instant or explicitly zoned date-time for events and system timestamps.",
  "value": {
    "jsonType": "string",
