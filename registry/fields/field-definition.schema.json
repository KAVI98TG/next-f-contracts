{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contract.nextf.lk/schema/primitive-field-definition.json",
  "title": "NEXT F Primitive Field Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$id",
    "name",
    "version",
    "status",
    "category",
    "description",
    "value",
    "cms",
    "capabilities",
    "supportedConfig",
    "validationRules",
    "examples",
    "notes"
  ],
  "properties": {
    "$id": {
      "type": "string",
      "pattern": "^fields\\.[a-z][A-Za-z0-9]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "enum": [
        "experimental",
        "draft",
        "stable",
        "deprecated",
        "removed"
      ]
    },
    "category": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "value": {
      "type": "object"
    },
    "cms": {
      "type": "object"
    },
    "capabilities": {
      "type": "object"
    },
    "supportedConfig": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "validationRules": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "examples": {
      "type": "object",
      "required": [
        "valid",
        "invalid"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
