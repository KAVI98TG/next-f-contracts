{
  "$id": "webhooks.secrets.manage",
  "name": "Manage Secrets",
  "permissionId": "webhooks.secrets.manage",
  "domain": "webhooks",
  "resource": "secrets",
  "action": "manage",
  "scopeKind": "site",
  "riskLevel": "sensitive",
  "customerEligible": true,
  "adminEligible": true,
  "grantable": true,
  "requiresRecentAuthentication": true,
  "requiresExplicitConfirmation": false,
  "surfaces": [
    "customer-cms",
    "nextf-admin",
    "api"
  ],
  "description": "Manage Secrets within the authorized site scope.",
  "constraints": [
    "deny-by-default",
    "exact-permission-match",
    "scope-bound"
  ],
  "notes": [
    "May be assigned only through approved high-trust customer roles; the secret value itself is never exposed by this permission."
  ],
  "version": "0.16.0",
  "status": "stable"
}
