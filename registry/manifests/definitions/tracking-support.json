{
  "$id": "manifest.trackingSupport",
  "name": "Tracking Event Support",
  "version": "1.4.0",
  "status": "stable",
  "domain": "manifest",
  "category": "surfaces-bindings",
  "description": "Declares Phase 9 visitor/marketing tracking events implemented by the Site UI.",
  "purpose": "Keeps visitor measurement observations distinct from authoritative Phase 13 domain Events.",
  "manifestModel": {
    "kind": "embedded",
    "customerManaged": false,
    "repositoryManaged": true
  },
  "fields": [
    {
      "key": "events",
      "required": true,
      "nullable": false,
      "description": "Canonical NEXT F Marketing tracking event IDs supported by the Site.",
      "primitive": "fields.tag",
      "config": {
        "uniqueItems": true,
        "customerEditable": false,
        "adminEditable": true
      }
    },
    {
      "key": "enabled",
      "required": false,
      "nullable": true,
      "description": "Whether first-party tracking is enabled; absence is interpreted as disabled by V1.4 consumers.",
      "primitive": "fields.boolean"
    },
    {
      "key": "contractVersion",
      "required": false,
      "nullable": true,
      "description": "Exact tracking envelope/contract version.",
      "primitive": "fields.text"
    },
    {
      "key": "sdkId",
      "required": false,
      "nullable": true,
      "description": "Compatible SDK identifier.",
      "primitive": "fields.text"
    },
    {
      "key": "sdkVersion",
      "required": false,
      "nullable": true,
      "description": "Exact compatible SDK version.",
      "primitive": "fields.text"
    },
    {
      "key": "collectorApiId",
      "required": false,
      "nullable": true,
      "description": "Canonical collector API operation ID.",
      "primitive": "fields.text"
    },
    {
      "key": "consentMode",
      "required": false,
      "nullable": true,
      "description": "Consent evaluation mode.",
      "primitive": "fields.text"
    },
    {
      "key": "retentionPolicyRef",
      "required": false,
      "nullable": true,
      "description": "Tracking data/retention policy reference.",
      "primitive": "fields.text"
    },
    {
      "key": "allowedEventNamespaces",
      "required": false,
      "nullable": true,
      "description": "Approved canonical or namespaced tracking prefixes.",
      "primitive": "fields.tag"
    },
    {
      "key": "reportingEnabled",
      "required": false,
      "nullable": true,
      "description": "Whether authorized analytics reporting is enabled.",
      "primitive": "fields.boolean"
    }
  ],
  "relationships": [
    {
      "type": "optionallyReferences",
      "target": "marketing.trackingSdkDescriptor",
      "description": "Resolves SDK identity/version."
    },
    {
      "type": "optionallyReferences",
      "target": "marketing.trackingCompatibility",
      "description": "Resolves Contract/SDK/collector compatibility."
    },
    {
      "type": "optionallyReferences",
      "target": "marketing.trackingCollectorPolicy",
      "description": "Collector enforcement remains canonical."
    }
  ],
  "validationRules": [
    {
      "id": "trackingEventsMustResolve",
      "description": "Every tracking event must resolve to registry/marketing/tracking-events.json."
    },
    {
      "id": "trackingIsNotDomainEvent",
      "description": "Tracking support must never be interpreted as authoritative domain-event production."
    },
    {
      "id": "trackingRespectsConsent",
      "description": "Optional analytics/marketing dispatch remains governed by consent and destination data policy."
    },
    {
      "id": "absenceDisablesTracking",
      "description": "A V1.4 consumer must not initialize optional tracking when enabled is absent or false."
    }
  ],
  "cms": {
    "label": "Tracking Event Support",
    "icon": "fa-file-code",
    "customerVisible": false,
    "adminVisible": true,
    "defaultPlacement": "development",
    "summaryFields": [
      "events"
    ]
  },
  "delivery": {
    "publicAllowed": false,
    "notes": "Manifest definitions contain technical declarations only. Secret values are prohibited."
  },
  "notes": []
}
