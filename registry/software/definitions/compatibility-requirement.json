    {
      "key": "maximumVersion",
      "required": false,
      "nullable": true,
      "description": "Maximum supported version.",
      "primitive": "fields.text"
    },
    {
      "key": "constraint",
      "required": true,
      "nullable": false,
      "description": "Canonical version-range/constraint expression.",
      "primitive": "fields.text"
    }
