{
  "registryVersion": "0.8.0",
  "fieldCase": "camelCase",
  "contractIdPattern": "lowercase dot notation, domain.entity",
  "eventPattern": "lowercase dot notation, completed fact",
  "permissionPattern": "domain.resource.action",
  "moduleIdCase": "lowercase or kebab-case",
  "capabilityPattern": "module.capability",
  "fileNameCase": "lowercase kebab-case",
  "urlCase": "lowercase kebab-case",
  "constantCase": "UPPER_SNAKE_CASE",
  "timestampSuffix": "At",
  "dateOnlySuffix": "Date",
  "canonicalPermissionActions": [
    "view",
    "create",
    "edit",
    "delete",
    "publish",
    "approve",
    "manage",
    "export"
  ],
  "idPrefixes": {
    "Organization": "org_",
    "Site": "site_",
    "OrganizationUser": "usr_",
    "Role": "role_",
    "Permission": "perm_",
    "Media": "media_",
    "Page": "page_",
    "BlogPost": "post_",
    "DocumentationArticle": "doc_",
    "Service": "svc_",
    "FAQ": "faq_",
    "Form": "form_",
    "FormSubmission": "subm_",
    "Lead": "lead_",
    "Product": "prod_",
    "ProductVariant": "var_",
    "Inventory": "inv_",
    "CommerceCustomer": "ccust_",
    "Cart": "cart_",
    "Checkout": "chk_",
    "Order": "ord_",
    "Payment": "pay_",
    "Refund": "ref_",
    "Shipment": "ship_",
    "Fulfillment": "ful_",
    "Discount": "disc_",
    "Return": "ret_",
    "Event": "evt_",
    "Integration": "int_",
    "Version": "ver_"
  }
}
