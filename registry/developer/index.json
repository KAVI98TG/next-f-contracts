{
  "registryVersion": "0.22.0",
  "standardVersion": "1.0.0",
  "title": "NEXT F Codex Development Registry",
  "description": "Machine-readable operational standard for Codex and other AI coding agents implementing NEXT F-integrated systems.",
  "standardId": "developer.codexDevelopmentStandard",
  "standardSource": "standards/29-codex-development-standard.md",
  "quickStart": "developer/CODEX-QUICKSTART.md",
  "masterEntryPoint": "NEXT-F-WEBSITE-DEVELOPMENT-STANDARD.md",
  "authorityModel": {
    "registryVersion": "0.22.0",
    "$id": "developer.authorityModel",
    "name": "Codex Authority Model",
    "version": "0.22.0",
    "status": "stable",
    "canonicalSemanticsOrder": [
      "machine-readable-contract",
      "site-manifest",
      "contract-specific-standard",
      "codex-development-standard",
      "approved-extension-or-migration",
      "generated-portal-docs",
      "examples"
    ],
    "projectIntentSources": [
      "explicit-project-requirement",
      "site-manifest",
      "approved-extension"
    ],
    "rules": [
      {
        "id": "AUTH-001",
        "statement": "Machine-readable NEXT F contracts are authoritative for canonical semantics."
      },
      {
        "id": "AUTH-002",
        "statement": "The Site Manifest is authoritative for the project pinned version, enabled Modules, Capabilities, environments and bindings."
      },
      {
        "id": "AUTH-003",
        "statement": "Customer requirements may choose supported presentation and behavior but may not silently redefine canonical semantics."
      },
      {
        "id": "AUTH-004",
        "statement": "Existing code is implementation state, not authority over a canonical contract."
      },
      {
        "id": "AUTH-005",
        "statement": "Examples and generated documentation are never more authoritative than their source contracts."
      },
      {
        "id": "AUTH-006",
        "statement": "Security, tenant isolation, permissions and business invariants cannot be waived for implementation convenience."
      }
    ]
  },
  "principles": [
    "manifest-first",
    "contract-first",
    "smallest-safe-change",
    "inspect-before-modify",
    "no-parallel-architecture",
    "server-side-authorization",
    "tenant-isolation",
    "secrets-server-side",
    "environment-isolation",
    "business-rule-integrity",
    "generated-source-authority",
    "explicit-migrations",
    "explicit-extensions",
    "explicit-deviations",
    "verification-truthfulness",
    "complete-handoff"
  ],
  "workflowStages": [
    {
      "id": "intake",
      "order": 1,
      "label": "Intake",
      "goal": "Resolve requested outcome, repository, Site, target environment and allowed change boundary.",
      "requiredEvidence": [
        "task goal",
        "repository scope",
        "target environment"
      ],
      "blocksOn": [
        "unclear-target-repository"
      ]
    },
    {
      "id": "repository-discovery",
      "order": 2,
      "label": "Repository Discovery",
      "goal": "Inspect existing stack, structure, commands, manifest, adapters, migrations and tests before modification.",
      "requiredEvidence": [
        "framework/runtime",
        "package manager",
        "build/test commands",
        "manifest location or absence"
      ]
    },
    {
      "id": "manifest-resolution",
      "order": 3,
      "label": "Manifest Resolution",
      "goal": "Resolve the exact Site Manifest and pinned Contract/API versions.",
      "requiredEvidence": [
        "siteId",
        "contractVersion",
        "module selections",
        "api bindings"
      ],
      "blocksOn": [
        "missing-required-manifest",
        "invalid-manifest",
        "unsupported-contract-version"
      ]
    },
    {
      "id": "registry-resolution",
      "order": 4,
      "label": "Registry Resolution",
      "goal": "Resolve canonical contracts, Modules, Capabilities, APIs, Permissions, Events, Webhooks, Integrations and UI metadata.",
      "requiredEvidence": [
        "contract mapping"
      ],
      "blocksOn": [
        "unknown-module-or-capability",
        "canonical-conflict"
      ]
    },
    {
      "id": "requirement-mapping",
      "order": 5,
      "label": "Requirement Mapping",
      "goal": "Map each requested behavior to canonical NEXT F definitions and identify missing coverage.",
      "requiredEvidence": [
        "feature-to-contract map"
      ],
      "blocksOn": [
        "missing-required-contract"
      ]
    },
    {
      "id": "implementation-plan",
      "order": 6,
      "label": "Implementation Plan",
      "goal": "Define the smallest compatible change set, boundaries, tests, migrations and risks.",
      "requiredEvidence": [
        "implementation plan"
      ]
    },
    {
      "id": "implementation",
      "order": 7,
      "label": "Implementation",
      "goal": "Implement customer-specific behavior against canonical contracts without parallel architecture.",
      "requiredEvidence": [
        "changed files",
        "adapter boundaries"
      ]
    },
    {
      "id": "verification",
      "order": 8,
      "label": "Verification",
      "goal": "Run relevant syntax, type, lint, test, build, migration and contract checks that are available.",
      "requiredEvidence": [
        "executed commands",
        "results",
        "unrun checks"
      ]
    },
    {
      "id": "deviation-review",
      "order": 9,
      "label": "Deviation Review",
      "goal": "Compare implementation with Manifest/contracts and record every deviation or extension.",
      "requiredEvidence": [
        "deviation list",
        "extension records when required"
      ]
    },
    {
      "id": "handoff",
      "order": 10,
      "label": "Handoff",
      "goal": "Produce a complete implementation report and unresolved-risk summary.",
      "requiredEvidence": [
        "implementation report"
      ]
    }
  ],
