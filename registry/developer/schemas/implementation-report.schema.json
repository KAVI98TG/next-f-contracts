{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "developer.implementationReport",
  "title": "Codex Implementation Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "taskId",
    "taskType",
    "contractVersion",
    "changedFiles",
    "verification",
    "extensions",
    "deviations",
    "remainingRisks"
  ],
  "properties": {
    "taskId": {
      "type": "string"
    },
    "taskType": {
      "type": "string"
    },
    "siteId": {
      "type": [
        "string",
        "null"
      ]
    },
    "manifestPath": {
      "type": [
        "string",
        "null"
      ]
    },
    "contractVersion": {
      "type": "string"
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "apiOperations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "webhooks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "integrations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "changedFiles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "migrations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "check",
          "status"
        ],
        "properties": {
          "check": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "not-run",
              "not-applicable"
            ]
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "extensions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deviations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "remainingRisks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nextAction": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
