{
  "$id": "commerce.inventoryTransfer",
  "name": "Inventory Transfer",
  "version": "0.12.0",
  "status": "stable",
  "domain": "commerce",
  "category": "inventory",
  "description": "Inventory movement between stock locations.",
  "purpose": "Prevents multi-location stock movement from being represented as unexplained quantity edits.",
  "commerceModel": {
    "kind": "transaction",
    "customerManaged": true,
    "containsPersonalData": false,
    "publicEligible": false,
    "supportsRevision": false,
    "transactional": true,
    "dataSensitivity": "internal"
  },
  "fields": [
    {
      "key": "transferId",
      "required": true,
      "nullable": false,
      "description": "Stable transfer ID.",
      "primitive": "fields.text"
    },
    {
      "key": "scope",
      "required": true,
      "nullable": false,
      "description": "Owning Site.",
      "schema": "core.tenantScope"
    },
    {
      "key": "sourceLocationId",
      "required": true,
      "nullable": false,
      "description": "Source Inventory Location.",
      "primitive": "fields.text"
    },
    {
      "key": "destinationLocationId",
      "required": true,
      "nullable": false,
      "description": "Destination Inventory Location.",
      "primitive": "fields.text"
    },
    {
      "key": "status",
      "required": true,
      "nullable": false,
      "description": "Transfer state.",
      "primitive": "fields.select",
      "config": {
        "options": [
          "draft",
          "in-transit",
          "received",
          "cancelled"
        ]
      }
    },
    {
      "key": "lines",
      "required": true,
      "nullable": false,
      "description": "Transferred lines.",
      "itemsSchema": "commerce.inventoryTransferLine",
      "config": {
        "minItems": 1
      }
    },
    {
      "key": "sentAt",
      "required": false,
      "nullable": true,
      "description": "Dispatch time.",
      "itemsPrimitive": "fields.dateTime"
    },
    {
      "key": "receivedAt",
      "required": false,
      "nullable": true,
      "description": "Receipt time.",
      "itemsPrimitive": "fields.dateTime"
    },
    {
      "key": "reference",
      "required": false,
      "nullable": true,
      "description": "Optional human reference.",
      "itemsPrimitive": "fields.text"
    }
  ],
  "relationships": [
    {
      "type": "references",
      "target": "commerce.inventoryLocation",
      "description": "References commerce.inventoryLocation."
    },
    {
      "type": "composes",
      "target": "commerce.inventoryTransferLine",
      "description": "References commerce.inventoryTransferLine."
    }
  ],
  "validationRules": [
    {
      "id": "differentLocations",
      "description": "Source and destination must be different."
    },
    {
      "id": "receivedAfterSent",
      "description": "receivedAt cannot precede sentAt."
    },
    {
      "id": "stockViaLedger",
      "description": "Transfer completion must result in traceable inventory adjustments rather than silent balance mutation."
    }
  ],
  "cms": {
    "label": "Inventory Transfer",
    "icon": "fa-cart-shopping",
    "customerVisible": true,
    "adminVisible": true,
    "editorMode": "commerce-schema",
    "defaultPlacement": "commerce",
    "summaryFields": [
      "transferId",
      "scope",
      "sourceLocationId",
      "destinationLocationId"
    ],
    "primaryActions": [
      "view",
      "edit"
    ]
  },
  "delivery": {
    "publicAllowed": false,
    "notes": "Private or operational commerce data; not eligible for unauthenticated public delivery."
  },
  "futureBindings": {
    "commerceRules": "phase-12",
    "events": "phase-13",
    "webhooks": "phase-14",
    "permissions": "phase-15",
    "siteManifest": "phase-16",
    "modules": "phase-17",
    "api": "phase-18",
    "privacy": "phase-30"
  },
  "examples": {
    "valid": [],
    "invalid": []
  },
  "notes": []
}
