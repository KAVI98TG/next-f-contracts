      "schema": "core.tenantScope"
    },
    {
      "key": "name",
      "required": true,
      "nullable": false,
      "description": "Rate label.",
      "primitive": "fields.text"
    },
    {
      "key": "percentage",
      "required": true,
      "nullable": false,
      "description": "Tax percentage.",
      "primitive": "fields.percentage"
    },
    {
      "key": "country",
