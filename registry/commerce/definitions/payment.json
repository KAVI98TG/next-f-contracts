{
  "$id": "commerce.payment",
  "name": "Payment",
  "version": "0.12.0",
  "status": "stable",
  "domain": "commerce",
  "category": "payments",
  "description": "Canonical normalized Payment record.",
  "purpose": "Separates NEXT F Payment semantics from provider-specific transaction APIs.",
  "commerceModel": {
    "kind": "entity",
    "customerManaged": true,
    "containsPersonalData": false,
    "publicEligible": false,
    "supportsRevision": false,
    "transactional": true,
    "dataSensitivity": "sensitive"
  },
  "fields": [
    {
      "key": "identity",
      "required": true,
      "nullable": false,
      "description": "Stable identity.",
      "schema": "core.entityIdentity"
    },
    {
      "key": "scope",
      "required": true,
      "nullable": false,
      "description": "Owning Site.",
      "schema": "core.tenantScope"
    },
    {
      "key": "orderId",
      "required": true,
      "nullable": false,
      "description": "Order ID.",
      "primitive": "fields.text"
    },
    {
      "key": "providerKey",
      "required": true,
      "nullable": false,
      "description": "Payment provider/connector key.",
      "primitive": "fields.text"
    },
    {
      "key": "amount",
      "required": true,
      "nullable": false,
      "description": "Payment amount.",
      "schema": "commerce.moneySnapshot"
    },
    {
      "key": "method",
      "required": false,
      "nullable": true,
      "description": "Safe method reference.",
      "schema": "commerce.paymentMethodReference"
    },
    {
      "key": "status",
      "required": true,
      "nullable": false,
      "description": "Payment state.",
      "primitive": "fields.select",
      "config": {
        "options": [
          "pending",
          "requires-action",
          "authorized",
          "partially-paid",
          "paid",
          "failed",
          "cancelled",
          "partially-refunded",
          "refunded"
        ]
      }
    },
    {
      "key": "providerPaymentId",
      "required": false,
      "nullable": true,
      "description": "Optional provider transaction reference.",
      "primitive": "fields.text"
    },
    {
      "key": "authorizedAt",
      "required": false,
      "nullable": true,
      "description": "Optional authorization time.",
      "primitive": "fields.dateTime"
    },
    {
      "key": "paidAt",
      "required": false,
      "nullable": true,
      "description": "Optional paid time.",
      "primitive": "fields.dateTime"
    },
    {
      "key": "refundedAmount",
      "required": false,
      "nullable": true,
      "description": "Optional aggregate refunded amount.",
      "schema": "commerce.moneySnapshot"
    },
    {
      "key": "createdAt",
      "required": true,
      "nullable": false,
      "description": "Creation time.",
      "primitive": "fields.dateTime"
    },
    {
      "key": "updatedAt",
      "required": true,
      "nullable": false,
      "description": "Update time.",
      "primitive": "fields.dateTime"
    },
    {
      "key": "authorizationIds",
      "required": false,
      "nullable": true,
      "description": "Related Payment Authorization IDs.",
      "itemsPrimitive": "fields.text",
      "config": {
        "uniqueItems": true
      }
    },
    {
      "key": "captureIds",
      "required": false,
      "nullable": true,
      "description": "Related Payment Capture IDs.",
      "itemsPrimitive": "fields.text",
      "config": {
        "uniqueItems": true
      }
    },
    {
      "key": "refundIds",
      "required": false,
      "nullable": true,
      "description": "Related Refund IDs.",
      "itemsPrimitive": "fields.text",
      "config": {
        "uniqueItems": true
      }
    }
  ],
  "relationships": [
    {
      "type": "belongsTo",
      "target": "commerce.order",
      "description": "References commerce.order."
    },
    {
      "type": "optionallyComposes",
      "target": "commerce.paymentMethodReference",
      "description": "References commerce.paymentMethodReference."
    },
    {
      "type": "composes",
      "target": "commerce.moneySnapshot",
      "description": "References commerce.moneySnapshot."
    },
    {
      "type": "relatedTo",
      "target": "integrations.integrationConnection",
      "description": "References integrations.integrationConnection."
    },
    {
      "type": "optionallyReferences",
      "target": "commerce.paymentAuthorization",
      "description": "References commerce.paymentAuthorization."
    },
    {
      "type": "optionallyReferences",
      "target": "commerce.paymentCapture",
      "description": "References commerce.paymentCapture."
    },
    {
      "type": "optionallyReferences",
      "target": "commerce.refund",
      "description": "References commerce.refund."
    }
  ],
  "validationRules": [
    {
      "id": "noRawCardData",
      "description": "Payment never stores PAN/CVV."
    },
    {
      "id": "providerAdapter",
      "description": "Provider payloads are translated through adapters."
    },
    {
      "id": "currencyMatchesOrder",
      "description": "Payment currency must be valid for its Order."
    }
  ],
  "cms": {
    "label": "Payment",
    "icon": "fa-cart-shopping",
    "customerVisible": true,
    "adminVisible": true,
    "editorMode": "commerce-schema",
    "defaultPlacement": "commerce",
    "summaryFields": [
      "orderId",
      "status",
      "amount",
      "providerKey"
    ],
    "primaryActions": [
      "view",
      "manage"
    ]
  },
  "delivery": {
    "publicAllowed": false,
    "notes": "Private or operational commerce data; not eligible for unauthenticated public delivery."
  },
  "futureBindings": {
    "commerceRules": "phase-12",
    "events": "phase-13",
    "webhooks": "phase-14",
    "permissions": "phase-15",
    "siteManifest": "phase-16",
    "modules": "phase-17",
    "api": "phase-18",
    "privacy": "phase-30"
  },
  "examples": {
    "valid": [],
    "invalid": []
  },
  "notes": []
}
