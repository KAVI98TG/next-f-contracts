{
  "$id": "commerce.shipment",
  "name": "Shipment",
  "version": "0.12.0",
  "status": "stable",
  "domain": "commerce",
  "category": "fulfillment",
  "description": "Physical Shipment created from Fulfillment.",
  "purpose": "Separates carrier tracking from Order fulfillment allocation.",
  "commerceModel": {
    "kind": "entity",
    "customerManaged": true,
    "containsPersonalData": true,
    "publicEligible": false,
    "supportsRevision": false,
    "transactional": true,
    "dataSensitivity": "personal"
  },
  "fields": [
    {
      "key": "identity",
      "required": true,
      "nullable": false,
      "description": "Stable identity.",
      "schema": "core.entityIdentity"
    },
    {
      "key": "scope",
      "required": true,
      "nullable": false,
      "description": "Owning Site.",
      "schema": "core.tenantScope"
    },
    {
      "key": "fulfillmentId",
      "required": true,
      "nullable": false,
      "description": "Fulfillment ID.",
      "primitive": "fields.text"
    },
    {
      "key": "shippingMethodId",
      "required": false,
      "nullable": true,
      "description": "Shipping Method ID.",
      "primitive": "fields.text"
    },
    {
      "key": "tracking",
      "required": false,
      "nullable": true,
      "description": "Tracking references.",
      "itemsSchema": "commerce.trackingReference"
    },
    {
      "key": "status",
      "required": true,
      "nullable": false,
      "description": "Shipment state.",
      "primitive": "fields.select",
      "config": {
        "options": [
          "pending",
          "label-created",
          "shipped",
          "in-transit",
          "delivered",
          "exception",
          "returned",
          "cancelled"
        ]
      }
    },
    {
      "key": "shippedAt",
      "required": false,
      "nullable": true,
      "description": "Optional shipped time.",
      "primitive": "fields.dateTime"
    },
    {
      "key": "deliveredAt",
      "required": false,
      "nullable": true,
      "description": "Optional delivered time.",
      "primitive": "fields.dateTime"
    },
    {
      "key": "packages",
      "required": false,
      "nullable": true,
      "description": "Physical packages in this shipment.",
      "itemsSchema": "commerce.package",
      "config": {
        "minItems": 0
      }
    }
  ],
  "relationships": [
    {
      "type": "belongsTo",
      "target": "commerce.fulfillment",
      "description": "References commerce.fulfillment."
    },
    {
      "type": "optionallyComposesMany",
      "target": "commerce.trackingReference",
      "description": "References commerce.trackingReference."
    },
    {
      "type": "composes",
      "target": "commerce.package",
      "description": "References commerce.package."
    }
  ],
  "validationRules": [],
  "cms": {
    "label": "Shipment",
    "icon": "fa-cart-shopping",
    "customerVisible": true,
    "adminVisible": true,
    "editorMode": "commerce-schema",
    "defaultPlacement": "commerce",
    "summaryFields": [
      "identity",
      "scope",
      "fulfillmentId",
      "shippingMethodId"
    ],
    "primaryActions": [
      "view",
      "edit"
    ]
  },
  "delivery": {
    "publicAllowed": false,
    "notes": "Private or operational commerce data; not eligible for unauthenticated public delivery."
  },
  "futureBindings": {
    "commerceRules": "phase-12",
    "events": "phase-13",
    "webhooks": "phase-14",
    "permissions": "phase-15",
    "siteManifest": "phase-16",
    "modules": "phase-17",
    "api": "phase-18",
    "privacy": "phase-30"
  },
  "examples": {
    "valid": [],
    "invalid": []
  },
  "notes": []
}
