{
  "$id": "commerce.reviewModeration",
  "name": "Review Moderation",
  "version": "0.12.0",
  "status": "stable",
  "domain": "commerce",
  "category": "returns",
  "description": "Product Review moderation state.",
  "purpose": "Separates submitted review content from moderation decisions.",
  "commerceModel": {
    "kind": "snapshot",
    "customerManaged": true,
    "containsPersonalData": false,
    "publicEligible": false,
    "supportsRevision": false,
    "transactional": false,
    "dataSensitivity": "internal"
  },
  "fields": [
    {
      "key": "status",
      "required": true,
      "nullable": false,
      "description": "Moderation state.",
      "primitive": "fields.select",
      "config": {
        "options": [
          "pending",
          "approved",
          "rejected",
          "spam",
          "removed"
        ]
      }
    },
    {
      "key": "reason",
      "required": false,
      "nullable": true,
      "description": "Optional moderation reason.",
      "primitive": "fields.text"
    },
    {
      "key": "actor",
      "required": false,
      "nullable": true,
      "description": "Moderator.",
      "schema": "core.actorReference"
    },
    {
      "key": "moderatedAt",
      "required": false,
      "nullable": true,
      "description": "Moderation time.",
      "primitive": "fields.dateTime"
    }
  ],
  "relationships": [
    {
      "type": "optionallyComposes",
      "target": "core.actorReference",
      "description": "References core.actorReference."
    }
  ],
  "validationRules": [],
  "cms": {
    "label": "Review Moderation",
    "icon": "fa-cart-shopping",
    "customerVisible": true,
    "adminVisible": true,
    "editorMode": "commerce-schema",
    "defaultPlacement": "commerce",
    "summaryFields": [
      "status",
      "reason",
      "actor",
      "moderatedAt"
    ],
    "primaryActions": [
      "view",
      "edit"
    ]
  },
  "delivery": {
    "publicAllowed": false,
    "notes": "Private or operational commerce data; not eligible for unauthenticated public delivery."
  },
  "futureBindings": {
    "commerceRules": "phase-12",
    "events": "phase-13",
    "webhooks": "phase-14",
    "permissions": "phase-15",
    "siteManifest": "phase-16",
    "modules": "phase-17",
    "api": "phase-18",
    "privacy": "phase-30"
  },
  "examples": {
