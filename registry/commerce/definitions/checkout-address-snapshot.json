{
  "$id": "commerce.checkoutAddressSnapshot",
  "name": "Checkout Address Snapshot",
  "version": "0.12.0",
  "status": "stable",
  "domain": "commerce",
  "category": "cart-checkout",
  "description": "Checkout-time address snapshot.",
  "purpose": "Prevents saved-address edits from silently changing a committed Checkout.",
  "commerceModel": {
    "kind": "snapshot",
    "customerManaged": false,
    "containsPersonalData": true,
    "publicEligible": false,
    "supportsRevision": false,
    "transactional": true,
    "dataSensitivity": "personal"
  },
  "fields": [
    {
      "key": "type",
      "required": true,
      "nullable": false,
      "description": "Address purpose.",
      "primitive": "fields.select",
      "config": {
        "options": [
          "shipping",
          "billing"
        ]
      }
    },
    {
      "key": "address",
      "required": true,
      "nullable": false,
      "description": "Checkout-time address.",
      "schema": "shared.address"
    }
  ],
  "relationships": [
    {
      "type": "composes",
      "target": "shared.address",
      "description": "References shared.address."
    }
  ],
  "validationRules": [],
  "cms": {
    "label": "Checkout Address Snapshot",
    "icon": "fa-cart-shopping",
    "customerVisible": false,
    "adminVisible": true,
    "editorMode": "commerce-schema",
    "defaultPlacement": "commerce",
    "summaryFields": [
      "type",
      "address"
    ],
    "primaryActions": [
      "view"
    ]
  },
  "delivery": {
    "publicAllowed": false,
    "notes": "Private or operational commerce data; not eligible for unauthenticated public delivery."
  },
  "futureBindings": {
    "commerceRules": "phase-12",
    "events": "phase-13",
    "webhooks": "phase-14",
    "permissions": "phase-15",
    "siteManifest": "phase-16",
    "modules": "phase-17",
    "api": "phase-18",
    "privacy": "phase-30"
  },
  "examples": {
    "valid": [],
    "invalid": []
  },
  "notes": []
}
