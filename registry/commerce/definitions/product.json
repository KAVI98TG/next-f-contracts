{
  "$id": "commerce.product",
  "name": "Product",
  "version": "0.12.0",
  "status": "stable",
  "domain": "commerce",
  "category": "catalog",
  "description": "Canonical customer-managed catalog Product.",
  "purpose": "Defines Product content while transaction state remains in Cart, Checkout and Order contracts.",
  "commerceModel": {
    "kind": "entity",
    "customerManaged": true,
    "containsPersonalData": false,
    "publicEligible": true,
    "supportsRevision": true,
    "transactional": false,
    "dataSensitivity": "internal"
  },
  "fields": [
    {
      "key": "identity",
      "required": true,
      "nullable": false,
      "description": "Stable identity.",
      "schema": "core.entityIdentity"
    },
    {
      "key": "scope",
      "required": true,
      "nullable": false,
      "description": "Owning Site.",
      "schema": "core.tenantScope"
    },
    {
      "key": "name",
      "required": true,
      "nullable": false,
      "description": "Product name.",
      "primitive": "fields.text",
      "config": {
        "maxLength": 260
      }
    },
    {
      "key": "slug",
      "required": true,
      "nullable": false,
      "description": "Product URL slug.",
      "primitive": "fields.slug"
    },
    {
      "key": "productType",
      "required": true,
      "nullable": false,
      "description": "Product type.",
      "primitive": "fields.select",
      "config": {
        "options": [
          "physical",
          "digital",
          "service",
          "subscription",
          "booking",
          "gift-card"
        ]
      }
    },
    {
      "key": "shortDescription",
      "required": false,
      "nullable": true,
      "description": "Short merchandising copy.",
      "primitive": "fields.textarea"
    },
    {
      "key": "description",
      "required": false,
      "nullable": true,
      "description": "Structured Product description.",
      "primitive": "fields.richText"
    },
    {
      "key": "vendor",
      "required": false,
      "nullable": true,
      "description": "Optional brand/vendor label.",
      "primitive": "fields.text"
    },
    {
      "key": "options",
      "required": false,
      "nullable": true,
      "description": "Variant-generating options.",
      "itemsSchema": "commerce.productOption"
    },
    {
      "key": "attributes",
      "required": false,
      "nullable": true,
      "description": "Product attributes.",
      "itemsSchema": "commerce.productAttributeValue"
    },
    {
      "key": "basePrice",
      "required": false,
      "nullable": true,
      "description": "Base price.",
      "schema": "commerce.productPrice"
    },
    {
      "key": "categoryIds",
      "required": false,
      "nullable": true,
      "description": "Assigned category IDs.",
      "itemsPrimitive": "fields.text",
      "config": {
        "uniqueItems": true
      }
    },
    {
      "key": "collectionIds",
      "required": false,
      "nullable": true,
      "description": "Assigned manual collection IDs.",
      "itemsPrimitive": "fields.text",
      "config": {
        "uniqueItems": true
      }
    },
    {
      "key": "mediaIds",
      "required": false,
      "nullable": true,
      "description": "Product media asset IDs.",
      "itemsPrimitive": "fields.text",
      "config": {
        "uniqueItems": true
      }
    },
    {
      "key": "status",
      "required": true,
      "nullable": false,
      "description": "Product lifecycle.",
      "primitive": "fields.select",
      "config": {
        "options": [
          "draft",
          "active",
          "archived"
        ]
      }
    },
    {
      "key": "publishing",
      "required": true,
      "nullable": false,
      "description": "Publishing state.",
      "schema": "core.publishing"
    },
    {
      "key": "revision",
      "required": false,
      "nullable": true,
      "description": "Revision pointers.",
      "schema": "core.revisionPointer"
    },
    {
      "key": "taxClassKey",
      "required": false,
      "nullable": true,
      "description": "Assigned tax-class key when applicable.",
      "itemsPrimitive": "fields.slug"
    }
  ],
  "relationships": [
    {
      "type": "optionallyComposesMany",
      "target": "commerce.productOption",
      "description": "References commerce.productOption."
    },
    {
      "type": "optionallyComposesMany",
      "target": "commerce.productAttributeValue",
      "description": "References commerce.productAttributeValue."
    },
    {
      "type": "optionallyComposes",
      "target": "commerce.productPrice",
      "description": "References commerce.productPrice."
    },
    {
      "type": "optionallyReferences",
      "target": "commerce.productCategory",
      "description": "References commerce.productCategory."
    },
    {
      "type": "optionallyReferences",
      "target": "commerce.productCollection",
      "description": "References commerce.productCollection."
    },
    {
      "type": "relatedTo",
      "target": "seo.metadata",
      "description": "References seo.metadata."
    },
    {
      "type": "optionallyReferences",
      "target": "commerce.taxClass",
      "description": "References commerce.taxClass."
    }
  ],
  "validationRules": [
    {
      "id": "slugUnique",
      "description": "Published Product slug is unique within Site/locale."
    },
    {
      "id": "catalogPriceMutable",
      "description": "Catalog price changes never rewrite historical Orders."
    },
    {
      "id": "specializedTypesGated",
      "description": "Subscription, booking and other specialized types require explicit implemented capability contracts."
    }
  ],
  "cms": {
    "label": "Product",
    "icon": "fa-cart-shopping",
    "customerVisible": true,
    "adminVisible": true,
    "editorMode": "commerce-schema",
    "defaultPlacement": "commerce",
    "summaryFields": [
      "name",
      "productType",
      "status",
      "basePrice"
    ],
    "primaryActions": [
      "view",
      "create",
      "edit",
      "publish"
    ]
  },
  "delivery": {
    "publicAllowed": true,
    "notes": "Only explicitly public storefront fields may be delivered; operational, personal, payment and internal metadata remain private."
  },
  "futureBindings": {
    "commerceRules": "phase-12",
    "events": "phase-13",
    "webhooks": "phase-14",
    "permissions": "phase-15",
    "siteManifest": "phase-16",
    "modules": "phase-17",
    "api": "phase-18",
    "privacy": "phase-30"
  },
  "examples": {
    "valid": [],
    "invalid": []
  },
  "notes": []
}
