{
  "$id": "commerce.productAvailability",
  "name": "Product Availability",
  "version": "0.12.0",
  "status": "stable",
  "domain": "commerce",
  "category": "catalog",
  "description": "Derived storefront availability.",
  "purpose": "Lets storefronts display availability without exposing operational inventory details.",
  "commerceModel": {
    "kind": "derived",
    "customerManaged": false,
    "containsPersonalData": false,
    "publicEligible": true,
    "supportsRevision": false,
    "transactional": false,
    "dataSensitivity": "internal"
  },
  "fields": [
    {
      "key": "status",
      "required": true,
      "nullable": false,
      "description": "Normalized storefront availability.",
      "primitive": "fields.select",
      "config": {
        "options": [
          "available",
          "limited",
          "out-of-stock",
          "backorder",
          "preorder",
          "unavailable",
          "discontinued"
        ]
      }
    },
    {
      "key": "availableQuantity",
      "required": false,
      "nullable": true,
      "description": "Optional public-safe quantity.",
      "primitive": "fields.decimal",
      "config": {
        "minimum": 0
      }
    },
    {
      "key": "availableFrom",
      "required": false,
      "nullable": true,
      "description": "Optional future availability.",
      "primitive": "fields.dateTime"
    }
  ],
  "relationships": [],
  "validationRules": [
    {
      "id": "derivedNotAuthority",
      "description": "Availability does not replace Inventory Level."
    }
  ],
  "cms": {
    "label": "Product Availability",
    "icon": "fa-cart-shopping",
    "customerVisible": false,
    "adminVisible": true,
    "editorMode": "commerce-schema",
    "defaultPlacement": "commerce",
    "summaryFields": [
      "status",
      "availableQuantity",
      "availableFrom"
    ],
    "primaryActions": [
      "view"
    ]
  },
  "delivery": {
    "publicAllowed": true,
    "notes": "Only explicitly public storefront fields may be delivered; operational, personal, payment and internal metadata remain private."
  },
  "futureBindings": {
    "commerceRules": "phase-12",
    "events": "phase-13",
    "webhooks": "phase-14",
    "permissions": "phase-15",
    "siteManifest": "phase-16",
    "modules": "phase-17",
    "api": "phase-18",
    "privacy": "phase-30"
  },
  "examples": {
    "valid": [],
    "invalid": []
  },
  "notes": []
}
