{
  "$id": "commerce.inventoryTransferLine",
  "name": "Inventory Transfer Line",
  "version": "0.12.0",
  "status": "stable",
  "domain": "commerce",
  "category": "inventory",
  "description": "Line in an inventory transfer.",
  "purpose": "Preserves quantity movement between inventory locations.",
