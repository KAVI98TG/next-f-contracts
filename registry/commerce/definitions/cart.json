{
  "$id": "commerce.cart",
  "name": "Cart",
  "version": "0.12.0",
  "status": "stable",
  "domain": "commerce",
  "category": "cart-checkout",
  "description": "Pre-checkout basket.",
  "purpose": "Provides stable Cart state without treating it as a completed financial transaction.",
  "commerceModel": {
    "kind": "entity",
    "customerManaged": false,
    "containsPersonalData": true,
    "publicEligible": false,
    "supportsRevision": false,
    "transactional": true,
    "dataSensitivity": "personal"
  },
  "fields": [
    {
      "key": "identity",
      "required": true,
      "nullable": false,
      "description": "Stable identity.",
      "schema": "core.entityIdentity"
    },
    {
      "key": "scope",
      "required": true,
      "nullable": false,
      "description": "Owning Site.",
      "schema": "core.tenantScope"
    },
    {
      "key": "salesChannelId",
      "required": true,
      "nullable": false,
      "description": "Sales Channel ID.",
      "primitive": "fields.text"
    },
    {
      "key": "customerId",
      "required": false,
      "nullable": true,
      "description": "Optional Commerce Customer ID.",
      "primitive": "fields.text"
    },
    {
      "key": "sessionKey",
      "required": false,
      "nullable": true,
      "description": "Optional opaque anonymous session key.",
      "primitive": "fields.text"
    },
    {
      "key": "currency",
      "required": true,
      "nullable": false,
      "description": "Cart currency.",
      "primitive": "fields.text",
      "config": {
        "pattern": "^[A-Z]{3}$"
      }
    },
    {
      "key": "lines",
      "required": false,
      "nullable": true,
      "description": "Cart lines.",
      "itemsSchema": "commerce.cartLine"
    },
    {
      "key": "totals",
      "required": true,
      "nullable": false,
      "description": "Calculated totals.",
      "schema": "commerce.cartTotals"
    },
    {
      "key": "status",
      "required": true,
      "nullable": false,
      "description": "Cart lifecycle.",
      "primitive": "fields.select",
      "config": {
        "options": [
          "active",
          "converted",
          "abandoned",
          "expired"
        ]
      }
    },
    {
      "key": "expiresAt",
      "required": false,
      "nullable": true,
      "description": "Optional expiry.",
      "primitive": "fields.dateTime"
    },
    {
      "key": "updatedAt",
      "required": true,
      "nullable": false,
      "description": "Last update.",
      "primitive": "fields.dateTime"
    }
  ],
  "relationships": [
    {
      "type": "references",
      "target": "commerce.salesChannel",
      "description": "References commerce.salesChannel."
    },
    {
      "type": "optionallyReferences",
      "target": "commerce.commerceCustomer",
      "description": "References commerce.commerceCustomer."
    },
    {
      "type": "composesMany",
      "target": "commerce.cartLine",
      "description": "References commerce.cartLine."
    },
    {
      "type": "composes",
      "target": "commerce.cartTotals",
      "description": "References commerce.cartTotals."
    }
  ],
  "validationRules": [
    {
      "id": "customerOrSession",
      "description": "A Cart identifies a customer or opaque session context."
    },
    {
      "id": "convertedStable",
      "description": "Converted transaction snapshots are not silently mutated."
    }
  ],
  "cms": {
    "label": "Cart",
    "icon": "fa-cart-shopping",
    "customerVisible": false,
    "adminVisible": true,
    "editorMode": "commerce-schema",
    "defaultPlacement": "commerce",
    "summaryFields": [
      "identity",
      "scope",
      "salesChannelId",
      "customerId"
    ],
    "primaryActions": [
      "view"
    ]
  },
  "delivery": {
    "publicAllowed": false,
    "notes": "Private or operational commerce data; not eligible for unauthenticated public delivery."
  },
  "futureBindings": {
    "commerceRules": "phase-12",
    "events": "phase-13",
    "webhooks": "phase-14",
    "permissions": "phase-15",
    "siteManifest": "phase-16",
    "modules": "phase-17",
    "api": "phase-18",
    "privacy": "phase-30"
  },
  "examples": {
    "valid": [],
    "invalid": []
  },
  "notes": []
}
