      "key": "type",
      "required": true,
      "nullable": false,
      "description": "Condition type.",
      "primitive": "fields.select",
      "config": {
        "options": [
          "minimum-subtotal",
          "minimum-quantity",
          "product-in",
          "category-in",
          "collection-in",
          "customer-segment",
          "first-order",
          "sales-channel",
          "date-window"
        ]
      }
    },
    {
      "key": "operator",
      "required": true,
      "nullable": false,
      "description": "Comparison operator.",
      "primitive": "fields.select",
      "config": {
        "options": [
          "equals",
          "greater-than-or-equal",
          "less-than-or-equal",
          "contains-any",
          "contains-all",
          "in"
        ]
      }
    },
    {
      "key": "value",
      "required": true,
      "nullable": false,
      "description": "Condition value.",
      "primitive": "fields.json"
    }
  ],
  "relationships": [],
