{
  "$id": "commerce.promotionCondition",
  "name": "Promotion Condition",
  "version": "0.12.0",
  "status": "stable",
  "domain": "commerce",
  "category": "promotions",
  "description": "Structured Promotion eligibility condition.",
  "purpose": "Supports merchant promotions without arbitrary executable expressions.",
  "commerceModel": {
    "kind": "embedded",
    "customerManaged": true,
