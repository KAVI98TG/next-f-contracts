    {
      "key": "available",
      "required": true,
      "nullable": false,
      "description": "Derived sellable quantity.",
      "primitive": "fields.decimal",
      "config": {
        "minimum": 0
      }
    },
    {
      "key": "updatedAt",
      "required": true,
      "nullable": false,
      "description": "Last update.",
      "primitive": "fields.dateTime"
    }
