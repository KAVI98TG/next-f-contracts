{
  "$id": "commerce.inventoryLevel",
  "name": "Inventory Level",
  "version": "0.12.0",
  "status": "stable",
  "domain": "commerce",
  "category": "inventory",
  "description": "Authoritative per-location stock quantities.",
  "purpose": "Provides quantities from which availability is derived.",
  "commerceModel": {
    "kind": "entity",
    "customerManaged": true,
