{
  "$id": "commerce.salesChannel",
  "name": "Sales Channel",
  "version": "0.12.0",
  "status": "stable",
  "domain": "commerce",
  "category": "foundation",
  "description": "Origin channel for commerce activity.",
  "purpose": "Lets orders and catalog publication use a provider-neutral channel identity.",
  "commerceModel": {
    "kind": "configuration",
    "customerManaged": true,
    "containsPersonalData": false,
    "publicEligible": false,
    "supportsRevision": false,
    "transactional": false,
    "dataSensitivity": "internal"
  },
  "fields": [
    {
      "key": "identity",
      "required": true,
      "nullable": false,
      "description": "Stable identity.",
      "schema": "core.entityIdentity"
    },
    {
      "key": "scope",
      "required": true,
      "nullable": false,
      "description": "Owning Site.",
      "schema": "core.tenantScope"
    },
    {
      "key": "key",
      "required": true,
      "nullable": false,
      "description": "Stable channel key.",
      "primitive": "fields.slug"
    },
    {
      "key": "name",
      "required": true,
      "nullable": false,
      "description": "Channel display name.",
      "primitive": "fields.text"
    },
    {
      "key": "type",
      "required": true,
      "nullable": false,
      "description": "Channel type.",
      "primitive": "fields.select",
      "config": {
        "options": [
          "web",
          "pos",
          "marketplace",
          "social",
          "manual",
          "api"
        ]
      }
    },
    {
      "key": "enabled",
      "required": true,
      "nullable": false,
      "description": "Whether this channel may transact.",
      "primitive": "fields.boolean"
    }
  ],
  "relationships": [],
  "validationRules": [
    {
      "id": "channelKeyUnique",
      "description": "Channel key is unique within a Site."
    }
  ],
  "cms": {
    "label": "Sales Channel",
    "icon": "fa-cart-shopping",
    "customerVisible": true,
    "adminVisible": true,
    "editorMode": "commerce-schema",
    "defaultPlacement": "commerce",
    "summaryFields": [
      "identity",
      "scope",
      "key",
      "name"
    ],
    "primaryActions": [
      "view",
      "edit"
    ]
  },
  "delivery": {
    "publicAllowed": false,
    "notes": "Private or operational commerce data; not eligible for unauthenticated public delivery."
  },
  "futureBindings": {
    "commerceRules": "phase-12",
    "events": "phase-13",
    "webhooks": "phase-14",
    "permissions": "phase-15",
    "siteManifest": "phase-16",
    "modules": "phase-17",
    "api": "phase-18",
    "privacy": "phase-30"
  },
  "examples": {
    "valid": [],
    "invalid": []
  },
  "notes": []
}
