{
  "$id": "commerce.paymentCapture",
  "name": "Payment Capture",
  "version": "0.12.0",
  "status": "stable",
  "domain": "commerce",
  "category": "payments",
  "description": "Provider-neutral payment capture record.",
  "purpose": "Records actual capture separately from authorization and later refunds.",
  "commerceModel": {
    "kind": "transaction",
    "customerManaged": true,
    "containsPersonalData": false,
    "publicEligible": false,
    "supportsRevision": false,
    "transactional": true,
    "dataSensitivity": "internal"
  },
  "fields": [
    {
      "key": "captureId",
      "required": true,
      "nullable": false,
      "description": "Stable capture record ID.",
      "primitive": "fields.text"
    },
    {
      "key": "paymentId",
      "required": true,
      "nullable": false,
      "description": "Owning Payment ID.",
      "primitive": "fields.text"
    },
    {
      "key": "authorizationId",
      "required": false,
      "nullable": true,
      "description": "Related authorization when applicable.",
      "itemsPrimitive": "fields.text"
    },
    {
      "key": "providerReference",
      "required": true,
      "nullable": false,
      "description": "Opaque provider capture reference.",
      "primitive": "fields.text"
    },
    {
      "key": "amount",
      "required": true,
      "nullable": false,
      "description": "Captured amount.",
      "schema": "commerce.moneySnapshot"
    },
    {
      "key": "status",
      "required": true,
      "nullable": false,
      "description": "Capture state.",
      "primitive": "fields.select",
      "config": {
        "options": [
          "pending",
          "succeeded",
          "failed",
          "reversed"
        ]
      }
    },
    {
      "key": "capturedAt",
      "required": false,
      "nullable": true,
      "description": "Capture completion time.",
      "itemsPrimitive": "fields.dateTime"
    },
    {
      "key": "failureCode",
      "required": false,
      "nullable": true,
      "description": "Non-secret normalized failure code.",
      "itemsPrimitive": "fields.text"
    }
  ],
  "relationships": [
    {
      "type": "references",
      "target": "commerce.payment",
      "description": "References commerce.payment."
    },
    {
      "type": "optionallyReferences",
      "target": "commerce.paymentAuthorization",
      "description": "References commerce.paymentAuthorization."
    },
    {
      "type": "composes",
      "target": "commerce.moneySnapshot",
      "description": "References commerce.moneySnapshot."
    }
  ],
  "validationRules": [
    {
      "id": "captureBound",
      "description": "Aggregate successful captures cannot silently exceed the Payment's authorized/permitted amount."
    },
    {
      "id": "immutableSuccess",
      "description": "Successful capture facts are append-only; reversals/refunds require separate records."
    }
  ],
  "cms": {
    "label": "Payment Capture",
    "icon": "fa-cart-shopping",
    "customerVisible": true,
    "adminVisible": true,
    "editorMode": "commerce-schema",
    "defaultPlacement": "commerce",
    "summaryFields": [
      "captureId",
      "paymentId",
      "authorizationId",
      "providerReference"
    ],
    "primaryActions": [
      "view",
      "edit"
    ]
  },
  "delivery": {
    "publicAllowed": false,
    "notes": "Private or operational commerce data; not eligible for unauthenticated public delivery."
  },
  "futureBindings": {
    "commerceRules": "phase-12",
    "events": "phase-13",
    "webhooks": "phase-14",
    "permissions": "phase-15",
    "siteManifest": "phase-16",
    "modules": "phase-17",
    "api": "phase-18",
    "privacy": "phase-30"
  },
  "examples": {
    "valid": [],
    "invalid": []
  },
  "notes": []
}
