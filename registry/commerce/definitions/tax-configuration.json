{
  "$id": "commerce.taxConfiguration",
  "name": "Tax Configuration",
  "version": "0.12.0",
  "status": "stable",
  "domain": "commerce",
  "category": "tax",
  "description": "Site-level tax configuration.",
  "purpose": "Separates merchant configuration from calculated Tax Lines and provider integrations.",
  "commerceModel": {
    "kind": "configuration",
    "customerManaged": true,
    "containsPersonalData": false,
    "publicEligible": false,
    "supportsRevision": false,
    "transactional": false,
    "dataSensitivity": "internal"
  },
  "fields": [
    {
      "key": "scope",
      "required": true,
      "nullable": false,
      "description": "Owning Site.",
      "schema": "core.tenantScope"
    },
    {
      "key": "enabled",
      "required": true,
      "nullable": false,
      "description": "Whether tax calculation is enabled.",
      "primitive": "fields.boolean"
    },
    {
      "key": "pricesIncludeTax",
      "required": true,
      "nullable": false,
      "description": "Whether catalog prices include tax by default.",
      "primitive": "fields.boolean"
    },
    {
      "key": "taxShipping",
      "required": true,
      "nullable": false,
      "description": "Whether shipping may be taxable.",
      "primitive": "fields.boolean"
    },
    {
      "key": "roundingMode",
      "required": true,
      "nullable": false,
      "description": "Rounding strategy.",
      "primitive": "fields.select",
      "config": {
        "options": [
          "per-line",
          "per-order"
        ]
      }
    },
    {
      "key": "calculationProvider",
      "required": true,
      "nullable": false,
      "description": "Calculation source.",
      "primitive": "fields.select",
      "config": {
        "options": [
          "internal-simple",
          "external-provider"
        ]
      }
    }
  ],
  "relationships": [],
  "validationRules": [
    {
      "id": "merchantResponsibility",
      "description": "NEXT F configuration does not determine merchant tax obligations."
    },
    {
      "id": "externalNeedsIntegration",
      "description": "External calculation requires a supported Integration adapter."
    }
  ],
  "cms": {
    "label": "Tax Configuration",
    "icon": "fa-cart-shopping",
    "customerVisible": true,
    "adminVisible": true,
    "editorMode": "commerce-schema",
    "defaultPlacement": "commerce",
    "summaryFields": [
      "scope",
      "enabled",
      "pricesIncludeTax",
      "taxShipping"
    ],
    "primaryActions": [
      "view",
      "edit"
    ]
  },
  "delivery": {
    "publicAllowed": false,
    "notes": "Private or operational commerce data; not eligible for unauthenticated public delivery."
  },
  "futureBindings": {
    "commerceRules": "phase-12",
    "events": "phase-13",
    "webhooks": "phase-14",
    "permissions": "phase-15",
    "siteManifest": "phase-16",
    "modules": "phase-17",
    "api": "phase-18",
    "privacy": "phase-30"
  },
  "examples": {
    "valid": [],
    "invalid": []
  },
  "notes": []
}
