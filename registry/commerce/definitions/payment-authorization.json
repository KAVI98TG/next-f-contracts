{
  "$id": "commerce.paymentAuthorization",
  "name": "Payment Authorization",
  "version": "0.12.0",
  "status": "stable",
  "domain": "commerce",
  "category": "payments",
  "description": "Provider-neutral payment authorization record.",
  "purpose": "Separates authorization from capture so payment state is not reduced to a single ambiguous flag.",
  "commerceModel": {
    "kind": "transaction",
    "customerManaged": true,
    "containsPersonalData": false,
    "publicEligible": false,
    "supportsRevision": false,
    "transactional": true,
    "dataSensitivity": "internal"
  },
  "fields": [
    {
      "key": "authorizationId",
      "required": true,
      "nullable": false,
      "description": "Stable authorization record ID.",
      "primitive": "fields.text"
    },
    {
      "key": "paymentId",
      "required": true,
      "nullable": false,
      "description": "Owning Payment ID.",
      "primitive": "fields.text"
    },
    {
      "key": "providerReference",
      "required": true,
      "nullable": false,
      "description": "Opaque provider authorization reference.",
      "primitive": "fields.text"
    },
    {
      "key": "amount",
      "required": true,
      "nullable": false,
      "description": "Authorized amount.",
      "schema": "commerce.moneySnapshot"
    },
    {
      "key": "status",
      "required": true,
      "nullable": false,
      "description": "Authorization state.",
      "primitive": "fields.select",
      "config": {
        "options": [
          "pending",
          "authorized",
          "declined",
          "expired",
          "voided"
        ]
      }
    },
    {
      "key": "authorizedAt",
      "required": false,
      "nullable": true,
      "description": "Authorization time.",
      "itemsPrimitive": "fields.dateTime"
    },
    {
      "key": "expiresAt",
      "required": false,
      "nullable": true,
      "description": "Provider authorization expiry when known.",
      "itemsPrimitive": "fields.dateTime"
    },
    {
      "key": "failureCode",
      "required": false,
      "nullable": true,
      "description": "Non-secret normalized failure code.",
      "itemsPrimitive": "fields.text"
    }
  ],
  "relationships": [
    {
      "type": "references",
      "target": "commerce.payment",
      "description": "References commerce.payment."
    },
    {
      "type": "composes",
      "target": "commerce.moneySnapshot",
      "description": "References commerce.moneySnapshot."
    }
  ],
  "validationRules": [
    {
      "id": "opaqueProviderReference",
      "description": "Provider references must not contain raw card credentials."
    },
    {
      "id": "amountBound",
      "description": "Authorization amount must be consistent with the owning Payment's permitted amount."
    }
  ],
  "cms": {
    "label": "Payment Authorization",
    "icon": "fa-cart-shopping",
    "customerVisible": true,
    "adminVisible": true,
    "editorMode": "commerce-schema",
    "defaultPlacement": "commerce",
    "summaryFields": [
      "authorizationId",
      "paymentId",
      "providerReference",
      "amount"
    ],
    "primaryActions": [
      "view",
      "edit"
    ]
  },
  "delivery": {
    "publicAllowed": false,
    "notes": "Private or operational commerce data; not eligible for unauthenticated public delivery."
  },
  "futureBindings": {
    "commerceRules": "phase-12",
    "events": "phase-13",
    "webhooks": "phase-14",
    "permissions": "phase-15",
    "siteManifest": "phase-16",
    "modules": "phase-17",
    "api": "phase-18",
    "privacy": "phase-30"
  },
  "examples": {
    "valid": [],
    "invalid": []
  },
  "notes": []
}
