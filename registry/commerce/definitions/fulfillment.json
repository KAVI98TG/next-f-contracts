{
  "$id": "commerce.fulfillment",
  "name": "Fulfillment",
  "version": "0.12.0",
  "status": "stable",
  "domain": "commerce",
  "category": "fulfillment",
  "description": "Order-line fulfillment allocation.",
  "purpose": "Keeps fulfillment execution separate from Payment state and physical Shipment tracking.",
  "commerceModel": {
    "kind": "entity",
    "customerManaged": true,
    "containsPersonalData": false,
    "publicEligible": false,
    "supportsRevision": false,
    "transactional": true,
    "dataSensitivity": "internal"
  },
  "fields": [
    {
      "key": "identity",
      "required": true,
      "nullable": false,
      "description": "Stable identity.",
      "schema": "core.entityIdentity"
    },
    {
      "key": "scope",
      "required": true,
      "nullable": false,
      "description": "Owning Site.",
      "schema": "core.tenantScope"
    },
    {
      "key": "orderId",
      "required": true,
      "nullable": false,
      "description": "Order ID.",
      "primitive": "fields.text"
    },
    {
      "key": "locationId",
      "required": false,
      "nullable": true,
      "description": "Optional fulfillment/inventory location.",
      "primitive": "fields.text"
    },
    {
      "key": "lines",
      "required": true,
      "nullable": false,
      "description": "Fulfilled lines.",
      "itemsSchema": "commerce.fulfillmentLine",
      "config": {
        "minItems": 1
      }
    },
    {
      "key": "status",
      "required": true,
      "nullable": false,
      "description": "Fulfillment state.",
      "primitive": "fields.select",
      "config": {
        "options": [
          "pending",
          "processing",
          "partially-fulfilled",
          "fulfilled",
          "cancelled",
          "returned"
        ]
      }
    },
    {
      "key": "createdAt",
      "required": true,
      "nullable": false,
      "description": "Creation time.",
      "primitive": "fields.dateTime"
    },
    {
      "key": "completedAt",
      "required": false,
      "nullable": true,
      "description": "Completion time.",
      "primitive": "fields.dateTime"
    }
  ],
  "relationships": [
    {
      "type": "belongsTo",
      "target": "commerce.order",
      "description": "References commerce.order."
    },
    {
      "type": "optionallyReferences",
      "target": "commerce.inventoryLocation",
      "description": "References commerce.inventoryLocation."
    },
    {
      "type": "composesMany",
      "target": "commerce.fulfillmentLine",
      "description": "References commerce.fulfillmentLine."
    }
  ],
  "validationRules": [
    {
      "id": "noOverFulfillment",
      "description": "Cumulative fulfillment cannot exceed eligible Order Line quantity without correction workflow."
    },
    {
      "id": "paymentIndependent",
      "description": "Fulfillment state is separate from Payment state."
    }
  ],
  "cms": {
    "label": "Fulfillment",
    "icon": "fa-cart-shopping",
    "customerVisible": true,
    "adminVisible": true,
    "editorMode": "commerce-schema",
    "defaultPlacement": "commerce",
    "summaryFields": [
      "identity",
      "scope",
      "orderId",
      "locationId"
    ],
    "primaryActions": [
      "view",
      "manage"
    ]
  },
  "delivery": {
    "publicAllowed": false,
    "notes": "Private or operational commerce data; not eligible for unauthenticated public delivery."
  },
  "futureBindings": {
    "commerceRules": "phase-12",
    "events": "phase-13",
    "webhooks": "phase-14",
    "permissions": "phase-15",
    "siteManifest": "phase-16",
    "modules": "phase-17",
    "api": "phase-18",
    "privacy": "phase-30"
  },
  "examples": {
    "valid": [],
    "invalid": []
  },
  "notes": []
}
