{
  "$id": "api.public-content",
  "apiId": "api.public-content",
  "name": "Public Content API",
  "version": "1.0.0",
  "status": "stable",
  "basePath": "/api/v1/public/sites/{siteId}",
  "description": "Read-only delivery of published public content. Drafts, secrets, Admin metadata and private records are excluded.",
  "defaultAuthMode": "anonymous",
  "defaultRateLimitClass": "public-read",
  "defaultCachePolicy": "public-edge",
  "defaultCorsPolicy": "public-read",
  "moduleBindings": [
    "core",
    "media",
    "pages",
    "blog",
    "documentation",
    "seo"
  ],
  "operationIds": [
    "api.public-content.get-site",
    "api.public-content.list-pages",
    "api.public-content.get-page",
    "api.public-content.get-reusable-content",
    "api.public-content.list-blog-posts",
    "api.public-content.get-blog-post",
    "api.public-content.list-documentation",
    "api.public-content.get-documentation",
    "api.public-content.list-services",
    "api.public-content.get-service",
    "api.public-content.list-custom-entries",
    "api.public-content.get-custom-entry",
    "api.public-content.get-navigation",
    "api.public-content.get-seo",
    "api.public-content.get-sitemap-data",
    "api.public-content.get-robots-policy",
    "api.public-content.health"
  ],
  "publicDocumentation": true,
  "order": 10,
  "compatibility": {
    "contractVersionRange": ">=0.19.0 <1.0.0",
    "manifestBindingRequired": true
  },
  "boundaries": [
    "Uses canonical NEXT F Contract Registry schemas rather than redefining domain entities.",
    "Secrets and privileged credentials are never returned through generic API responses.",
    "API Version and NEXT F Contract Version are independently explicit."
  ]
}
