{
  "$id": "api.uploadSession",
  "name": "Upload Session",
  "version": "1.0.0",
  "status": "stable",
  "domain": "api",
  "category": "files",
  "description": "Short-lived server-authorized upload session.",
  "apiModel": {
    "kind": "support-schema",
    "publicSurface": false
  },
  "fields": [
