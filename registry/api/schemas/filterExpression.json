{
  "$id": "api.filterExpression",
  "name": "Filter Expression",
  "version": "1.0.0",
  "status": "stable",
  "domain": "api",
  "category": "query",
  "description": "Allow-listed structured filter expression.",
  "apiModel": {
    "kind": "support-schema",
    "publicSurface": false
  },
  "fields": [
    {
      "key": "field",
      "required": true,
      "nullable": false,
      "description": "field",
      "primitive": "fields.text"
    },
    {
      "key": "operator",
      "required": true,
      "nullable": false,
      "description": "operator",
      "primitive": "fields.select"
    },
    {
      "key": "value",
      "required": true,
      "nullable": false,
      "description": "value",
      "primitive": "fields.json"
    }
  ],
  "validationRules": [
    {
      "id": "noSecrets",
      "description": "The schema must not expose credentials, signing secrets, private tokens or payment card data."
    },
    {
      "id": "contractVersionAware",
      "description": "Values must be interpreted against the operation's pinned API and NEXT F Contract Versions."
    },
    {
      "id": "allowListOnly",
      "description": "Only operation-declared filter fields/operators are accepted. Raw query/SQL expressions are prohibited."
    }
  ],
  "cms": {
    "customerVisible": false,
    "adminVisible": true,
    "developerVisible": true
  },
  "delivery": {
    "publicAllowed": false,
    "notes": "Individual operations decide whether a safe projection may appear in public responses."
  },
  "notes": []
}
