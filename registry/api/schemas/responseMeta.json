{
  "$id": "api.responseMeta",
  "name": "Response Meta",
  "version": "1.0.0",
  "status": "stable",
  "domain": "api",
  "category": "envelopes",
  "description": "Non-business metadata returned with successful responses.",
  "apiModel": {
    "kind": "support-schema",
    "publicSurface": false
  },
  "fields": [
    {
      "key": "requestId",
      "required": true,
      "nullable": false,
      "description": "requestId",
      "primitive": "fields.text"
    },
    {
      "key": "apiVersion",
      "required": true,
      "nullable": false,
      "description": "apiVersion",
      "primitive": "fields.text"
    },
    {
      "key": "contractVersion",
      "required": true,
      "nullable": false,
      "description": "contractVersion",
      "primitive": "fields.text"
    },
    {
      "key": "generatedAt",
      "required": true,
      "nullable": false,
      "description": "generatedAt",
      "primitive": "fields.dateTime"
    },
    {
      "key": "warnings",
      "required": false,
      "nullable": false,
      "description": "warnings",
      "primitive": "fields.tag"
    }
  ],
  "validationRules": [
    {
      "id": "noSecrets",
      "description": "The schema must not expose credentials, signing secrets, private tokens or payment card data."
    },
    {
      "id": "contractVersionAware",
      "description": "Values must be interpreted against the operation's pinned API and NEXT F Contract Versions."
    }
  ],
  "cms": {
    "customerVisible": false,
    "adminVisible": true,
    "developerVisible": true
  },
  "delivery": {
    "publicAllowed": false,
    "notes": "Individual operations decide whether a safe projection may appear in public responses."
  },
  "notes": []
}
