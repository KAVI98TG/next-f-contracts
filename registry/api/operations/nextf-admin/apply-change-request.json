{
  "$id": "api.nextf-admin.apply-change-request",
  "operationId": "api.nextf-admin.apply-change-request",
  "name": "Apply Change Request",
  "version": "1.1.0",
  "status": "stable",
  "groupId": "api.nextf-admin",
  "method": "POST",
  "path": "/change-requests/{requestId}/apply",
  "description": "Canonical apply change request operation for the Customer Change Request workflow.",
  "authentication": {
    "mode": "nextf-admin",
    "permissions": [
      "core.changerequests.manage"
    ],
    "permissionMode": "all",
    "scope": "site"
  },
  "request": {
    "pathParameters": [
      "siteId",
      "requestId"
    ],
    "query": [],
    "headers": [
      "X-Request-Id?",
      "X-NEXTF-Contract-Version?",
      "If-Match?"
    ],
    "bodyContract": "customerAccess.changeRequest",
    "bodyProjection": "operation-writable-fields-only"
  },
  "response": {
    "successStatus": 200,
    "envelope": "api.successEnvelope",
    "dataContract": "customerAccess.changeRequest",
    "errorEnvelope": "api.errorEnvelope",
    "errors": [
      "bad_request",
      "contract_version_unsupported",
      "precondition_failed",
      "unauthenticated",
      "forbidden",
      "tenant_scope_mismatch",
      "not_found",
      "conflict"
    ],
    "projection": "admin-authorized"
  },
  "policies": {
    "idempotency": {
      "required": true,
      "header": "Idempotency-Key"
    },
    "concurrency": {
      "required": true,
      "requestHeader": "If-Match",
      "responseHeader": "ETag"
    },
    "cache": "no-store",
    "rateLimit": "sensitive-write",
    "cors": "admin-portal"
  },
  "moduleBindings": [
    "core"
  ],
  "contractBindings": [
    "customerAccess.changeRequest"
  ],
  "eventBindings": [
    "customer-change-request.applied"
  ],
  "publicSurface": false,
  "privacy": "private",
  "notes": [
    "The current authoritative revision must match baseRevisionId before application."
  ]
}
