{
  "$id": "api.nextf-admin.update-contract-binding",
  "operationId": "api.nextf-admin.update-contract-binding",
  "name": "Update Site Contract Binding",
  "version": "1.0.0",
  "status": "stable",
  "groupId": "api.nextf-admin",
  "method": "PUT",
  "path": "/sites/{siteId}/contract-binding",
  "description": "Update Site Contract Binding",
  "authentication": {
    "mode": "nextf-admin",
    "permissions": [
      "platform.contracts.manage"
    ],
    "permissionMode": "all",
    "scope": "site"
  },
  "request": {
    "pathParameters": [
      "siteId"
    ],
    "query": [],
    "headers": [
      "X-Request-Id?",
      "X-NEXTF-Contract-Version?",
      "If-Match"
    ],
    "bodyContract": "manifest.contractBinding",
    "bodyProjection": "operation-writable-fields-only"
  },
  "response": {
    "successStatus": 200,
    "envelope": "api.successEnvelope",
    "dataContract": "manifest.contractBinding",
    "errorEnvelope": "api.errorEnvelope",
    "errors": [
      "bad_request",
      "api_version_unsupported",
      "contract_version_unsupported",
      "unauthenticated",
      "forbidden",
      "tenant_scope_mismatch",
      "module_disabled",
      "not_found"
    ],
    "projection": "admin-authorized"
  },
  "policies": {
    "idempotency": {
      "required": false,
      "header": null
    },
    "concurrency": {
      "required": true,
      "requestHeader": "If-Match",
      "responseHeader": "ETag"
    },
    "cache": "no-store",
    "rateLimit": "sensitive-write",
    "cors": "admin-portal"
  },
  "moduleBindings": [
    "core",
    "integrations"
  ],
  "contractBindings": [
    "manifest.contractBinding"
  ],
  "eventBindings": [],
  "publicSurface": false,
  "privacy": "internal",
  "notes": []
}
