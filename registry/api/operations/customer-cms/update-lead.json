{
  "$id": "api.customer-cms.update-lead",
  "operationId": "api.customer-cms.update-lead",
  "name": "Update Lead",
  "version": "1.0.0",
  "status": "stable",
  "groupId": "api.customer-cms",
  "method": "PATCH",
  "path": "/leads/{leadId}",
  "description": "Update Lead",
  "authentication": {
    "mode": "organization-user",
    "permissions": [
      "forms.leads.edit"
    ],
    "permissionMode": "all",
    "scope": "site"
  },
  "request": {
    "pathParameters": [
      "siteId",
      "leadId"
    ],
    "query": [],
    "headers": [
      "X-Request-Id?",
      "X-NEXTF-Contract-Version?",
      "If-Match"
    ],
    "bodyContract": "forms.lead",
    "bodyProjection": "operation-writable-fields-only"
  },
  "response": {
    "successStatus": 200,
    "envelope": "api.successEnvelope",
    "dataContract": "forms.lead",
    "errorEnvelope": "api.errorEnvelope",
    "errors": [
      "bad_request",
      "api_version_unsupported",
      "contract_version_unsupported",
      "unauthenticated",
      "forbidden",
      "tenant_scope_mismatch",
      "module_disabled",
      "not_found"
    ],
    "projection": "authorized-minimal"
  },
  "policies": {
    "idempotency": {
      "required": false,
      "header": null
    },
    "concurrency": {
      "required": true,
      "requestHeader": "If-Match",
      "responseHeader": "ETag"
    },
    "cache": "no-store",
    "rateLimit": "authenticated-write",
    "cors": "customer-portal"
  },
  "moduleBindings": [
    "core",
    "media",
    "pages",
    "blog",
    "documentation",
    "seo",
    "forms",
    "leads"
  ],
  "contractBindings": [
    "forms.lead"
  ],
  "eventBindings": [
    "lead.updated"
  ],
  "publicSurface": false,
  "privacy": "personal",
  "notes": []
}
