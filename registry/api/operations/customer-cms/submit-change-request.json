{
  "$id": "api.customer-cms.submit-change-request",
  "operationId": "api.customer-cms.submit-change-request",
  "name": "Submit Change Request",
  "version": "1.1.0",
  "status": "stable",
  "groupId": "api.customer-cms",
  "method": "POST",
  "path": "/change-requests",
  "description": "Canonical submit change request operation for the Customer Change Request workflow.",
  "authentication": {
    "mode": "organization-user",
    "permissions": [
      "core.changerequests.create"
    ],
    "permissionMode": "all",
    "scope": "site"
  },
  "request": {
    "pathParameters": [
      "siteId"
    ],
    "query": [],
    "headers": [
      "X-Request-Id?",
      "X-NEXTF-Contract-Version?",
      "If-Match?"
    ],
    "bodyContract": "customerAccess.changeRequest",
    "bodyProjection": "operation-writable-fields-only"
  },
  "response": {
    "successStatus": 202,
    "envelope": "api.successEnvelope",
    "dataContract": "customerAccess.changeRequest",
    "errorEnvelope": "api.errorEnvelope",
    "errors": [
      "bad_request",
      "contract_version_unsupported",
      "precondition_failed",
      "unauthenticated",
      "forbidden",
      "tenant_scope_mismatch",
      "not_found",
      "conflict"
    ],
    "projection": "workspace-authorized"
  },
  "policies": {
    "idempotency": {
      "required": true,
      "header": "Idempotency-Key"
    },
    "concurrency": {
      "required": false,
      "requestHeader": "If-Match",
      "responseHeader": "ETag"
    },
    "cache": "no-store",
    "rateLimit": "authenticated-write",
    "cors": "customer-portal"
  },
  "moduleBindings": [
    "core"
  ],
  "contractBindings": [
    "customerAccess.changeRequest"
  ],
  "eventBindings": [
    "customer-change-request.submitted"
  ],
  "publicSurface": false,
  "privacy": "private",
  "notes": []
}
