{
  "$id": "api.events.ingest-tracking",
  "operationId": "api.events.ingest-tracking",
  "name": "Ingest Sanitized Tracking Observation",
  "version": "1.0.0",
  "status": "stable",
  "groupId": "api.events",
  "method": "POST",
  "path": "/tracking",
  "description": "Accept a sanitized Phase 9 tracking observation. This endpoint cannot create authoritative Phase 13 domain Events.",
  "authentication": {
    "mode": "site-server",
    "permissions": [],
    "permissionMode": "all",
    "scope": "site"
  },
  "request": {
    "pathParameters": [
      "siteId"
    ],
    "query": [],
    "headers": [
      "X-Request-Id?",
      "X-NEXTF-Contract-Version?",
      "Idempotency-Key"
    ],
    "bodyContract": null,
    "bodyProjection": null
  },
  "response": {
    "successStatus": 200,
    "envelope": "api.successEnvelope",
    "dataContract": "api.commandResult",
    "errorEnvelope": "api.errorEnvelope",
    "errors": [
      "bad_request",
      "api_version_unsupported",
      "contract_version_unsupported",
      "event_not_exposable",
      "unauthenticated",
      "forbidden",
      "tenant_scope_mismatch",
