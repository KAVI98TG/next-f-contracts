{
  "$id": "api.gaming-admin.order-action",
  "operationId": "api.gaming-admin.order-action",
  "name": "Run Gaming Order Action",
  "version": "1.0.0",
  "status": "stable",
  "groupId": "api.gaming-admin",
  "method": "POST",
  "path": "/orders/{orderId}/actions",
  "description": "Run Gaming Order Action",
  "authentication": {
    "mode": "organization-user",
    "permissions": [
      "gaming.orders.manage"
    ],
    "permissionMode": "all",
    "scope": "site"
  },
  "request": {
    "pathParameters": [
      "siteId",
      "orderId"
    ],
    "query": [],
    "headers": [
      "X-Request-Id?",
      "X-NEXTF-Contract-Version?",
      "Idempotency-Key"
    ],
    "bodyContract": "gaming.internalOrder",
    "bodyProjection": null
  },
  "response": {
    "successStatus": 200,
    "envelope": "api.successEnvelope",
    "dataContract": "api.commandResult",
    "errorEnvelope": "api.errorEnvelope",
    "errors": [
      "bad_request",
      "validation_failed",
      "api_version_unsupported",
      "contract_version_unsupported",
      "unauthenticated",
      "forbidden",
      "tenant_scope_mismatch",
      "module_disabled",
      "capability_disabled",
      "not_found"
    ],
    "projection": "authorized-minimal"
  },
  "policies": {
    "idempotency": {
      "required": true,
      "header": "Idempotency-Key"
    },
    "concurrency": {
      "required": false,
      "requestHeader": null,
      "responseHeader": null
    },
    "cache": "no-store",
    "rateLimit": "authenticated-read",
    "cors": "customer-portal"
  },
  "moduleBindings": [
    "core",
    "commerce",
    "integrations",
    "gaming"
  ],
  "contractBindings": [
    "api.commandResult"
  ],
  "eventBindings": [
    "gaming.fulfillment-submitted"
  ],
  "publicSurface": false,
  "privacy": "sensitive",
  "notes": []
}
