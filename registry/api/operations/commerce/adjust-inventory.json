{
  "$id": "api.commerce.adjust-inventory",
  "operationId": "api.commerce.adjust-inventory",
  "name": "Adjust Inventory",
  "version": "1.0.0",
  "status": "stable",
  "groupId": "api.commerce",
  "method": "POST",
  "path": "/management/inventory/adjustments",
  "description": "Adjust Inventory",
  "authentication": {
    "mode": "organization-user",
    "permissions": [
      "commerce.inventory.manage"
    ],
    "permissionMode": "all",
    "scope": "site"
  },
  "request": {
    "pathParameters": [
      "siteId"
    ],
    "query": [],
    "headers": [
      "X-Request-Id?",
      "X-NEXTF-Contract-Version?",
      "Idempotency-Key"
    ],
    "bodyContract": null,
    "bodyProjection": null
  },
  "response": {
    "successStatus": 200,
    "envelope": "api.successEnvelope",
    "dataContract": "commerce.inventoryAdjustment",
    "errorEnvelope": "api.errorEnvelope",
    "errors": [
      "bad_request",
      "api_version_unsupported",
      "contract_version_unsupported",
      "inventory_conflict",
      "unauthenticated",
      "forbidden",
      "tenant_scope_mismatch",
      "module_disabled"
    ],
    "projection": "workspace-authorized"
  },
  "policies": {
    "idempotency": {
      "required": true,
      "header": "Idempotency-Key"
    },
    "concurrency": {
      "required": false,
      "requestHeader": null,
      "responseHeader": null
    },
    "cache": "no-store",
    "rateLimit": "commerce-checkout",
    "cors": "site-origin"
  },
  "moduleBindings": [
    "core",
    "media",
    "commerce"
  ],
  "contractBindings": [
    "commerce.inventoryAdjustment"
  ],
  "eventBindings": [
    "inventory.adjusted"
  ],
  "publicSurface": false,
  "privacy": "internal",
  "notes": []
}
