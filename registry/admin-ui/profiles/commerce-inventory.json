{
  "$id": "adminUi.profile.commerce.inventory",
  "name": "Inventory Admin",
  "version": "1.1.0",
  "status": "stable",
  "domain": "admin-ui",
  "type": "admin-ui-profile",
  "profileType": "resource",
  "resource": "commerce.inventory",
  "permissionDomain": "commerce",
  "moduleId": "commerce",
  "description": "Internal NEXT F Admin metadata for Inventory. Applies only within server-authorized administrative scope.",
  "route": "/sites/:siteId/commerce/inventory",
  "screenKind": "admin-operations",
  "layoutTemplate": "inherited-resource",
  "internalOnly": true,
  "customerVisible": false,
  "context": {
    "kind": "site",
    "requiresOrganization": false,
    "requiresSite": true,
    "allowsCrossTenant": false,
    "directUrlScopeGuard": "server-required"
  },
  "baseCustomerProfileId": "cmsUi.profile.commerce.inventory",
  "inheritanceMode": "reference-not-copy",
  "targetContracts": [
    "commerce.inventoryLevel",
    "commerce.inventoryItem",
    "commerce.inventoryLocation",
    "commerce.inventoryAdjustment"
  ],
  "primaryTargetContract": "commerce.inventoryLevel",
  "permissions": [
    "commerce.inventory.edit",
    "commerce.inventory.export",
    "commerce.inventory.manage",
    "commerce.inventory.view"
  ],
  "actions": [
    {
      "actionId": "edit",
      "permissionId": "commerce.inventory.edit",
      "riskLevel": "elevated",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    },
    {
      "actionId": "export",
      "permissionId": "commerce.inventory.export",
      "riskLevel": "standard",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    },
    {
      "actionId": "manage",
      "permissionId": "commerce.inventory.manage",
      "riskLevel": "elevated",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    },
    {
      "actionId": "view",
      "permissionId": "commerce.inventory.view",
      "riskLevel": "standard",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    }
  ],
  "panels": [
    "scope-context",
    "audit",
    "permissions",
    "customer-ui-reference",
    "commerce-invariants",
    "inventory-integrity",
    "data-governance"
  ],
  "controls": [
    "risk-badge"
  ],
  "security": {
    "serverAuthorizationRequired": true,
    "directUrlReauthorization": true,
    "secretValuesNeverRendered": true,
    "crossTenantRequiresPlatformScope": true,
    "customerIdentityImpersonation": false,
    "adminCanBypassCanonicalBusinessRules": false
  },
  "audit": {
    "requiredForMutations": true,
    "requestIdVisibleWhenAvailable": true,
    "redactSecrets": true
  },
  "dataPolicy": {
    "internalOnlyMetadata": true,
    "customerHidden": true,
    "minimumNecessaryDisplay": true
  },
  "notes": [
    "Reuses the matching Customer CMS profile as a presentation reference; Admin-only context and controls remain separate.",
    "Administrative permission never bypasses Phase 12 Commerce Rules or transaction invariants."
  ],
  "customerAccessPolicyRef": "customerAccess.policy.commerce.inventory",
  "customerBoundary": {
    "policyVersion": "1.1.0",
    "mode": "direct_edit",
    "publishingMode": "not_applicable",
    "approvalRequired": false,
    "capabilityRefs": [
      "commerce.inventory",
      "commerce.multi-location-inventory"
    ],
    "editableFields": [
      "inventoryItemId",
      "locationId",
      "onHand",
      "reserved",
      "incoming",
      "available"
    ],
    "readOnlyFields": [],
    "hiddenFields": [
      "identity",
      "scope",
      "updatedAt"
    ],
    "restrictiveWorkspaceOverridesAllowed": true,
    "customerAccessMayBeBroadened": false
  }
}
