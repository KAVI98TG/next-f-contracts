{
  "$id": "adminUi.profile.content.testimonials",
  "name": "Testimonials Admin",
  "version": "1.1.0",
  "status": "stable",
  "domain": "admin-ui",
  "type": "admin-ui-profile",
  "profileType": "resource",
  "resource": "content.testimonials",
  "permissionDomain": "content",
  "moduleId": "pages",
  "description": "Internal NEXT F Admin metadata for Testimonials. Applies only within server-authorized administrative scope.",
  "route": "/sites/:siteId/content/testimonials",
  "screenKind": "admin-editor",
  "layoutTemplate": "inherited-resource",
  "internalOnly": true,
  "customerVisible": false,
  "context": {
    "kind": "site",
    "requiresOrganization": false,
    "requiresSite": true,
    "allowsCrossTenant": false,
    "directUrlScopeGuard": "server-required"
  },
  "baseCustomerProfileId": "cmsUi.profile.content.testimonials",
  "inheritanceMode": "reference-not-copy",
  "targetContracts": [
    "content.testimonial"
  ],
  "primaryTargetContract": "content.testimonial",
  "permissions": [
    "content.testimonials.approve",
    "content.testimonials.create",
    "content.testimonials.delete",
    "content.testimonials.edit",
    "content.testimonials.publish",
    "content.testimonials.view"
  ],
  "actions": [
    {
      "actionId": "approve",
      "permissionId": "content.testimonials.approve",
      "riskLevel": "elevated",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    },
    {
      "actionId": "create",
      "permissionId": "content.testimonials.create",
      "riskLevel": "elevated",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    },
    {
      "actionId": "delete",
      "permissionId": "content.testimonials.delete",
      "riskLevel": "destructive",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": true,
      "scopeKind": "site"
    },
    {
      "actionId": "edit",
      "permissionId": "content.testimonials.edit",
      "riskLevel": "elevated",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    },
    {
      "actionId": "publish",
      "permissionId": "content.testimonials.publish",
      "riskLevel": "elevated",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    },
    {
      "actionId": "view",
      "permissionId": "content.testimonials.view",
      "riskLevel": "standard",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    }
  ],
  "panels": [
    "scope-context",
    "audit",
    "permissions",
    "customer-ui-reference",
    "publishing"
  ],
  "controls": [
    "risk-badge",
    "explicit-confirmation"
  ],
  "security": {
    "serverAuthorizationRequired": true,
    "directUrlReauthorization": true,
    "secretValuesNeverRendered": true,
    "crossTenantRequiresPlatformScope": true,
    "customerIdentityImpersonation": false,
    "adminCanBypassCanonicalBusinessRules": false
  },
  "audit": {
    "requiredForMutations": true,
    "requestIdVisibleWhenAvailable": true,
    "redactSecrets": true
  },
  "dataPolicy": {
    "internalOnlyMetadata": true,
    "customerHidden": true,
    "minimumNecessaryDisplay": true
  },
  "notes": [
    "Reuses the matching Customer CMS profile as a presentation reference; Admin-only context and controls remain separate."
  ],
  "customerAccessPolicyRef": "customerAccess.policy.content.testimonials",
  "customerBoundary": {
    "policyVersion": "1.1.0",
    "mode": "direct_edit",
    "publishingMode": "direct",
    "approvalRequired": false,
    "capabilityRefs": [
      "pages.sections"
    ],
    "editableFields": [
      "quote",
      "personName",
      "position",
      "company",
      "photo",
      "rating",
      "relatedService",
      "sourceUrl",
      "isFeatured",
      "publishing"
    ],
    "readOnlyFields": [],
    "hiddenFields": [
      "identity",
      "scope",
      "revision"
    ],
    "restrictiveWorkspaceOverridesAllowed": true,
    "customerAccessMayBeBroadened": false
  }
}
