    "mode": "direct_edit",
    "publishingMode": "not_applicable",
    "approvalRequired": false,
    "capabilityRefs": [
      "marketing.conversions"
    ],
    "editableFields": [
      "conversionKey",
      "name",
      "category",
      "triggerEventKey",
      "primary",
      "value",
      "requiredConsentCategoryKey",
      "enabled"
