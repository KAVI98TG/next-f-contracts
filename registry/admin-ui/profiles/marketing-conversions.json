{
  "$id": "adminUi.profile.marketing.conversions",
  "name": "Conversions Admin",
  "version": "1.1.0",
  "status": "stable",
  "domain": "admin-ui",
  "type": "admin-ui-profile",
  "profileType": "resource",
  "resource": "marketing.conversions",
  "permissionDomain": "marketing",
