{
  "$id": "adminUi.profile.forms.notifications",
  "name": "Notifications Admin",
  "version": "1.1.0",
  "status": "stable",
  "domain": "admin-ui",
  "type": "admin-ui-profile",
  "profileType": "resource",
  "resource": "forms.notifications",
  "permissionDomain": "forms",
  "moduleId": "forms",
  "description": "Internal NEXT F Admin metadata for Notifications. Applies only within server-authorized administrative scope.",
  "route": "/sites/:siteId/forms/notifications",
  "screenKind": "admin-editor",
  "layoutTemplate": "inherited-resource",
  "internalOnly": true,
  "customerVisible": false,
  "context": {
    "kind": "site",
    "requiresOrganization": false,
    "requiresSite": true,
    "allowsCrossTenant": false,
    "directUrlScopeGuard": "server-required"
  },
  "baseCustomerProfileId": "cmsUi.profile.forms.notifications",
  "inheritanceMode": "reference-not-copy",
  "targetContracts": [
    "forms.notificationRule",
    "forms.autoResponse"
  ],
  "primaryTargetContract": "forms.notificationRule",
  "permissions": [
    "forms.notifications.edit",
    "forms.notifications.manage",
    "forms.notifications.view"
  ],
  "actions": [
    {
      "actionId": "edit",
      "permissionId": "forms.notifications.edit",
      "riskLevel": "elevated",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    },
    {
      "actionId": "manage",
      "permissionId": "forms.notifications.manage",
      "riskLevel": "elevated",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    },
    {
      "actionId": "view",
      "permissionId": "forms.notifications.view",
      "riskLevel": "standard",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    }
  ],
  "panels": [
    "scope-context",
    "audit",
    "permissions",
    "customer-ui-reference",
    "form-privacy",
    "data-governance"
  ],
  "controls": [
    "risk-badge"
  ],
  "security": {
    "serverAuthorizationRequired": true,
    "directUrlReauthorization": true,
    "secretValuesNeverRendered": true,
    "crossTenantRequiresPlatformScope": true,
    "customerIdentityImpersonation": false,
    "adminCanBypassCanonicalBusinessRules": false
  },
  "audit": {
    "requiredForMutations": true,
    "requestIdVisibleWhenAvailable": true,
    "redactSecrets": true
  },
  "dataPolicy": {
    "internalOnlyMetadata": true,
    "customerHidden": true,
    "minimumNecessaryDisplay": true
  },
  "notes": [
    "Reuses the matching Customer CMS profile as a presentation reference; Admin-only context and controls remain separate."
  ],
  "customerAccessPolicyRef": "customerAccess.policy.forms.notifications",
  "customerBoundary": {
    "policyVersion": "1.1.0",
    "mode": "direct_edit",
    "publishingMode": "not_applicable",
    "approvalRequired": false,
    "capabilityRefs": [
      "forms.auto-response",
      "forms.notifications"
    ],
    "editableFields": [
      "formId",
      "enabled",
      "outcome",
      "recipients",
      "subjectTemplate",
      "bodyTemplate",
      "includeFieldKeys",
      "includeSensitiveFields"
    ],
    "readOnlyFields": [],
    "hiddenFields": [
      "id"
    ],
    "restrictiveWorkspaceOverridesAllowed": true,
    "customerAccessMayBeBroadened": false
  }
}
