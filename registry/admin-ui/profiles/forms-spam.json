{
  "$id": "adminUi.profile.forms.spam",
  "name": "Spam Admin",
  "version": "1.1.0",
  "status": "stable",
  "domain": "admin-ui",
  "type": "admin-ui-profile",
  "profileType": "resource",
  "resource": "forms.spam",
  "permissionDomain": "forms",
  "moduleId": "forms",
  "description": "Internal NEXT F Admin metadata for Spam. Applies only within server-authorized administrative scope.",
  "route": "/sites/:siteId/forms/spam",
  "screenKind": "admin-operations",
  "layoutTemplate": "inherited-resource",
  "internalOnly": true,
  "customerVisible": false,
  "context": {
    "kind": "site",
    "requiresOrganization": false,
    "requiresSite": true,
    "allowsCrossTenant": false,
    "directUrlScopeGuard": "server-required"
  },
  "baseCustomerProfileId": "cmsUi.profile.forms.spam",
  "inheritanceMode": "reference-not-copy",
  "targetContracts": [
    "forms.spamDecision",
    "forms.spamPolicy"
  ],
  "primaryTargetContract": "forms.spamDecision",
  "permissions": [
    "forms.spam.manage",
    "forms.spam.view"
  ],
  "actions": [
    {
      "actionId": "manage",
      "permissionId": "forms.spam.manage",
      "riskLevel": "elevated",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    },
    {
      "actionId": "view",
      "permissionId": "forms.spam.view",
      "riskLevel": "standard",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    }
  ],
  "panels": [
    "scope-context",
    "audit",
    "permissions",
    "customer-ui-reference",
    "form-privacy",
    "data-governance"
  ],
  "controls": [
    "risk-badge"
  ],
  "security": {
    "serverAuthorizationRequired": true,
    "directUrlReauthorization": true,
    "secretValuesNeverRendered": true,
    "crossTenantRequiresPlatformScope": true,
    "customerIdentityImpersonation": false,
    "adminCanBypassCanonicalBusinessRules": false
  },
  "audit": {
    "requiredForMutations": true,
    "requestIdVisibleWhenAvailable": true,
    "redactSecrets": true
  },
  "dataPolicy": {
    "internalOnlyMetadata": true,
    "customerHidden": true,
    "minimumNecessaryDisplay": true
  },
  "notes": [
    "Reuses the matching Customer CMS profile as a presentation reference; Admin-only context and controls remain separate."
  ],
  "customerAccessPolicyRef": "customerAccess.policy.forms.spam",
  "customerBoundary": {
    "policyVersion": "1.1.0",
    "mode": "direct_edit",
    "publishingMode": "not_applicable",
    "approvalRequired": false,
    "capabilityRefs": [
      "forms.spam-protection"
    ],
    "editableFields": [
      "classification",
      "score",
      "signals",
      "decidedAt",
      "decisionMethod",
      "reviewed"
    ],
    "readOnlyFields": [],
    "hiddenFields": [],
    "restrictiveWorkspaceOverridesAllowed": true,
    "customerAccessMayBeBroadened": false
  }
}
