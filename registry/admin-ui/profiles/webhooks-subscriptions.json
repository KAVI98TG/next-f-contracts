{
  "$id": "adminUi.profile.webhooks.subscriptions",
  "name": "Subscriptions Admin",
  "version": "0.21.0",
  "status": "stable",
  "domain": "admin-ui",
  "type": "admin-ui-profile",
  "profileType": "resource",
  "resource": "webhooks.subscriptions",
  "permissionDomain": "webhooks",
  "moduleId": "integrations",
  "description": "Internal NEXT F Admin metadata for Subscriptions. Applies only within server-authorized administrative scope.",
