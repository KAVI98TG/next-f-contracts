{
  "$id": "adminUi.profile.platform.sites",
  "name": "Sites Admin",
  "version": "0.21.0",
  "status": "stable",
  "domain": "admin-ui",
  "type": "admin-ui-profile",
  "profileType": "resource",
  "resource": "platform.sites",
  "permissionDomain": "platform",
  "moduleId": "core",
  "description": "Internal NEXT F Admin metadata for Sites. Applies only within server-authorized administrative scope.",
  "route": "/sites",
  "screenKind": "site-360",
  "layoutTemplate": "site-360",
  "internalOnly": true,
  "customerVisible": false,
  "context": {
    "kind": "platform",
    "requiresOrganization": false,
    "requiresSite": false,
    "allowsCrossTenant": true,
    "directUrlScopeGuard": "server-required"
  },
  "baseCustomerProfileId": null,
  "inheritanceMode": "none",
  "targetContracts": [
    "core.site"
  ],
  "primaryTargetContract": "core.site",
  "permissions": [
    "platform.sites.create",
    "platform.sites.delete",
    "platform.sites.edit",
    "platform.sites.export",
    "platform.sites.manage",
    "platform.sites.view"
  ],
  "actions": [
    {
      "actionId": "create",
      "permissionId": "platform.sites.create",
      "riskLevel": "elevated",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false,
      "scopeKind": "platform"
    },
    {
      "actionId": "delete",
      "permissionId": "platform.sites.delete",
      "riskLevel": "privileged",
      "requiresRecentAuthentication": true,
      "requiresExplicitConfirmation": false,
      "scopeKind": "platform"
    },
    {
      "actionId": "edit",
      "permissionId": "platform.sites.edit",
      "riskLevel": "elevated",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false,
      "scopeKind": "platform"
    },
    {
      "actionId": "export",
      "permissionId": "platform.sites.export",
      "riskLevel": "standard",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false,
      "scopeKind": "platform"
    },
    {
      "actionId": "manage",
      "permissionId": "platform.sites.manage",
      "riskLevel": "privileged",
      "requiresRecentAuthentication": true,
      "requiresExplicitConfirmation": false,
      "scopeKind": "platform"
    },
    {
      "actionId": "view",
      "permissionId": "platform.sites.view",
      "riskLevel": "standard",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false,
      "scopeKind": "platform"
    }
  ],
  "panels": [
    "scope-context",
    "audit",
    "permissions",
    "contract-compatibility",
    "site-runtime",
    "module-capabilities",
    "technical-connection",
    "api-health",
    "integration-health",
    "event-health",
    "webhook-health",
    "diagnostics"
  ],
  "controls": [
    "risk-badge",
    "recent-auth-gate",
    "explicit-confirmation"
  ],
  "security": {
    "serverAuthorizationRequired": true,
    "directUrlReauthorization": true,
    "secretValuesNeverRendered": true,
    "crossTenantRequiresPlatformScope": true,
    "customerIdentityImpersonation": false,
    "adminCanBypassCanonicalBusinessRules": false
  },
  "audit": {
    "requiredForMutations": true,
    "requestIdVisibleWhenAvailable": true,
    "redactSecrets": true
  },
  "dataPolicy": {
    "internalOnlyMetadata": true,
    "customerHidden": true,
    "minimumNecessaryDisplay": true
  },
  "notes": [
    "Site 360 is hosting-provider-neutral. It may show website URL and technical connection health but not domain registration, hosting sales, renewals or billing.",
    "Module/capability changes must validate the Site Manifest and Module Registry dependencies."
  ]
}
