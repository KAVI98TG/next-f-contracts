{
  "$id": "adminUi.profile.permissions.roles",
  "name": "Roles Admin",
  "version": "1.1.0",
  "status": "stable",
  "domain": "admin-ui",
  "type": "admin-ui-profile",
  "profileType": "resource",
  "resource": "permissions.roles",
  "permissionDomain": "permissions",
  "moduleId": "core",
  "description": "Internal NEXT F Admin metadata for Roles. Applies only within server-authorized administrative scope.",
  "route": "/sites/:siteId/access/roles",
  "screenKind": "admin-operations",
  "layoutTemplate": "access-manager",
  "internalOnly": true,
  "customerVisible": false,
  "context": {
    "kind": "organization",
    "requiresOrganization": true,
    "requiresSite": false,
    "allowsCrossTenant": false,
    "directUrlScopeGuard": "server-required"
  },
  "baseCustomerProfileId": "cmsUi.profile.permissions.roles",
  "inheritanceMode": "reference-not-copy",
  "targetContracts": [
    "permissions.roleDefinition"
  ],
  "primaryTargetContract": "permissions.roleDefinition",
  "permissions": [
    "permissions.roles.create",
    "permissions.roles.delete",
    "permissions.roles.edit",
    "permissions.roles.manage",
    "permissions.roles.view"
  ],
  "actions": [
    {
      "actionId": "create",
      "permissionId": "permissions.roles.create",
      "riskLevel": "sensitive",
      "requiresRecentAuthentication": true,
      "requiresExplicitConfirmation": false,
      "scopeKind": "organization"
    },
    {
      "actionId": "delete",
      "permissionId": "permissions.roles.delete",
      "riskLevel": "sensitive",
      "requiresRecentAuthentication": true,
      "requiresExplicitConfirmation": false,
      "scopeKind": "organization"
    },
    {
      "actionId": "edit",
      "permissionId": "permissions.roles.edit",
      "riskLevel": "sensitive",
      "requiresRecentAuthentication": true,
      "requiresExplicitConfirmation": false,
      "scopeKind": "organization"
    },
    {
      "actionId": "manage",
      "permissionId": "permissions.roles.manage",
      "riskLevel": "sensitive",
      "requiresRecentAuthentication": true,
      "requiresExplicitConfirmation": false,
      "scopeKind": "organization"
    },
    {
      "actionId": "view",
      "permissionId": "permissions.roles.view",
      "riskLevel": "standard",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false,
      "scopeKind": "organization"
    }
  ],
  "panels": [
    "scope-context",
    "audit",
    "permissions",
    "customer-ui-reference"
  ],
  "controls": [
    "risk-badge",
    "recent-auth-gate"
  ],
  "security": {
    "serverAuthorizationRequired": true,
    "directUrlReauthorization": true,
    "secretValuesNeverRendered": true,
    "crossTenantRequiresPlatformScope": true,
    "customerIdentityImpersonation": false,
    "adminCanBypassCanonicalBusinessRules": false
  },
  "audit": {
    "requiredForMutations": true,
    "requestIdVisibleWhenAvailable": true,
    "redactSecrets": true
  },
  "dataPolicy": {
    "internalOnlyMetadata": true,
    "customerHidden": true,
    "minimumNecessaryDisplay": true
  },
  "notes": [
    "Reuses the matching Customer CMS profile as a presentation reference; Admin-only context and controls remain separate."
  ],
  "customerAccessPolicyRef": "customerAccess.policy.permissions.roles",
  "customerBoundary": {
    "policyVersion": "1.1.0",
    "mode": "direct_edit",
    "publishingMode": "not_applicable",
    "approvalRequired": false,
    "capabilityRefs": [
      "core.identity"
    ],
    "editableFields": [],
    "readOnlyFields": [
      "roleKey",
      "displayName",
      "roleType",
      "scopeKind",
      "assignableByCustomer",
      "systemProtected"
    ],
    "hiddenFields": [
      "permissionIds"
    ],
    "restrictiveWorkspaceOverridesAllowed": true,
    "customerAccessMayBeBroadened": false
  }
}
