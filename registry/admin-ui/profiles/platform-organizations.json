{
  "$id": "adminUi.profile.platform.organizations",
  "name": "Organizations Admin",
  "version": "0.21.0",
  "status": "stable",
  "domain": "admin-ui",
  "type": "admin-ui-profile",
  "profileType": "resource",
  "resource": "platform.organizations",
  "permissionDomain": "platform",
