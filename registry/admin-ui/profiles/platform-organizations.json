    },
    {
      "actionId": "edit",
      "permissionId": "platform.organizations.edit",
      "riskLevel": "elevated",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false,
      "scopeKind": "platform"
    },
    {
      "actionId": "export",
      "permissionId": "platform.organizations.export",
      "riskLevel": "standard",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false,
      "scopeKind": "platform"
    },
    {
      "actionId": "manage",
      "permissionId": "platform.organizations.manage",
      "riskLevel": "privileged",
      "requiresRecentAuthentication": true,
      "requiresExplicitConfirmation": false,
      "scopeKind": "platform"
    },
    {
      "actionId": "view",
      "permissionId": "platform.organizations.view",
      "riskLevel": "standard",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false,
      "scopeKind": "platform"
    }
