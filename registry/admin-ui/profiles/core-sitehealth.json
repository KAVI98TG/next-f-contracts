{
  "$id": "adminUi.profile.core.sitehealth",
  "name": "Sitehealth Admin",
  "version": "1.1.0",
  "status": "stable",
  "domain": "admin-ui",
  "type": "admin-ui-profile",
  "profileType": "resource",
  "resource": "core.sitehealth",
  "permissionDomain": "core",
  "moduleId": "core",
  "description": "Internal NEXT F Admin metadata for Sitehealth. Applies only within server-authorized administrative scope.",
  "route": "/sites/:siteId/core/sitehealth",
  "screenKind": "admin-report",
  "layoutTemplate": "inherited-resource",
  "internalOnly": true,
  "customerVisible": false,
  "context": {
    "kind": "site",
    "requiresOrganization": false,
    "requiresSite": true,
    "allowsCrossTenant": false,
    "directUrlScopeGuard": "server-required"
  },
  "baseCustomerProfileId": "cmsUi.profile.core.sitehealth",
  "inheritanceMode": "reference-not-copy",
  "targetContracts": [
    "core.site"
  ],
  "primaryTargetContract": "core.site",
  "permissions": [
    "core.sitehealth.view"
  ],
  "actions": [
    {
      "actionId": "view",
      "permissionId": "core.sitehealth.view",
      "riskLevel": "standard",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    }
  ],
  "panels": [
    "scope-context",
    "audit",
    "permissions",
    "customer-ui-reference"
  ],
  "controls": [
    "risk-badge"
  ],
  "security": {
    "serverAuthorizationRequired": true,
    "directUrlReauthorization": true,
    "secretValuesNeverRendered": true,
    "crossTenantRequiresPlatformScope": true,
    "customerIdentityImpersonation": false,
    "adminCanBypassCanonicalBusinessRules": false
  },
  "audit": {
    "requiredForMutations": true,
    "requestIdVisibleWhenAvailable": true,
    "redactSecrets": true
  },
  "dataPolicy": {
    "internalOnlyMetadata": true,
    "customerHidden": true,
    "minimumNecessaryDisplay": true
  },
  "notes": [
    "Reuses the matching Customer CMS profile as a presentation reference; Admin-only context and controls remain separate."
  ],
  "customerAccessPolicyRef": "customerAccess.policy.core.sitehealth",
  "customerBoundary": {
    "policyVersion": "1.1.0",
    "mode": "read_only",
    "publishingMode": "not_applicable",
    "approvalRequired": false,
    "capabilityRefs": [
      "core.identity"
    ],
    "editableFields": [
      "name"
    ],
    "readOnlyFields": [
      "primaryUrl",
      "status"
    ],
    "hiddenFields": [
      "identity",
      "organizationId"
    ],
    "restrictiveWorkspaceOverridesAllowed": true,
    "customerAccessMayBeBroadened": false
  }
}
