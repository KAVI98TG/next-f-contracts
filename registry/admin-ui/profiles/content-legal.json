{
  "$id": "adminUi.profile.content.legal",
  "name": "Legal Admin",
  "version": "1.1.0",
  "status": "stable",
  "domain": "admin-ui",
  "type": "admin-ui-profile",
  "profileType": "resource",
  "resource": "content.legal",
  "permissionDomain": "content",
  "moduleId": "pages",
  "description": "Internal NEXT F Admin metadata for Legal. Applies only within server-authorized administrative scope.",
  "route": "/sites/:siteId/content/legal",
  "screenKind": "admin-editor",
  "layoutTemplate": "inherited-resource",
  "internalOnly": true,
  "customerVisible": false,
  "context": {
    "kind": "site",
    "requiresOrganization": false,
    "requiresSite": true,
    "allowsCrossTenant": false,
    "directUrlScopeGuard": "server-required"
  },
  "baseCustomerProfileId": "cmsUi.profile.content.legal",
  "inheritanceMode": "reference-not-copy",
  "targetContracts": [
    "content.legalPage"
  ],
  "primaryTargetContract": "content.legalPage",
  "permissions": [
    "content.legal.approve",
    "content.legal.edit",
    "content.legal.publish",
    "content.legal.view"
  ],
  "actions": [
    {
      "actionId": "approve",
      "permissionId": "content.legal.approve",
      "riskLevel": "elevated",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    },
    {
      "actionId": "edit",
      "permissionId": "content.legal.edit",
      "riskLevel": "elevated",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    },
    {
      "actionId": "publish",
      "permissionId": "content.legal.publish",
      "riskLevel": "elevated",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    },
    {
      "actionId": "view",
      "permissionId": "content.legal.view",
      "riskLevel": "standard",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    }
  ],
  "panels": [
    "scope-context",
    "audit",
    "permissions",
    "customer-ui-reference",
    "publishing"
  ],
  "controls": [
    "risk-badge"
  ],
  "security": {
    "serverAuthorizationRequired": true,
    "directUrlReauthorization": true,
    "secretValuesNeverRendered": true,
    "crossTenantRequiresPlatformScope": true,
    "customerIdentityImpersonation": false,
    "adminCanBypassCanonicalBusinessRules": false
  },
  "audit": {
    "requiredForMutations": true,
    "requestIdVisibleWhenAvailable": true,
    "redactSecrets": true
  },
  "dataPolicy": {
    "internalOnlyMetadata": true,
    "customerHidden": true,
    "minimumNecessaryDisplay": true
  },
  "notes": [
    "Reuses the matching Customer CMS profile as a presentation reference; Admin-only context and controls remain separate."
  ],
  "customerAccessPolicyRef": "customerAccess.policy.content.legal",
  "customerBoundary": {
    "policyVersion": "1.1.0",
    "mode": "approval_required",
    "publishingMode": "approval_required",
    "approvalRequired": true,
    "capabilityRefs": [
      "pages.legal-pages"
    ],
    "editableFields": [
      "title",
      "slug",
      "legalType",
      "content",
      "effectiveDate",
      "lastReviewedDate",
      "jurisdiction",
      "contact",
      "publishing"
    ],
    "readOnlyFields": [],
    "hiddenFields": [
      "identity",
      "scope",
      "revision"
    ],
    "restrictiveWorkspaceOverridesAllowed": true,
    "customerAccessMayBeBroadened": false
  }
}
