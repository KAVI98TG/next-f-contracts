{
  "$id": "adminUi.profile.permissions.registry",
  "name": "Registry Admin",
  "version": "1.1.0",
  "status": "stable",
  "domain": "admin-ui",
  "type": "admin-ui-profile",
  "profileType": "resource",
  "resource": "permissions.registry",
  "permissionDomain": "permissions",
  "moduleId": "core",
  "description": "Internal NEXT F Admin metadata for Registry. Applies only within server-authorized administrative scope.",
  "route": "/sites/:siteId/access/permissions",
  "screenKind": "admin-operations",
  "layoutTemplate": "access-manager",
  "internalOnly": true,
  "customerVisible": false,
  "context": {
    "kind": "organization",
    "requiresOrganization": true,
    "requiresSite": false,
    "allowsCrossTenant": false,
    "directUrlScopeGuard": "server-required"
  },
  "baseCustomerProfileId": "cmsUi.profile.permissions.registry",
  "inheritanceMode": "reference-not-copy",
  "targetContracts": [
    "permissions.permissionDefinition"
  ],
  "primaryTargetContract": "permissions.permissionDefinition",
  "permissions": [
    "permissions.registry.view"
  ],
  "actions": [
    {
      "actionId": "view",
      "permissionId": "permissions.registry.view",
      "riskLevel": "standard",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false,
      "scopeKind": "organization"
    }
  ],
  "panels": [
    "scope-context",
    "audit",
    "permissions",
    "customer-ui-reference"
  ],
  "controls": [
    "risk-badge"
  ],
  "security": {
    "serverAuthorizationRequired": true,
    "directUrlReauthorization": true,
    "secretValuesNeverRendered": true,
    "crossTenantRequiresPlatformScope": true,
    "customerIdentityImpersonation": false,
    "adminCanBypassCanonicalBusinessRules": false
  },
  "audit": {
    "requiredForMutations": true,
    "requestIdVisibleWhenAvailable": true,
    "redactSecrets": true
  },
  "dataPolicy": {
    "internalOnlyMetadata": true,
    "customerHidden": true,
    "minimumNecessaryDisplay": true
  },
  "notes": [
    "Reuses the matching Customer CMS profile as a presentation reference; Admin-only context and controls remain separate."
  ],
  "customerAccessPolicyRef": "customerAccess.policy.permissions.registry",
  "customerBoundary": {
    "policyVersion": "1.1.0",
    "mode": "read_only",
    "publishingMode": "not_applicable",
    "approvalRequired": false,
    "capabilityRefs": [
      "core.identity"
    ],
    "editableFields": [],
    "readOnlyFields": [
      "domain",
      "resource",
      "action",
      "scopeKind",
      "riskLevel",
      "customerEligible",
      "adminEligible",
      "grantable"
    ],
    "hiddenFields": [
      "permissionId"
    ],
    "restrictiveWorkspaceOverridesAllowed": true,
    "customerAccessMayBeBroadened": false
  }
}
