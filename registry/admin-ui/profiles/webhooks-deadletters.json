{
  "$id": "adminUi.profile.webhooks.deadletters",
  "name": "Deadletters Admin",
  "version": "1.1.0",
  "status": "stable",
  "domain": "admin-ui",
  "type": "admin-ui-profile",
  "profileType": "resource",
  "resource": "webhooks.deadletters",
  "permissionDomain": "webhooks",
  "moduleId": "integrations",
  "description": "Internal NEXT F Admin metadata for Deadletters. Applies only within server-authorized administrative scope.",
  "route": "/sites/:siteId/webhooks/deadletters",
  "screenKind": "admin-operations",
  "layoutTemplate": "delivery-operations",
  "internalOnly": true,
  "customerVisible": false,
  "context": {
    "kind": "site",
    "requiresOrganization": false,
    "requiresSite": true,
    "allowsCrossTenant": false,
    "directUrlScopeGuard": "server-required"
  },
  "baseCustomerProfileId": "cmsUi.profile.webhooks.deadletters",
  "inheritanceMode": "reference-not-copy",
  "targetContracts": [
    "webhooks.deadLetter"
  ],
  "primaryTargetContract": "webhooks.deadLetter",
  "permissions": [
    "webhooks.deadletters.manage",
    "webhooks.deadletters.view"
  ],
  "actions": [
    {
      "actionId": "manage",
      "permissionId": "webhooks.deadletters.manage",
      "riskLevel": "sensitive",
      "requiresRecentAuthentication": true,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    },
    {
      "actionId": "view",
      "permissionId": "webhooks.deadletters.view",
      "riskLevel": "sensitive",
      "requiresRecentAuthentication": true,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    }
  ],
  "panels": [
    "scope-context",
    "audit",
    "permissions",
    "customer-ui-reference",
    "webhook-health",
    "secret-metadata",
    "delivery-integrity"
  ],
  "controls": [
    "risk-badge",
    "recent-auth-gate"
  ],
  "security": {
    "serverAuthorizationRequired": true,
    "directUrlReauthorization": true,
    "secretValuesNeverRendered": true,
    "crossTenantRequiresPlatformScope": true,
    "customerIdentityImpersonation": false,
    "adminCanBypassCanonicalBusinessRules": false
  },
  "audit": {
    "requiredForMutations": true,
    "requestIdVisibleWhenAvailable": true,
    "redactSecrets": true
  },
  "dataPolicy": {
    "internalOnlyMetadata": true,
    "customerHidden": true,
    "minimumNecessaryDisplay": true
  },
  "notes": [
    "Reuses the matching Customer CMS profile as a presentation reference; Admin-only context and controls remain separate.",
    "Credential/secret values remain server-side; Admin displays state, fingerprints/metadata or rotation controls only."
  ],
  "customerAccessPolicyRef": "customerAccess.policy.webhooks.deadletters",
  "customerBoundary": {
    "policyVersion": "1.1.0",
    "mode": "read_only",
    "publishingMode": "not_applicable",
    "approvalRequired": false,
    "capabilityRefs": [
      "integrations.health"
    ],
    "editableFields": [],
    "readOnlyFields": [
      "reasonCode",
      "lastFailure",
      "deadLetteredAt",
      "expiresAt",
      "redeliveryEligibleUntil"
    ],
    "hiddenFields": [
      "deadLetterId",
      "deliveryId"
    ],
    "restrictiveWorkspaceOverridesAllowed": true,
    "customerAccessMayBeBroadened": false
  }
}
