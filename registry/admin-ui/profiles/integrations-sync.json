{
  "$id": "adminUi.profile.integrations.sync",
  "name": "Sync Admin",
  "version": "1.1.0",
  "status": "stable",
  "domain": "admin-ui",
  "type": "admin-ui-profile",
  "profileType": "resource",
  "resource": "integrations.sync",
  "permissionDomain": "integrations",
  "moduleId": "integrations",
  "description": "Internal NEXT F Admin metadata for Sync. Applies only within server-authorized administrative scope.",
  "route": "/sites/:siteId/integrations/sync",
  "screenKind": "admin-operations",
  "layoutTemplate": "integration-operations",
  "internalOnly": true,
  "customerVisible": false,
  "context": {
    "kind": "site",
    "requiresOrganization": false,
    "requiresSite": true,
    "allowsCrossTenant": false,
    "directUrlScopeGuard": "server-required"
  },
  "baseCustomerProfileId": "cmsUi.profile.integrations.sync",
  "inheritanceMode": "reference-not-copy",
  "targetContracts": [
    "integrations.syncRun",
    "integrations.syncResult"
  ],
  "primaryTargetContract": "integrations.syncRun",
  "permissions": [
    "integrations.sync.manage",
    "integrations.sync.view"
  ],
  "actions": [
    {
      "actionId": "manage",
      "permissionId": "integrations.sync.manage",
      "riskLevel": "elevated",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    },
    {
      "actionId": "view",
      "permissionId": "integrations.sync.view",
      "riskLevel": "standard",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    }
  ],
  "panels": [
    "scope-context",
    "audit",
    "permissions",
    "customer-ui-reference",
    "integration-health",
    "secret-metadata"
  ],
  "controls": [
    "risk-badge"
  ],
  "security": {
    "serverAuthorizationRequired": true,
    "directUrlReauthorization": true,
    "secretValuesNeverRendered": true,
    "crossTenantRequiresPlatformScope": true,
    "customerIdentityImpersonation": false,
    "adminCanBypassCanonicalBusinessRules": false
  },
  "audit": {
    "requiredForMutations": true,
    "requestIdVisibleWhenAvailable": true,
    "redactSecrets": true
  },
  "dataPolicy": {
    "internalOnlyMetadata": true,
    "customerHidden": true,
    "minimumNecessaryDisplay": true
  },
  "notes": [
    "Reuses the matching Customer CMS profile as a presentation reference; Admin-only context and controls remain separate.",
    "Credential/secret values remain server-side; Admin displays state, fingerprints/metadata or rotation controls only."
  ],
  "customerAccessPolicyRef": "customerAccess.policy.integrations.sync",
  "customerBoundary": {
    "policyVersion": "1.1.0",
    "mode": "read_only",
    "publishingMode": "not_applicable",
    "approvalRequired": false,
    "capabilityRefs": [
      "integrations.sync"
    ],
    "editableFields": [],
    "readOnlyFields": [
      "connectionRef",
      "startedAt",
      "completedAt",
      "cursorBefore",
      "cursorAfter",
      "result"
    ],
    "hiddenFields": [
      "runId"
    ],
    "restrictiveWorkspaceOverridesAllowed": true,
    "customerAccessMayBeBroadened": false
  }
}
