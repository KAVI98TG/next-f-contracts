{
  "$id": "adminUi.profile.webhooks.secrets",
  "name": "Secrets Admin",
  "version": "0.21.0",
  "status": "stable",
  "domain": "admin-ui",
  "type": "admin-ui-profile",
  "profileType": "resource",
  "resource": "webhooks.secrets",
  "permissionDomain": "webhooks",
  "moduleId": "integrations",
  "description": "Internal NEXT F Admin metadata for Secrets. Applies only within server-authorized administrative scope.",
  "route": "/sites/:siteId/webhooks/secrets",
  "screenKind": "admin-operations",
  "layoutTemplate": "delivery-operations",
  "internalOnly": true,
  "customerVisible": false,
  "context": {
    "kind": "site",
    "requiresOrganization": false,
    "requiresSite": true,
    "allowsCrossTenant": false,
    "directUrlScopeGuard": "server-required"
  },
  "baseCustomerProfileId": "cmsUi.profile.webhooks.secrets",
  "inheritanceMode": "reference-not-copy",
  "targetContracts": [
    "webhooks.signingKeyReference",
    "webhooks.secretRotation"
  ],
  "primaryTargetContract": "webhooks.signingKeyReference",
  "permissions": [
    "webhooks.secrets.manage"
  ],
  "actions": [
    {
      "actionId": "manage",
      "permissionId": "webhooks.secrets.manage",
      "riskLevel": "sensitive",
      "requiresRecentAuthentication": true,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    }
  ],
  "panels": [
    "scope-context",
    "audit",
    "permissions",
    "customer-ui-reference",
    "webhook-health",
    "secret-metadata",
    "delivery-integrity"
  ],
  "controls": [
    "risk-badge",
    "recent-auth-gate"
  ],
  "security": {
    "serverAuthorizationRequired": true,
    "directUrlReauthorization": true,
    "secretValuesNeverRendered": true,
    "crossTenantRequiresPlatformScope": true,
    "customerIdentityImpersonation": false,
    "adminCanBypassCanonicalBusinessRules": false
  },
  "audit": {
    "requiredForMutations": true,
    "requestIdVisibleWhenAvailable": true,
    "redactSecrets": true
  },
  "dataPolicy": {
    "internalOnlyMetadata": true,
    "customerHidden": true,
    "minimumNecessaryDisplay": true
  },
  "notes": [
    "Reuses the matching Customer CMS profile as a presentation reference; Admin-only context and controls remain separate.",
    "Credential/secret values remain server-side; Admin displays state, fingerprints/metadata or rotation controls only."
  ]
}
