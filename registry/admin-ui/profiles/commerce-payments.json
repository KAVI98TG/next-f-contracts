{
  "$id": "adminUi.profile.commerce.payments",
  "name": "Payments Admin",
  "version": "1.1.0",
  "status": "stable",
  "domain": "admin-ui",
  "type": "admin-ui-profile",
  "profileType": "resource",
  "resource": "commerce.payments",
  "permissionDomain": "commerce",
  "moduleId": "commerce",
  "description": "Internal NEXT F Admin metadata for Payments. Applies only within server-authorized administrative scope.",
  "route": "/sites/:siteId/commerce/payments",
  "screenKind": "admin-operations",
  "layoutTemplate": "inherited-resource",
  "internalOnly": true,
  "customerVisible": false,
  "context": {
    "kind": "site",
    "requiresOrganization": false,
    "requiresSite": true,
    "allowsCrossTenant": false,
    "directUrlScopeGuard": "server-required"
  },
  "baseCustomerProfileId": "cmsUi.profile.commerce.payments",
  "inheritanceMode": "reference-not-copy",
  "targetContracts": [
    "commerce.payment",
    "commerce.paymentCapture",
    "commerce.paymentAuthorization"
  ],
  "primaryTargetContract": "commerce.payment",
  "permissions": [
    "commerce.payments.export",
    "commerce.payments.manage",
    "commerce.payments.view"
  ],
  "actions": [
    {
      "actionId": "export",
      "permissionId": "commerce.payments.export",
      "riskLevel": "sensitive",
      "requiresRecentAuthentication": true,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    },
    {
      "actionId": "manage",
      "permissionId": "commerce.payments.manage",
      "riskLevel": "sensitive",
      "requiresRecentAuthentication": true,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    },
    {
      "actionId": "view",
      "permissionId": "commerce.payments.view",
      "riskLevel": "sensitive",
      "requiresRecentAuthentication": true,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    }
  ],
  "panels": [
    "scope-context",
    "audit",
    "permissions",
    "customer-ui-reference",
    "commerce-invariants",
    "financial-integrity",
    "data-governance"
  ],
  "controls": [
    "risk-badge",
    "recent-auth-gate"
  ],
  "security": {
    "serverAuthorizationRequired": true,
    "directUrlReauthorization": true,
    "secretValuesNeverRendered": true,
    "crossTenantRequiresPlatformScope": true,
    "customerIdentityImpersonation": false,
    "adminCanBypassCanonicalBusinessRules": false
  },
  "audit": {
    "requiredForMutations": true,
    "requestIdVisibleWhenAvailable": true,
    "redactSecrets": true
  },
  "dataPolicy": {
    "internalOnlyMetadata": true,
    "customerHidden": true,
    "minimumNecessaryDisplay": true
  },
  "notes": [
    "Reuses the matching Customer CMS profile as a presentation reference; Admin-only context and controls remain separate.",
    "Administrative permission never bypasses Phase 12 Commerce Rules or transaction invariants."
  ],
  "customerAccessPolicyRef": "customerAccess.policy.commerce.payments",
  "customerBoundary": {
    "policyVersion": "1.1.0",
    "mode": "direct_edit",
    "publishingMode": "not_applicable",
    "approvalRequired": false,
    "capabilityRefs": [
      "commerce.payments"
    ],
    "editableFields": [
      "orderId",
      "providerKey",
      "amount",
      "method",
      "status",
      "providerPaymentId",
      "authorizedAt",
      "paidAt",
      "refundedAmount",
      "authorizationIds",
      "captureIds",
      "refundIds"
    ],
    "readOnlyFields": [],
    "hiddenFields": [
      "identity",
      "scope",
      "createdAt",
      "updatedAt"
    ],
    "restrictiveWorkspaceOverridesAllowed": true,
    "customerAccessMayBeBroadened": false
  }
}
