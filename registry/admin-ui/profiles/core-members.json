{
  "$id": "adminUi.profile.core.members",
  "name": "Members Admin",
  "version": "1.1.0",
  "status": "stable",
  "domain": "admin-ui",
  "type": "admin-ui-profile",
  "profileType": "resource",
  "resource": "core.members",
  "permissionDomain": "core",
  "moduleId": "core",
  "description": "Internal NEXT F Admin metadata for Members. Applies only within server-authorized administrative scope.",
  "route": "/sites/:siteId/core/members",
  "screenKind": "admin-settings",
  "layoutTemplate": "inherited-resource",
  "internalOnly": true,
  "customerVisible": false,
  "context": {
    "kind": "organization",
    "requiresOrganization": true,
    "requiresSite": false,
    "allowsCrossTenant": false,
    "directUrlScopeGuard": "server-required"
  },
  "baseCustomerProfileId": "cmsUi.profile.core.members",
  "inheritanceMode": "reference-not-copy",
  "targetContracts": [
    "permissions.roleAssignment",
    "permissions.roleDefinition"
  ],
  "primaryTargetContract": "permissions.roleAssignment",
  "permissions": [
    "core.members.create",
    "core.members.delete",
    "core.members.edit",
    "core.members.manage",
    "core.members.view"
  ],
  "actions": [
    {
      "actionId": "create",
      "permissionId": "core.members.create",
      "riskLevel": "elevated",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false,
      "scopeKind": "organization"
    },
    {
      "actionId": "delete",
      "permissionId": "core.members.delete",
      "riskLevel": "destructive",
      "requiresRecentAuthentication": true,
      "requiresExplicitConfirmation": true,
      "scopeKind": "organization"
    },
    {
      "actionId": "edit",
      "permissionId": "core.members.edit",
      "riskLevel": "elevated",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false,
      "scopeKind": "organization"
    },
    {
      "actionId": "manage",
      "permissionId": "core.members.manage",
      "riskLevel": "sensitive",
      "requiresRecentAuthentication": true,
      "requiresExplicitConfirmation": false,
      "scopeKind": "organization"
    },
    {
      "actionId": "view",
      "permissionId": "core.members.view",
      "riskLevel": "standard",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false,
      "scopeKind": "organization"
    }
  ],
  "panels": [
    "scope-context",
    "audit",
    "permissions",
    "customer-ui-reference"
  ],
  "controls": [
    "risk-badge",
    "recent-auth-gate",
    "explicit-confirmation"
  ],
  "security": {
    "serverAuthorizationRequired": true,
    "directUrlReauthorization": true,
    "secretValuesNeverRendered": true,
    "crossTenantRequiresPlatformScope": true,
    "customerIdentityImpersonation": false,
    "adminCanBypassCanonicalBusinessRules": false
  },
  "audit": {
    "requiredForMutations": true,
    "requestIdVisibleWhenAvailable": true,
    "redactSecrets": true
  },
  "dataPolicy": {
    "internalOnlyMetadata": true,
    "customerHidden": true,
    "minimumNecessaryDisplay": true
  },
  "notes": [
    "Reuses the matching Customer CMS profile as a presentation reference; Admin-only context and controls remain separate."
  ],
  "customerAccessPolicyRef": "customerAccess.policy.core.members",
  "customerBoundary": {
    "policyVersion": "1.1.0",
    "mode": "direct_edit",
    "publishingMode": "not_applicable",
    "approvalRequired": false,
    "capabilityRefs": [
      "core.identity"
    ],
    "editableFields": [],
    "readOnlyFields": [
      "principal",
      "status",
      "startsAt",
      "expiresAt",
      "assignedBy"
    ],
    "hiddenFields": [
      "assignmentId",
      "roleId",
      "scope"
    ],
    "restrictiveWorkspaceOverridesAllowed": true,
    "customerAccessMayBeBroadened": false
  }
}
