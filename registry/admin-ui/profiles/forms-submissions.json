{
  "$id": "adminUi.profile.forms.submissions",
  "name": "Submissions Admin",
  "version": "1.1.0",
  "status": "stable",
  "domain": "admin-ui",
  "type": "admin-ui-profile",
  "profileType": "resource",
  "resource": "forms.submissions",
  "permissionDomain": "forms",
  "moduleId": "forms",
  "description": "Internal NEXT F Admin metadata for Submissions. Applies only within server-authorized administrative scope.",
  "route": "/sites/:siteId/forms/submissions",
  "screenKind": "admin-operations",
  "layoutTemplate": "inherited-resource",
  "internalOnly": true,
  "customerVisible": false,
  "context": {
    "kind": "site",
    "requiresOrganization": false,
    "requiresSite": true,
    "allowsCrossTenant": false,
    "directUrlScopeGuard": "server-required"
  },
  "baseCustomerProfileId": "cmsUi.profile.forms.submissions",
  "inheritanceMode": "reference-not-copy",
  "targetContracts": [
    "forms.submission",
    "forms.submissionValue",
    "forms.submissionFile"
  ],
  "primaryTargetContract": "forms.submission",
  "permissions": [
    "forms.submissions.delete",
    "forms.submissions.export",
    "forms.submissions.manage",
    "forms.submissions.view"
  ],
  "actions": [
    {
      "actionId": "delete",
      "permissionId": "forms.submissions.delete",
      "riskLevel": "destructive",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": true,
      "scopeKind": "site"
    },
    {
      "actionId": "export",
      "permissionId": "forms.submissions.export",
      "riskLevel": "sensitive",
      "requiresRecentAuthentication": true,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    },
    {
      "actionId": "manage",
      "permissionId": "forms.submissions.manage",
      "riskLevel": "sensitive",
      "requiresRecentAuthentication": true,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    },
    {
      "actionId": "view",
      "permissionId": "forms.submissions.view",
      "riskLevel": "sensitive",
      "requiresRecentAuthentication": true,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    }
  ],
  "panels": [
    "scope-context",
    "audit",
    "permissions",
    "customer-ui-reference",
    "form-privacy",
    "data-governance"
  ],
  "controls": [
    "risk-badge",
    "recent-auth-gate",
    "explicit-confirmation"
  ],
  "security": {
    "serverAuthorizationRequired": true,
    "directUrlReauthorization": true,
    "secretValuesNeverRendered": true,
    "crossTenantRequiresPlatformScope": true,
    "customerIdentityImpersonation": false,
    "adminCanBypassCanonicalBusinessRules": false
  },
  "audit": {
    "requiredForMutations": true,
    "requestIdVisibleWhenAvailable": true,
    "redactSecrets": true
  },
  "dataPolicy": {
    "internalOnlyMetadata": true,
    "customerHidden": true,
    "minimumNecessaryDisplay": true
  },
  "notes": [
    "Reuses the matching Customer CMS profile as a presentation reference; Admin-only context and controls remain separate."
  ],
  "customerAccessPolicyRef": "customerAccess.policy.forms.submissions",
  "customerBoundary": {
    "policyVersion": "1.1.0",
    "mode": "direct_edit",
    "publishingMode": "not_applicable",
    "approvalRequired": false,
    "capabilityRefs": [
      "forms.file-uploads"
    ],
    "editableFields": [
      "formId",
      "status",
      "values",
      "files",
      "consents",
      "spamDecision",
      "requestContext",
      "submittedAt",
      "acceptedAt",
      "completedAt",
      "leadId"
    ],
    "readOnlyFields": [
      "idempotencyKey"
    ],
    "hiddenFields": [
      "id",
      "siteId",
      "formVersion"
    ],
    "restrictiveWorkspaceOverridesAllowed": true,
    "customerAccessMayBeBroadened": false
  }
}
