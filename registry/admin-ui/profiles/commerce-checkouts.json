{
  "$id": "adminUi.profile.commerce.checkouts",
  "name": "Checkouts Admin",
  "version": "1.1.0",
  "status": "stable",
  "domain": "admin-ui",
  "type": "admin-ui-profile",
  "profileType": "resource",
  "resource": "commerce.checkouts",
  "permissionDomain": "commerce",
  "moduleId": "commerce",
  "description": "Internal NEXT F Admin metadata for Checkouts. Applies only within server-authorized administrative scope.",
  "route": "/sites/:siteId/commerce/checkouts",
  "screenKind": "admin-operations",
  "layoutTemplate": "inherited-resource",
  "internalOnly": true,
  "customerVisible": false,
  "context": {
    "kind": "site",
    "requiresOrganization": false,
    "requiresSite": true,
    "allowsCrossTenant": false,
    "directUrlScopeGuard": "server-required"
  },
  "baseCustomerProfileId": "cmsUi.profile.commerce.checkouts",
  "inheritanceMode": "reference-not-copy",
  "targetContracts": [
    "commerce.checkout"
  ],
  "primaryTargetContract": "commerce.checkout",
  "permissions": [
    "commerce.checkouts.manage",
    "commerce.checkouts.view"
  ],
  "actions": [
    {
      "actionId": "manage",
      "permissionId": "commerce.checkouts.manage",
      "riskLevel": "sensitive",
      "requiresRecentAuthentication": true,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    },
    {
      "actionId": "view",
      "permissionId": "commerce.checkouts.view",
      "riskLevel": "sensitive",
      "requiresRecentAuthentication": true,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    }
  ],
  "panels": [
    "scope-context",
    "audit",
    "permissions",
    "customer-ui-reference",
    "commerce-invariants",
    "financial-integrity",
    "data-governance"
  ],
  "controls": [
    "risk-badge",
    "recent-auth-gate"
  ],
  "security": {
    "serverAuthorizationRequired": true,
    "directUrlReauthorization": true,
    "secretValuesNeverRendered": true,
    "crossTenantRequiresPlatformScope": true,
    "customerIdentityImpersonation": false,
    "adminCanBypassCanonicalBusinessRules": false
  },
  "audit": {
    "requiredForMutations": true,
    "requestIdVisibleWhenAvailable": true,
    "redactSecrets": true
  },
  "dataPolicy": {
    "internalOnlyMetadata": true,
    "customerHidden": true,
    "minimumNecessaryDisplay": true
  },
  "notes": [
    "Reuses the matching Customer CMS profile as a presentation reference; Admin-only context and controls remain separate.",
    "Administrative permission never bypasses Phase 12 Commerce Rules or transaction invariants."
  ],
  "customerAccessPolicyRef": "customerAccess.policy.commerce.checkouts",
  "customerBoundary": {
    "policyVersion": "1.1.0",
    "mode": "direct_edit",
    "publishingMode": "not_applicable",
    "approvalRequired": false,
    "capabilityRefs": [
      "commerce.checkout"
    ],
    "editableFields": [],
    "readOnlyFields": [],
    "hiddenFields": [],
    "restrictiveWorkspaceOverridesAllowed": true,
    "customerAccessMayBeBroadened": false
  }
}
