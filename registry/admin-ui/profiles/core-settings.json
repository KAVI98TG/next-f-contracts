{
  "$id": "adminUi.profile.core.settings",
  "name": "Settings Admin",
  "version": "0.21.0",
  "status": "stable",
  "domain": "admin-ui",
  "type": "admin-ui-profile",
  "profileType": "resource",
  "resource": "core.settings",
  "permissionDomain": "core",
  "moduleId": "core",
  "description": "Internal NEXT F Admin metadata for Settings. Applies only within server-authorized administrative scope.",
  "route": "/sites/:siteId/core/settings",
  "screenKind": "admin-settings",
  "layoutTemplate": "inherited-resource",
  "internalOnly": true,
  "customerVisible": false,
  "context": {
    "kind": "site",
    "requiresOrganization": false,
    "requiresSite": true,
    "allowsCrossTenant": false,
    "directUrlScopeGuard": "server-required"
  },
  "baseCustomerProfileId": "cmsUi.profile.core.settings",
  "inheritanceMode": "reference-not-copy",
  "targetContracts": [
    "core.site",
    "shared.contactPoint",
    "shared.address"
  ],
  "primaryTargetContract": "core.site",
  "permissions": [
    "core.settings.edit",
    "core.settings.manage",
    "core.settings.view"
  ],
  "actions": [
    {
      "actionId": "edit",
      "permissionId": "core.settings.edit",
      "riskLevel": "elevated",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    },
    {
      "actionId": "manage",
      "permissionId": "core.settings.manage",
      "riskLevel": "elevated",
      "requiresRecentAuthentication": true,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    },
    {
      "actionId": "view",
      "permissionId": "core.settings.view",
      "riskLevel": "standard",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    }
  ],
  "panels": [
    "scope-context",
    "audit",
    "permissions",
    "customer-ui-reference"
  ],
  "controls": [
    "risk-badge",
    "recent-auth-gate"
  ],
  "security": {
    "serverAuthorizationRequired": true,
    "directUrlReauthorization": true,
    "secretValuesNeverRendered": true,
    "crossTenantRequiresPlatformScope": true,
    "customerIdentityImpersonation": false,
    "adminCanBypassCanonicalBusinessRules": false
  },
  "audit": {
    "requiredForMutations": true,
    "requestIdVisibleWhenAvailable": true,
    "redactSecrets": true
  },
  "dataPolicy": {
    "internalOnlyMetadata": true,
    "customerHidden": true,
    "minimumNecessaryDisplay": true
  },
  "notes": [
    "Reuses the matching Customer CMS profile as a presentation reference; Admin-only context and controls remain separate."
  ]
}
