{
  "$id": "adminUi.profile.forms.consent",
  "name": "Consent Admin",
  "version": "1.1.0",
  "status": "stable",
  "domain": "admin-ui",
  "type": "admin-ui-profile",
  "profileType": "resource",
  "resource": "forms.consent",
  "permissionDomain": "forms",
  "moduleId": "forms",
  "description": "Internal NEXT F Admin metadata for Consent. Applies only within server-authorized administrative scope.",
  "route": "/sites/:siteId/forms/consent",
  "screenKind": "admin-editor",
  "layoutTemplate": "inherited-resource",
  "internalOnly": true,
  "customerVisible": false,
  "context": {
    "kind": "site",
    "requiresOrganization": false,
    "requiresSite": true,
    "allowsCrossTenant": false,
    "directUrlScopeGuard": "server-required"
  },
  "baseCustomerProfileId": "cmsUi.profile.forms.consent",
  "inheritanceMode": "reference-not-copy",
  "targetContracts": [
    "forms.consentRecord"
  ],
  "primaryTargetContract": "forms.consentRecord",
  "permissions": [
    "forms.consent.export",
    "forms.consent.view"
  ],
  "actions": [
    {
      "actionId": "export",
      "permissionId": "forms.consent.export",
      "riskLevel": "sensitive",
      "requiresRecentAuthentication": true,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    },
    {
      "actionId": "view",
      "permissionId": "forms.consent.view",
      "riskLevel": "sensitive",
      "requiresRecentAuthentication": true,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    }
  ],
  "panels": [
    "scope-context",
    "audit",
    "permissions",
    "customer-ui-reference",
    "form-privacy",
    "data-governance"
  ],
  "controls": [
    "risk-badge",
    "recent-auth-gate"
  ],
  "security": {
    "serverAuthorizationRequired": true,
    "directUrlReauthorization": true,
    "secretValuesNeverRendered": true,
    "crossTenantRequiresPlatformScope": true,
    "customerIdentityImpersonation": false,
    "adminCanBypassCanonicalBusinessRules": false
  },
  "audit": {
    "requiredForMutations": true,
    "requestIdVisibleWhenAvailable": true,
    "redactSecrets": true
  },
  "dataPolicy": {
    "internalOnlyMetadata": true,
    "customerHidden": true,
    "minimumNecessaryDisplay": true
  },
  "notes": [
    "Reuses the matching Customer CMS profile as a presentation reference; Admin-only context and controls remain separate."
  ],
  "customerAccessPolicyRef": "customerAccess.policy.forms.consent",
  "customerBoundary": {
    "policyVersion": "1.1.0",
    "mode": "direct_edit",
    "publishingMode": "not_applicable",
    "approvalRequired": false,
    "capabilityRefs": [
      "forms.consent-fields"
    ],
    "editableFields": [
      "fieldKey",
      "purpose",
      "accepted",
      "textSnapshot",
      "policyUrl",
      "policyVersion",
      "recordedAt"
    ],
    "readOnlyFields": [],
    "hiddenFields": [],
    "restrictiveWorkspaceOverridesAllowed": true,
    "customerAccessMayBeBroadened": false
  }
}
