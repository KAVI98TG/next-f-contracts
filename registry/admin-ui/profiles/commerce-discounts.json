{
  "$id": "adminUi.profile.commerce.discounts",
  "name": "Discounts Admin",
  "version": "1.1.0",
  "status": "stable",
  "domain": "admin-ui",
  "type": "admin-ui-profile",
  "profileType": "resource",
  "resource": "commerce.discounts",
  "permissionDomain": "commerce",
  "moduleId": "commerce",
  "description": "Internal NEXT F Admin metadata for Discounts. Applies only within server-authorized administrative scope.",
  "route": "/sites/:siteId/commerce/discounts",
  "screenKind": "admin-editor",
  "layoutTemplate": "inherited-resource",
  "internalOnly": true,
  "customerVisible": false,
  "context": {
    "kind": "site",
    "requiresOrganization": false,
    "requiresSite": true,
    "allowsCrossTenant": false,
    "directUrlScopeGuard": "server-required"
  },
  "baseCustomerProfileId": "cmsUi.profile.commerce.discounts",
  "inheritanceMode": "reference-not-copy",
  "targetContracts": [
    "commerce.discount",
    "commerce.discountCode"
  ],
  "primaryTargetContract": "commerce.discount",
  "permissions": [
    "commerce.discounts.create",
    "commerce.discounts.delete",
    "commerce.discounts.edit",
    "commerce.discounts.manage",
    "commerce.discounts.view"
  ],
  "actions": [
    {
      "actionId": "create",
      "permissionId": "commerce.discounts.create",
      "riskLevel": "elevated",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    },
    {
      "actionId": "delete",
      "permissionId": "commerce.discounts.delete",
      "riskLevel": "destructive",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": true,
      "scopeKind": "site"
    },
    {
      "actionId": "edit",
      "permissionId": "commerce.discounts.edit",
      "riskLevel": "elevated",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    },
    {
      "actionId": "manage",
      "permissionId": "commerce.discounts.manage",
      "riskLevel": "elevated",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    },
    {
      "actionId": "view",
      "permissionId": "commerce.discounts.view",
      "riskLevel": "standard",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    }
  ],
  "panels": [
    "scope-context",
    "audit",
    "permissions",
    "customer-ui-reference",
    "commerce-invariants",
    "data-governance"
  ],
  "controls": [
    "risk-badge",
    "explicit-confirmation"
  ],
  "security": {
    "serverAuthorizationRequired": true,
    "directUrlReauthorization": true,
    "secretValuesNeverRendered": true,
    "crossTenantRequiresPlatformScope": true,
    "customerIdentityImpersonation": false,
    "adminCanBypassCanonicalBusinessRules": false
  },
  "audit": {
    "requiredForMutations": true,
    "requestIdVisibleWhenAvailable": true,
    "redactSecrets": true
  },
  "dataPolicy": {
    "internalOnlyMetadata": true,
    "customerHidden": true,
    "minimumNecessaryDisplay": true
  },
  "notes": [
    "Reuses the matching Customer CMS profile as a presentation reference; Admin-only context and controls remain separate.",
    "Administrative permission never bypasses Phase 12 Commerce Rules or transaction invariants."
  ],
  "customerAccessPolicyRef": "customerAccess.policy.commerce.discounts",
  "customerBoundary": {
    "policyVersion": "1.1.0",
    "mode": "direct_edit",
    "publishingMode": "not_applicable",
    "approvalRequired": false,
    "capabilityRefs": [
      "commerce.discounts"
    ],
    "editableFields": [
      "name",
      "conditions",
      "conditionMatch",
      "benefits",
      "usageLimit",
      "perCustomerLimit",
      "startsAt",
      "endsAt",
      "combinable",
      "status"
    ],
    "readOnlyFields": [],
    "hiddenFields": [
      "identity",
      "scope"
    ],
    "restrictiveWorkspaceOverridesAllowed": true,
    "customerAccessMayBeBroadened": false
  }
}
