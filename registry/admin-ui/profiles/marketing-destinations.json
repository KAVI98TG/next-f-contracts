{
  "$id": "adminUi.profile.marketing.destinations",
  "name": "Destinations Admin",
  "version": "0.21.0",
  "status": "stable",
  "domain": "admin-ui",
  "type": "admin-ui-profile",
  "profileType": "resource",
  "resource": "marketing.destinations",
  "permissionDomain": "marketing",
  "moduleId": "marketing",
  "description": "Internal NEXT F Admin metadata for Destinations. Applies only within server-authorized administrative scope.",
  "route": "/sites/:siteId/marketing/destinations",
  "screenKind": "admin-settings",
  "layoutTemplate": "inherited-resource",
