  "customerVisible": false,
  "context": {
    "kind": "site",
    "requiresOrganization": false,
    "requiresSite": true,
    "allowsCrossTenant": false,
    "directUrlScopeGuard": "server-required"
  },
  "baseCustomerProfileId": "cmsUi.profile.marketing.destinations",
  "inheritanceMode": "reference-not-copy",
  "targetContracts": [
    "marketing.marketingDestination",
    "marketing.eventDestination"
  ],
  "primaryTargetContract": "marketing.marketingDestination",
  "permissions": [
    "marketing.destinations.create",
    "marketing.destinations.delete",
    "marketing.destinations.edit",
    "marketing.destinations.manage",
    "marketing.destinations.view"
  ],
  "actions": [
    {
      "actionId": "create",
      "permissionId": "marketing.destinations.create",
      "riskLevel": "elevated",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    },
    {
      "actionId": "delete",
      "permissionId": "marketing.destinations.delete",
      "riskLevel": "destructive",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": true,
      "scopeKind": "site"
    },
    {
      "actionId": "edit",
      "permissionId": "marketing.destinations.edit",
      "riskLevel": "elevated",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    },
    {
      "actionId": "manage",
      "permissionId": "marketing.destinations.manage",
      "riskLevel": "elevated",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    },
    {
      "actionId": "view",
      "permissionId": "marketing.destinations.view",
      "riskLevel": "standard",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    }
  ],
  "panels": [
    "scope-context",
    "audit",
    "permissions",
    "customer-ui-reference",
    "tracking-consent",
    "data-governance"
  ],
  "controls": [
    "risk-badge",
    "explicit-confirmation"
  ],
  "security": {
    "serverAuthorizationRequired": true,
    "directUrlReauthorization": true,
    "secretValuesNeverRendered": true,
    "crossTenantRequiresPlatformScope": true,
    "customerIdentityImpersonation": false,
    "adminCanBypassCanonicalBusinessRules": false
  },
  "audit": {
    "requiredForMutations": true,
    "requestIdVisibleWhenAvailable": true,
    "redactSecrets": true
  },
  "dataPolicy": {
    "internalOnlyMetadata": true,
    "customerHidden": true,
    "minimumNecessaryDisplay": true
  },
  "notes": [
    "Reuses the matching Customer CMS profile as a presentation reference; Admin-only context and controls remain separate."
  ]
