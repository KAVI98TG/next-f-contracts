{
  "$id": "adminUi.profile.platform.permissions",
  "name": "Permissions Admin",
  "version": "0.21.0",
  "status": "stable",
  "domain": "admin-ui",
  "type": "admin-ui-profile",
  "profileType": "resource",
  "resource": "platform.permissions",
  "permissionDomain": "platform",
  "moduleId": "core",
  "description": "Internal NEXT F Admin metadata for Permissions. Applies only within server-authorized administrative scope.",
  "route": "/platform/access/permissions",
  "screenKind": "admin-operations",
  "layoutTemplate": "access-manager",
  "internalOnly": true,
  "customerVisible": false,
  "context": {
    "kind": "platform",
    "requiresOrganization": false,
    "requiresSite": false,
    "allowsCrossTenant": true,
    "directUrlScopeGuard": "server-required"
  },
  "baseCustomerProfileId": null,
  "inheritanceMode": "none",
  "targetContracts": [
    "permissions.permissionDefinition"
  ],
  "primaryTargetContract": "permissions.permissionDefinition",
  "permissions": [
    "platform.permissions.manage",
    "platform.permissions.view"
  ],
  "actions": [
    {
      "actionId": "manage",
      "permissionId": "platform.permissions.manage",
      "riskLevel": "privileged",
      "requiresRecentAuthentication": true,
      "requiresExplicitConfirmation": false,
      "scopeKind": "platform"
    },
    {
      "actionId": "view",
      "permissionId": "platform.permissions.view",
      "riskLevel": "standard",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false,
      "scopeKind": "platform"
    }
  ],
  "panels": [
    "scope-context",
    "audit",
    "permissions"
  ],
  "controls": [
    "risk-badge",
    "recent-auth-gate",
    "explicit-confirmation"
  ],
  "security": {
    "serverAuthorizationRequired": true,
    "directUrlReauthorization": true,
    "secretValuesNeverRendered": true,
    "crossTenantRequiresPlatformScope": true,
    "customerIdentityImpersonation": false,
    "adminCanBypassCanonicalBusinessRules": false
  },
  "audit": {
    "requiredForMutations": true,
    "requestIdVisibleWhenAvailable": true,
    "redactSecrets": true
  },
  "dataPolicy": {
    "internalOnlyMetadata": true,
    "customerHidden": true,
    "minimumNecessaryDisplay": true
  },
  "notes": []
}
