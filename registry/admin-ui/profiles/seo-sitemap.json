{
  "$id": "adminUi.profile.seo.sitemap",
  "name": "Sitemap Admin",
  "version": "1.1.0",
  "status": "stable",
  "domain": "admin-ui",
  "type": "admin-ui-profile",
  "profileType": "resource",
  "resource": "seo.sitemap",
  "permissionDomain": "seo",
  "moduleId": "seo",
  "description": "Internal NEXT F Admin metadata for Sitemap. Applies only within server-authorized administrative scope.",
  "route": "/sites/:siteId/seo/sitemap",
  "screenKind": "admin-editor",
  "layoutTemplate": "inherited-resource",
  "internalOnly": true,
  "customerVisible": false,
  "context": {
    "kind": "site",
    "requiresOrganization": false,
    "requiresSite": true,
    "allowsCrossTenant": false,
    "directUrlScopeGuard": "server-required"
  },
  "baseCustomerProfileId": "cmsUi.profile.seo.sitemap",
  "inheritanceMode": "reference-not-copy",
  "targetContracts": [
    "seo.sitemapEntry"
  ],
  "primaryTargetContract": "seo.sitemapEntry",
  "permissions": [
    "seo.sitemap.edit",
    "seo.sitemap.manage",
    "seo.sitemap.view"
  ],
  "actions": [
    {
      "actionId": "edit",
      "permissionId": "seo.sitemap.edit",
      "riskLevel": "elevated",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    },
    {
      "actionId": "manage",
      "permissionId": "seo.sitemap.manage",
      "riskLevel": "elevated",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    },
    {
      "actionId": "view",
      "permissionId": "seo.sitemap.view",
      "riskLevel": "standard",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    }
  ],
  "panels": [
    "scope-context",
    "audit",
    "permissions",
    "customer-ui-reference",
    "seo-provenance"
  ],
  "controls": [
    "risk-badge"
  ],
  "security": {
    "serverAuthorizationRequired": true,
    "directUrlReauthorization": true,
    "secretValuesNeverRendered": true,
    "crossTenantRequiresPlatformScope": true,
    "customerIdentityImpersonation": false,
    "adminCanBypassCanonicalBusinessRules": false
  },
  "audit": {
    "requiredForMutations": true,
    "requestIdVisibleWhenAvailable": true,
    "redactSecrets": true
  },
  "dataPolicy": {
    "internalOnlyMetadata": true,
    "customerHidden": true,
    "minimumNecessaryDisplay": true
  },
  "notes": [
    "Reuses the matching Customer CMS profile as a presentation reference; Admin-only context and controls remain separate."
  ],
  "customerAccessPolicyRef": "customerAccess.policy.seo.sitemap",
  "customerBoundary": {
    "policyVersion": "1.1.0",
    "mode": "approval_required",
    "publishingMode": "not_applicable",
    "approvalRequired": true,
    "capabilityRefs": [
      "seo.sitemap"
    ],
    "editableFields": [
      "alternates"
    ],
    "readOnlyFields": [
      "url",
      "lastModifiedAt"
    ],
    "hiddenFields": [],
    "restrictiveWorkspaceOverridesAllowed": true,
    "customerAccessMayBeBroadened": false
  }
}
