{
  "$id": "adminUi.profile.forms.leads",
  "name": "Leads Admin",
  "version": "0.21.0",
  "status": "stable",
  "domain": "admin-ui",
  "type": "admin-ui-profile",
  "profileType": "resource",
  "resource": "forms.leads",
  "permissionDomain": "forms",
  "moduleId": "forms",
  "description": "Internal NEXT F Admin metadata for Leads. Applies only within server-authorized administrative scope.",
  "route": "/sites/:siteId/forms/leads",
  "screenKind": "admin-operations",
  "layoutTemplate": "inherited-resource",
  "internalOnly": true,
  "customerVisible": false,
  "context": {
    "kind": "site",
    "requiresOrganization": false,
    "requiresSite": true,
    "allowsCrossTenant": false,
    "directUrlScopeGuard": "server-required"
  },
  "baseCustomerProfileId": "cmsUi.profile.forms.leads",
  "inheritanceMode": "reference-not-copy",
  "targetContracts": [
    "forms.lead",
    "forms.leadActivity",
    "forms.leadNote"
  ],
  "primaryTargetContract": "forms.lead",
  "permissions": [
    "forms.leads.create",
    "forms.leads.delete",
    "forms.leads.edit",
    "forms.leads.export",
    "forms.leads.manage",
    "forms.leads.view"
  ],
  "actions": [
    {
      "actionId": "create",
      "permissionId": "forms.leads.create",
      "riskLevel": "elevated",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    },
    {
      "actionId": "delete",
      "permissionId": "forms.leads.delete",
      "riskLevel": "destructive",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": true,
      "scopeKind": "site"
    },
    {
      "actionId": "edit",
      "permissionId": "forms.leads.edit",
      "riskLevel": "elevated",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    },
    {
      "actionId": "export",
      "permissionId": "forms.leads.export",
      "riskLevel": "sensitive",
      "requiresRecentAuthentication": true,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    },
    {
      "actionId": "manage",
      "permissionId": "forms.leads.manage",
      "riskLevel": "sensitive",
      "requiresRecentAuthentication": true,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    },
    {
      "actionId": "view",
      "permissionId": "forms.leads.view",
      "riskLevel": "sensitive",
      "requiresRecentAuthentication": true,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    }
  ],
  "panels": [
    "scope-context",
    "audit",
    "permissions",
    "customer-ui-reference",
    "form-privacy",
    "data-governance"
  ],
  "controls": [
    "risk-badge",
    "recent-auth-gate",
    "explicit-confirmation"
  ],
  "security": {
    "serverAuthorizationRequired": true,
    "directUrlReauthorization": true,
    "secretValuesNeverRendered": true,
    "crossTenantRequiresPlatformScope": true,
    "customerIdentityImpersonation": false,
    "adminCanBypassCanonicalBusinessRules": false
  },
  "audit": {
    "requiredForMutations": true,
    "requestIdVisibleWhenAvailable": true,
    "redactSecrets": true
  },
  "dataPolicy": {
    "internalOnlyMetadata": true,
    "customerHidden": true,
    "minimumNecessaryDisplay": true
  },
  "notes": [
    "Reuses the matching Customer CMS profile as a presentation reference; Admin-only context and controls remain separate."
  ]
}
