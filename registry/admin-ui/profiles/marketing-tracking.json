{
  "$id": "adminUi.profile.marketing.tracking",
  "name": "Tracking Admin",
  "version": "1.1.0",
  "status": "stable",
  "domain": "admin-ui",
  "type": "admin-ui-profile",
  "profileType": "resource",
  "resource": "marketing.tracking",
  "permissionDomain": "marketing",
  "moduleId": "marketing",
  "description": "Internal NEXT F Admin metadata for Tracking. Applies only within server-authorized administrative scope.",
  "route": "/sites/:siteId/marketing/tracking",
  "screenKind": "admin-settings",
  "layoutTemplate": "inherited-resource",
  "internalOnly": true,
  "customerVisible": false,
  "context": {
    "kind": "site",
    "requiresOrganization": false,
    "requiresSite": true,
    "allowsCrossTenant": false,
    "directUrlScopeGuard": "server-required"
  },
  "baseCustomerProfileId": "cmsUi.profile.marketing.tracking",
  "inheritanceMode": "reference-not-copy",
  "targetContracts": [
    "marketing.trackingConfiguration",
    "marketing.dataLayerConfiguration"
  ],
  "primaryTargetContract": "marketing.trackingConfiguration",
  "permissions": [
    "marketing.tracking.edit",
    "marketing.tracking.manage",
    "marketing.tracking.view"
  ],
  "actions": [
    {
      "actionId": "edit",
      "permissionId": "marketing.tracking.edit",
      "riskLevel": "elevated",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    },
    {
      "actionId": "manage",
      "permissionId": "marketing.tracking.manage",
      "riskLevel": "sensitive",
      "requiresRecentAuthentication": true,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    },
    {
      "actionId": "view",
      "permissionId": "marketing.tracking.view",
      "riskLevel": "standard",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    }
  ],
  "panels": [
    "scope-context",
    "audit",
    "permissions",
    "customer-ui-reference",
    "tracking-consent",
    "data-governance"
  ],
  "controls": [
    "risk-badge",
    "recent-auth-gate"
  ],
  "security": {
    "serverAuthorizationRequired": true,
    "directUrlReauthorization": true,
    "secretValuesNeverRendered": true,
    "crossTenantRequiresPlatformScope": true,
    "customerIdentityImpersonation": false,
    "adminCanBypassCanonicalBusinessRules": false
  },
  "audit": {
    "requiredForMutations": true,
    "requestIdVisibleWhenAvailable": true,
    "redactSecrets": true
  },
  "dataPolicy": {
    "internalOnlyMetadata": true,
    "customerHidden": true,
    "minimumNecessaryDisplay": true
  },
  "notes": [
    "Reuses the matching Customer CMS profile as a presentation reference; Admin-only context and controls remain separate."
  ],
  "customerAccessPolicyRef": "customerAccess.policy.marketing.tracking",
  "customerBoundary": {
    "policyVersion": "1.1.0",
    "mode": "direct_edit",
    "publishingMode": "not_applicable",
    "approvalRequired": false,
    "capabilityRefs": [
      "marketing.conversions"
    ],
    "editableFields": [
      "enabled",
      "dataLayer",
      "dataPolicy",
      "consentPolicy",
      "analytics",
      "eventDefinitions",
      "destinations",
      "debugMode"
    ],
    "readOnlyFields": [],
    "hiddenFields": [
      "identity",
      "scope",
      "updatedAt"
    ],
    "restrictiveWorkspaceOverridesAllowed": true,
    "customerAccessMayBeBroadened": false
  }
}
