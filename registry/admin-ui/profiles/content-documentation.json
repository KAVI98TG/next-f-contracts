{
  "$id": "adminUi.profile.content.documentation",
  "name": "Documentation Admin",
  "version": "1.1.0",
  "status": "stable",
  "domain": "admin-ui",
  "type": "admin-ui-profile",
  "profileType": "resource",
  "resource": "content.documentation",
  "permissionDomain": "content",
  "moduleId": "pages",
  "description": "Internal NEXT F Admin metadata for Documentation. Applies only within server-authorized administrative scope.",
  "route": "/sites/:siteId/content/documentation",
  "screenKind": "admin-editor",
  "layoutTemplate": "inherited-resource",
  "internalOnly": true,
  "customerVisible": false,
  "context": {
    "kind": "site",
    "requiresOrganization": false,
    "requiresSite": true,
    "allowsCrossTenant": false,
    "directUrlScopeGuard": "server-required"
  },
  "baseCustomerProfileId": "cmsUi.profile.content.documentation",
  "inheritanceMode": "reference-not-copy",
  "targetContracts": [
    "content.documentationArticle",
    "content.documentationCollection",
    "content.documentationCategory"
  ],
  "primaryTargetContract": "content.documentationArticle",
  "permissions": [
    "content.documentation.approve",
    "content.documentation.create",
    "content.documentation.delete",
    "content.documentation.edit",
    "content.documentation.publish",
    "content.documentation.view"
  ],
  "actions": [
    {
      "actionId": "approve",
      "permissionId": "content.documentation.approve",
      "riskLevel": "elevated",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    },
    {
      "actionId": "create",
      "permissionId": "content.documentation.create",
      "riskLevel": "elevated",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    },
    {
      "actionId": "delete",
      "permissionId": "content.documentation.delete",
      "riskLevel": "destructive",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": true,
      "scopeKind": "site"
    },
    {
      "actionId": "edit",
      "permissionId": "content.documentation.edit",
      "riskLevel": "elevated",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    },
    {
      "actionId": "publish",
      "permissionId": "content.documentation.publish",
      "riskLevel": "elevated",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    },
    {
      "actionId": "view",
      "permissionId": "content.documentation.view",
      "riskLevel": "standard",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    }
  ],
  "panels": [
    "scope-context",
    "audit",
    "permissions",
    "customer-ui-reference",
    "publishing"
  ],
  "controls": [
    "risk-badge",
    "explicit-confirmation"
  ],
  "security": {
    "serverAuthorizationRequired": true,
    "directUrlReauthorization": true,
    "secretValuesNeverRendered": true,
    "crossTenantRequiresPlatformScope": true,
    "customerIdentityImpersonation": false,
    "adminCanBypassCanonicalBusinessRules": false
  },
  "audit": {
    "requiredForMutations": true,
    "requestIdVisibleWhenAvailable": true,
    "redactSecrets": true
  },
  "dataPolicy": {
    "internalOnlyMetadata": true,
    "customerHidden": true,
    "minimumNecessaryDisplay": true
  },
  "notes": [
    "Reuses the matching Customer CMS profile as a presentation reference; Admin-only context and controls remain separate."
  ],
  "customerAccessPolicyRef": "customerAccess.policy.content.documentation",
  "customerBoundary": {
    "policyVersion": "1.1.0",
    "mode": "direct_edit",
    "publishingMode": "direct",
    "approvalRequired": false,
    "capabilityRefs": [
      "documentation.attachments",
      "documentation.categories",
      "documentation.collections",
      "documentation.related-articles",
      "documentation.versioning",
      "documentation.visibility"
    ],
    "editableFields": [
      "title",
      "slug",
      "summary",
      "content",
      "collection",
      "category",
      "author",
      "versionLabel",
      "tableOfContents",
      "relatedArticles",
      "attachments",
      "publishing"
    ],
    "readOnlyFields": [],
    "hiddenFields": [
      "identity",
      "scope",
      "revision"
    ],
    "restrictiveWorkspaceOverridesAllowed": true,
    "customerAccessMayBeBroadened": false
  }
}
