{
  "$id": "adminUi.profile.permissions.assignments",
  "name": "Assignments Admin",
  "version": "0.21.0",
  "status": "stable",
  "domain": "admin-ui",
  "type": "admin-ui-profile",
  "profileType": "resource",
  "resource": "permissions.assignments",
  "permissionDomain": "permissions",
  "moduleId": "core",
  "description": "Internal NEXT F Admin metadata for Assignments. Applies only within server-authorized administrative scope.",
  "route": "/sites/:siteId/access/assignments",
  "screenKind": "admin-operations",
  "layoutTemplate": "access-manager",
  "internalOnly": true,
  "customerVisible": false,
  "context": {
    "kind": "organization",
    "requiresOrganization": true,
    "requiresSite": false,
    "allowsCrossTenant": false,
    "directUrlScopeGuard": "server-required"
  },
  "baseCustomerProfileId": "cmsUi.profile.permissions.assignments",
  "inheritanceMode": "reference-not-copy",
  "targetContracts": [
    "permissions.roleAssignment"
  ],
  "primaryTargetContract": "permissions.roleAssignment",
  "permissions": [
    "permissions.assignments.create",
    "permissions.assignments.delete",
    "permissions.assignments.edit",
    "permissions.assignments.manage",
    "permissions.assignments.view"
  ],
  "actions": [
    {
      "actionId": "create",
      "permissionId": "permissions.assignments.create",
      "riskLevel": "sensitive",
      "requiresRecentAuthentication": true,
      "requiresExplicitConfirmation": false,
      "scopeKind": "organization"
    },
    {
      "actionId": "delete",
      "permissionId": "permissions.assignments.delete",
      "riskLevel": "sensitive",
      "requiresRecentAuthentication": true,
      "requiresExplicitConfirmation": false,
      "scopeKind": "organization"
    },
    {
      "actionId": "edit",
      "permissionId": "permissions.assignments.edit",
      "riskLevel": "sensitive",
      "requiresRecentAuthentication": true,
      "requiresExplicitConfirmation": false,
      "scopeKind": "organization"
    },
    {
      "actionId": "manage",
      "permissionId": "permissions.assignments.manage",
      "riskLevel": "sensitive",
      "requiresRecentAuthentication": true,
      "requiresExplicitConfirmation": false,
      "scopeKind": "organization"
    },
    {
      "actionId": "view",
      "permissionId": "permissions.assignments.view",
      "riskLevel": "standard",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false,
      "scopeKind": "organization"
    }
  ],
  "panels": [
    "scope-context",
    "audit",
    "permissions",
    "customer-ui-reference"
  ],
  "controls": [
    "risk-badge",
    "recent-auth-gate"
  ],
  "security": {
    "serverAuthorizationRequired": true,
    "directUrlReauthorization": true,
    "secretValuesNeverRendered": true,
    "crossTenantRequiresPlatformScope": true,
    "customerIdentityImpersonation": false,
    "adminCanBypassCanonicalBusinessRules": false
  },
  "audit": {
    "requiredForMutations": true,
    "requestIdVisibleWhenAvailable": true,
    "redactSecrets": true
  },
  "dataPolicy": {
    "internalOnlyMetadata": true,
    "customerHidden": true,
    "minimumNecessaryDisplay": true
  },
  "notes": [
    "Reuses the matching Customer CMS profile as a presentation reference; Admin-only context and controls remain separate."
  ]
}
