{
  "$id": "adminUi.profile.content.media",
  "name": "Media Admin",
  "version": "1.1.0",
  "status": "stable",
  "domain": "admin-ui",
  "type": "admin-ui-profile",
  "profileType": "resource",
  "resource": "content.media",
  "permissionDomain": "content",
  "moduleId": "pages",
  "description": "Internal NEXT F Admin metadata for Media. Applies only within server-authorized administrative scope.",
  "route": "/sites/:siteId/content/media",
  "screenKind": "admin-list",
  "layoutTemplate": "inherited-resource",
  "internalOnly": true,
  "customerVisible": false,
  "context": {
    "kind": "site",
    "requiresOrganization": false,
    "requiresSite": true,
    "allowsCrossTenant": false,
    "directUrlScopeGuard": "server-required"
  },
  "baseCustomerProfileId": "cmsUi.profile.content.media",
  "inheritanceMode": "reference-not-copy",
  "targetContracts": [
    "shared.mediaAsset"
  ],
  "primaryTargetContract": "shared.mediaAsset",
  "permissions": [
    "content.media.create",
    "content.media.delete",
    "content.media.edit",
    "content.media.manage",
    "content.media.view"
  ],
  "actions": [
    {
      "actionId": "create",
      "permissionId": "content.media.create",
      "riskLevel": "elevated",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    },
    {
      "actionId": "delete",
      "permissionId": "content.media.delete",
      "riskLevel": "destructive",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": true,
      "scopeKind": "site"
    },
    {
      "actionId": "edit",
      "permissionId": "content.media.edit",
      "riskLevel": "elevated",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    },
    {
      "actionId": "manage",
      "permissionId": "content.media.manage",
      "riskLevel": "elevated",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    },
    {
      "actionId": "view",
      "permissionId": "content.media.view",
      "riskLevel": "standard",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    }
  ],
  "panels": [
    "scope-context",
    "audit",
    "permissions",
    "customer-ui-reference",
    "publishing"
  ],
  "controls": [
    "risk-badge",
    "explicit-confirmation"
  ],
  "security": {
    "serverAuthorizationRequired": true,
    "directUrlReauthorization": true,
    "secretValuesNeverRendered": true,
    "crossTenantRequiresPlatformScope": true,
    "customerIdentityImpersonation": false,
    "adminCanBypassCanonicalBusinessRules": false
  },
  "audit": {
    "requiredForMutations": true,
    "requestIdVisibleWhenAvailable": true,
    "redactSecrets": true
  },
  "dataPolicy": {
    "internalOnlyMetadata": true,
    "customerHidden": true,
    "minimumNecessaryDisplay": true
  },
  "notes": [
    "Reuses the matching Customer CMS profile as a presentation reference; Admin-only context and controls remain separate."
  ],
  "customerAccessPolicyRef": "customerAccess.policy.content.media",
  "customerBoundary": {
    "policyVersion": "1.1.0",
    "mode": "direct_edit",
    "publishingMode": "not_applicable",
    "approvalRequired": false,
    "capabilityRefs": [
      "media.audio",
      "media.documents",
      "media.images",
      "media.library",
      "media.video"
    ],
    "editableFields": [
      "kind",
      "fileName",
      "mimeType",
      "title",
      "altText",
      "caption",
      "credit",
      "copyright",
      "focalPoint"
    ],
    "readOnlyFields": [
      "sizeBytes",
      "width",
      "height",
      "durationSeconds",
      "checksum",
      "publicUrl"
    ],
    "hiddenFields": [
      "id",
      "siteId",
      "createdAt"
    ],
    "restrictiveWorkspaceOverridesAllowed": true,
    "customerAccessMayBeBroadened": false
  }
}
