{
  "$id": "adminUi.profile.webhooks.tests",
  "name": "Tests Admin",
  "version": "1.1.0",
  "status": "stable",
  "domain": "admin-ui",
  "type": "admin-ui-profile",
  "profileType": "resource",
  "resource": "webhooks.tests",
  "permissionDomain": "webhooks",
  "moduleId": "integrations",
  "description": "Internal NEXT F Admin metadata for Tests. Applies only within server-authorized administrative scope.",
  "route": "/sites/:siteId/webhooks/tests",
  "screenKind": "admin-operations",
  "layoutTemplate": "delivery-operations",
  "internalOnly": true,
  "customerVisible": false,
  "context": {
    "kind": "site",
    "requiresOrganization": false,
    "requiresSite": true,
    "allowsCrossTenant": false,
    "directUrlScopeGuard": "server-required"
  },
  "baseCustomerProfileId": "cmsUi.profile.webhooks.tests",
  "inheritanceMode": "reference-not-copy",
  "targetContracts": [
    "webhooks.testDelivery"
  ],
  "primaryTargetContract": "webhooks.testDelivery",
  "permissions": [
    "webhooks.tests.create",
    "webhooks.tests.view"
  ],
  "actions": [
    {
      "actionId": "create",
      "permissionId": "webhooks.tests.create",
      "riskLevel": "elevated",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    },
    {
      "actionId": "view",
      "permissionId": "webhooks.tests.view",
      "riskLevel": "standard",
      "requiresRecentAuthentication": false,
      "requiresExplicitConfirmation": false,
      "scopeKind": "site"
    }
  ],
  "panels": [
    "scope-context",
    "audit",
    "permissions",
    "customer-ui-reference",
    "webhook-health",
    "secret-metadata",
    "delivery-integrity"
  ],
  "controls": [
    "risk-badge"
  ],
  "security": {
    "serverAuthorizationRequired": true,
    "directUrlReauthorization": true,
    "secretValuesNeverRendered": true,
    "crossTenantRequiresPlatformScope": true,
    "customerIdentityImpersonation": false,
    "adminCanBypassCanonicalBusinessRules": false
  },
  "audit": {
    "requiredForMutations": true,
    "requestIdVisibleWhenAvailable": true,
    "redactSecrets": true
  },
  "dataPolicy": {
    "internalOnlyMetadata": true,
    "customerHidden": true,
    "minimumNecessaryDisplay": true
  },
  "notes": [
    "Reuses the matching Customer CMS profile as a presentation reference; Admin-only context and controls remain separate.",
    "Credential/secret values remain server-side; Admin displays state, fingerprints/metadata or rotation controls only."
  ],
  "customerAccessPolicyRef": "customerAccess.policy.webhooks.tests",
  "customerBoundary": {
    "policyVersion": "1.1.0",
    "mode": "direct_edit",
    "publishingMode": "not_applicable",
    "approvalRequired": false,
    "capabilityRefs": [
      "integrations.health"
    ],
    "editableFields": [],
    "readOnlyFields": [
      "requestedBy",
      "requestedAt",
      "syntheticEventKey",
      "result"
    ],
    "hiddenFields": [
      "testId",
      "endpointId",
      "subscriptionId"
    ],
    "restrictiveWorkspaceOverridesAllowed": true,
    "customerAccessMayBeBroadened": false
  }
}
